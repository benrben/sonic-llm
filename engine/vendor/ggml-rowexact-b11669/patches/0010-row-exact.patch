+
+// ---- SLLM row-exact mode: Q4_0 x f32 for R1 src1 rows per threadgroup ----------------------------------------------------
+// Each thread dequantizes its half block of a weight row ONCE (w = d*(q - 8)), then every src1 row takes the same
+// explicit fma chain over those 16 weights, and the same simd_sum. R1 (rows per threadgroup) and NR0 (weight rows per
+// simdgroup) only change which threads do which outputs and how many rows share a dequantization, so a row's result is
+// the same for every instantiation and every number of rows: one fast kernel for 1 row and for many.
+template<short R1, short NR0>
+kernel void kernel_sllm_mv_q4_0_f32(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    const short NSG = FC_mul_mv_nsg;
+    constexpr short NQ = 16;   // blocks per simdgroup per iteration: two threads per block, half a block each
+
+    const int nb  = args.ne00/QK4_0;
+    const int r0  = (tgpig.x*NSG + sgitg)*NR0;
+    const int r1b =  tgpig.y*R1;
+    const int im  =  tgpig.z;
+    const short nr1 = (short) min((int) R1, args.ne11 - r1b);
+
+    const uint i12 = im%FC_mul_mv_ne12;
+    const uint i13 = im/FC_mul_mv_ne12;
+
+    device const block_q4_0 * ax[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        const int rr = min(r0 + row, args.ne01 - 1);
+        ax[row] = (device const block_q4_0 *) (src0 + rr*args.nb01 + (i12/FC_mul_mv_r2)*args.nb02 + (i13/FC_mul_mv_r3)*args.nb03);
+    }
+
+    device const float * yr[R1];
+    FOR_UNROLL (short j = 0; j < R1; ++j) {
+        const int r1 = r1b + (j < nr1 ? j : 0);
+        yr[j] = (device const float *) (src1 + r1*args.nb11 + i12*args.nb12 + i13*args.nb13);
+    }
+
+    const short ix = tiisg/2;        // the block of this thread pair
+    const short il = (tiisg%2)*8;    // its half: quants il..il+7 (low nibbles: elements il.., high: il+16..)
+
+    float acc[R1][NR0];
+    FOR_UNROLL (short j = 0; j < R1; ++j) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            acc[j][row] = 0.f;
+        }
+    }
+
+    for (int ib = ix; ib < nb; ib += NQ) {
+        // the weights of this half block for every weight row, dequantized once
+        float w[NR0][16];
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            device const block_q4_0 * xb = ax[row] + ib;
+            const float d = xb->d;
+            device const uint8_t * q = xb->qs + il;
+            FOR_UNROLL (short k = 0; k < 8; ++k) {
+                w[row][k]     = d*(float) ((int) (q[k] & 0x0F) - 8);
+                w[row][k + 8] = d*(float) ((int) (q[k] >>   4) - 8);
+            }
+        }
+        // each src1 row's 16 inputs loaded once, then the same fma chain for every weight row
+        FOR_UNROLL (short j = 0; j < R1; ++j) {
+            if (j < nr1) {
+                device const float * yp = yr[j] + ib*QK4_0 + il;
+                float y[16];
+                FOR_UNROLL (short k = 0; k < 8; ++k) {
+                    y[k]     = yp[k];
+                    y[k + 8] = yp[k + 16];
+                }
+                FOR_UNROLL (short row = 0; row < NR0; ++row) {
+                    float a = acc[j][row];
+                    FOR_UNROLL (short k = 0; k < 16; ++k) {
+                        a = fma(w[row][k], y[k], a);
+                    }
+                    acc[j][row] = a;
+                }
+            }
+        }
+    }
+
+    for (short j = 0; j < nr1; ++j) {
+        device float * dst_f32 = (device float *) dst + im*args.ne0*args.ne1 + (r1b + j)*args.ne0;
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            const float tot = simd_sum(acc[j][row]);
+            if (tiisg == 0 && r0 + row < args.ne01) {
+                dst_f32[r0 + row] = tot;
+            }
+        }
+    }
+}
