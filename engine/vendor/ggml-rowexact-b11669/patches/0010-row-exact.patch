+        return false;
+    }
+    switch (t) {
+        case GGML_TYPE_F32: case GGML_TYPE_F16: case GGML_TYPE_BF16:
+        case GGML_TYPE_Q4_0: case GGML_TYPE_Q4_1: case GGML_TYPE_Q5_0: case GGML_TYPE_Q5_1: case GGML_TYPE_Q8_0:
+        case GGML_TYPE_MXFP4: case GGML_TYPE_IQ4_NL:
+        case GGML_TYPE_Q2_K: case GGML_TYPE_Q3_K: case GGML_TYPE_Q4_K: case GGML_TYPE_Q5_K: case GGML_TYPE_Q6_K:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// ggml's few-row MMA kernel (mul_mv_mma) for ANY row count up to 16, 1 included (stock: from 2..6 rows, by type). Its
+// per-output K order is the same for every row count; Q8_0 is left out because its MMA kernel kind changes with the
+// row tile (rt = 1 up to 8 rows, 2 above).
+static bool ggml_metal_op_mul_mat_rowexact_mma_ok(const ggml_tensor * op) {
+    const ggml_tensor * src0 = op->src[0];
+    const ggml_tensor * src1 = op->src[1];
+    if (src0->type == GGML_TYPE_Q8_0 || src1->type != GGML_TYPE_F32 || src1->ne[1] > sllm_row_exact_maxn()) {
+        return false;
+    }
+    const int64_t step = ggml_metal_mul_mv_mma_k_step(src0->type, ggml_metal_mul_mv_mma_rt(op));
+    return step > 0 && src0->ne[0] % step == 0 && src0->nb[0] == ggml_type_size(src0->type) &&
+        !ggml_is_transposed(src0) && !ggml_is_transposed(src1) &&
+        src1->nb[0] == sizeof(float) && src1->nb[1] % 16 == 0 && src1->nb[2] % 16 == 0 && src1->nb[3] % 16 == 0;
+}
