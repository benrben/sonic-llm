+// SLLM row-exact mode (mvr): mul_vec_q_n_f32_impl with up to SLLM_MV_NR1 (<= 16) src1 rows per threadgroup, the rows as the
+// inner loop so each weight block is read once for all of them. Per row: the official sums, in the official order.
+template<typename block_q_type, short NR0, typename args_t>
+void sllm_mul_vec_q_n_f32_r1_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+
+    constexpr short NW = N_SIMDWIDTH;
+    constexpr short NQ = 16;
+    constexpr short R1 = 16;
+
+    const int nb = args.ne00/QK4_0;
+
+    const int r0  = (tgpig.x*NSG + sgitg)*NR0;
+    const int r1b =  tgpig.y*SLLM_MV_NR1;
+    const int im  =  tgpig.z;
+    const short nr1 = (short) min((int) min((short) R1, SLLM_MV_NR1), args.ne11 - r1b);
+
+    const uint i12 = im%FC_mul_mv_ne12;
+    const uint i13 = im/FC_mul_mv_ne12;
+
+    device const block_q_type * ax[NR0];
+    FOR_UNROLL (int row = 0; row < NR0; ++row) {
+        const uint64_t offset0 = (r0 + row)*args.nb01 + (i12/FC_mul_mv_r2)*args.nb02 + (i13/FC_mul_mv_r3)*args.nb03;
+
+        ax[row] = (device const block_q_type *) ((device char *) src0 + offset0);
+    }
+
+    const short ix = (tiisg/(NW/NQ));
+    const short il = (tiisg%(NW/NQ))*8;
+
+    const int ib0 = ix;
+
+    device const float * yb[R1];
+    FOR_UNROLL (short j = 0; j < R1; ++j) {
+        const int r1 = r1b + (j < nr1 ? j : 0);
+        const uint64_t offset1 = r1*args.nb11 + (i12)*args.nb12 + (i13)*args.nb13;
+        yb[j] = (device const float *) (src1 + offset1) + ib0*QK4_0 + il;
+    }
+
+    float sumf[R1][NR0];
+    FOR_UNROLL (short j = 0; j < R1; ++j) {
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            sumf[j][row] = 0.f;
+        }
+    }
+
+    for (int ib = ib0; ib < nb; ib += NQ) {
+        FOR_UNROLL (short j = 0; j < R1; ++j) {
+            if (j < nr1) {
+                float yl[16];
+                float sumy[2] = { 0.f, 0.f };
+
+                FOR_UNROLL (short i = 0; i < 8; i += 2) {
+                    sumy[0]  += yb[j][i +  0] + yb[j][i +  1];
+                    yl[i + 0] = yb[j][i +  0];
+                    yl[i + 1] = yb[j][i +  1]/256.f;
+
+                    sumy[1]  += yb[j][i + 16] + yb[j][i + 17];
+                    yl[i + 8] = yb[j][i + 16]/16.f;
+                    yl[i + 9] = yb[j][i + 17]/4096.f;
+                }
+
+                FOR_UNROLL (short row = 0; row < NR0; row++) {
+                    sumf[j][row] += block_q_n_dot_y(ax[row] + ib, sumy[0] + sumy[1], yl, il);
+                }
+
+                yb[j] += QK4_0 * 16;
+            }
+        }
+    }
+
+    for (short j = 0; j < nr1; ++j) {
+        device float * dst_f32 = (device float *) dst + im*args.ne0*args.ne1 + (r1b + j)*args.ne0;
+
+        for (int row = 0; row < NR0; ++row) {
+            const float tot = simd_sum(sumf[j][row]);
+
+            if (tiisg == 0 && r0 + row < args.ne01) {
+                dst_f32[r0 + row] = tot;
+            }
+        }
+    }
+}
