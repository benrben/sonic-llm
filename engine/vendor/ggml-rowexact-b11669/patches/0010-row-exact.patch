 typedef decltype(kernel_mul_mv_mma_blk<4, 1, mul_mv_mma_q4_0>) mul_mv_mma_t;
 
+// ---- SLLM row-exact mode (mme): ONE src1 row with kernel_mul_mv_mma_blk<NT, RT, mul_mv_mma_q4_0>'s exact arithmetic --------
+// simdgroup_multiply_accumulate is a sequential fma chain over its 8 k onto the accumulator (measured), so for output row r:
+//   per block ib: mp = fma chain from 0.0f over the 32 (weight, input) pairs in the MMA step order: step s = 0..3, k = 0..7,
+//                 element 2k + s/2 (+ 16 for odd s); weight q - 8, or 16*(q - 8) for a high nibble, whose input is x/16;
+//   per K slice g = ib % NSG (the MMA's simdgroup): acc[g] = fma(d, mp, acc[g]) in block order;
+//   sum = 0.0f + acc[0] + ... + acc[NSG - 1] (mul_mv_mma_store), plus the fused residual.
+// Here each lane takes one block of NR0 weight rows (lanes read consecutive blocks), lane g < NSG keeps slice g, and the
+// slices take the other lanes' (d, mp) by shuffle in block order.
+template<short NR0>
+kernel void kernel_sllm_mme_q4_0_f32(
+        constant ggml_metal_kargs_mul_mv_ext & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        device const char * src2,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]],
+        ushort ntg[[simdgroups_per_threadgroup]]) {
+    const short NSG = FC_mul_mv_mma_nsg;
+    const int   nb  = args.ne00/QK4_0;
+    const int   r0  = (tgpig.x*ntg + sgitg)*NR0;
+
+    device const block_q4_0 * ax[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        ax[row] = (device const block_q4_0 *) (src0 + (uint64_t) min(r0 + row, args.ne01 - 1)*args.nb01);
+    }
+    device const float * y = (device const float *) src1;
+
+    float acc[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        acc[row] = 0.0f;
+    }
+
+    constexpr float hi_scale = 1.0f/16;
+
+    for (int ib0 = 0; ib0 < nb; ib0 += 32) {
+        const int ib = min(ib0 + (int) tiisg, nb - 1);
+
+        // the block's inputs as the MMA's B fragments hold them: b0 = x[0..15], b1 = x[16..31]/16
+        device const float4 * yb = (device const float4 *) (y + (uint64_t) ib*QK4_0);
+        float yl[16];
+        float yh[16];
+        FOR_UNROLL (short i = 0; i < 4; ++i) {
+            const float4 a = yb[i];
+            const float4 b = yb[i + 4]*hi_scale;
+            yl[4*i + 0] = a.x; yl[4*i + 1] = a.y; yl[4*i + 2] = a.z; yl[4*i + 3] = a.w;
+            yh[4*i + 0] = b.x; yh[4*i + 1] = b.y; yh[4*i + 2] = b.z; yh[4*i + 3] = b.w;
+        }
+
+        float mp[NR0];
+        float dd[NR0];
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            device const block_q4_0 * xb = ax[row] + ib;
+            dd[row] = (float) xb->d;
+            device const ushort * qs = (device const ushort *) xb->qs;
+            ushort q[8];
+            FOR_UNROLL (short i = 0; i < 8; ++i) {
+                q[i] = qs[i];
+            }
+            float m = 0.0f;
+            // s = 0: low nibbles of the even bytes, 1: their high nibbles, 2 and 3: the same for the odd bytes. A nibble
+            // field f (q, or 16*q for a high nibble) becomes the float 2^23 + f by its bits; minus 2^23 + 8 (or + 128) it is
+            // q - 8 (or 16*(q - 8)) exactly, the MMA's A value
+            FOR_UNROLL (short s = 0; s < 4; ++s) {
+                FOR_UNROLL (short c = 0; c < 8; ++c) {
+                    const uint  u = s < 2 ? (uint) q[c] : (uint) q[c] >> 8;
+                    const short e = 2*c + s/2;
+                    if (s % 2 == 0) {
+                        m = fma(as_type<float>(0x4B000000u | (u & 0x0Fu)) - 8388616.0f, yl[e], m);
+                    } else {
+                        m = fma(as_type<float>(0x4B000000u | (u & 0xF0u)) - 8388736.0f, yh[e], m);
+                    }
+                }
+            }
+            mp[row] = m;
+        }
+
+        // slice g = lane g: the blocks of lanes g, g + NSG, ... in order
+        FOR_UNROLL (short o = 0; o < 32; o += NSG) {
+            const ushort src   = (tiisg % NSG) + o;
+            const bool   valid = ib0 + (int) src < nb;
+            FOR_UNROLL (short row = 0; row < NR0; ++row) {
+                const float d_o = simd_shuffle(dd[row], src);
+                const float m_o = simd_shuffle(mp[row], src);
+                if (valid) {
+                    acc[row] = fma(d_o, m_o, acc[row]);
+                }
+            }
+        }
+    }
+
+    device       float * dst_f32 = (device       float *) dst;
+    device const float * res_f32 = (device const float *) src2;
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        float sum = 0.0f;
+        for (short g = 0; g < NSG; ++g) {
+            sum += simd_shuffle(acc[row], g);
+        }
+        if (tiisg == 0 && r0 + row < args.ne01) {
+            dst_f32[r0 + row] = FC_mul_mv_mma_add ? sum + res_f32[r0 + row] : sum;
+        }
+    }
+}
