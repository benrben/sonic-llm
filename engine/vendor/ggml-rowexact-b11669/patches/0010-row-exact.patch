+// ---- SLLM row-exact mode ----------------------------------------------------------------------------------------------
+// With the mode on, a token row's result does not depend on the other rows of its step, as long as the step has at most
+// `maxn` rows (a graph's n_tokens; 32 at most: the flash-attention scratch is reserved for 32 query rows):
+//   * every weight mat-mul takes ONE accumulation order for any row count, 1 included: ggml's own mul_mv_ext kernel with
+//     nsg = 2, nxpsg = 8 (its per-row sum does not depend on r1ptg, the rows per threadgroup), or, for the shapes it
+//     cannot take (K not a multiple of 128), ggml's mul_mv, whose threadgroups already work one src1 row each;
+//     mul_mv_mma and mul_mm are not used;
+//   * flash attention takes the vec kernel for any row count up to maxn, with Q = 1 and a constant simdgroup count
+//     instead of ones picked from the number of rows and the K/V view length: the baseline config and 2 simdgroups for
+//     an f16 cache; for a quantized cache the device's tuned elements per thread for long-KV decode (one lookup per
+//     type and head size) and 4 simdgroups, as the stock long-context path (the baseline is ~35% slower there).
+// Above maxn rows the stock paths run unchanged (prefill chunks). Off by default, and then every decision below is
+// ggml's own: no kernel source is touched, so the switch-off path is the official one.
+// On: SLLM_ROW_EXACT=1, or ggml_backend_metal_sllm_set_row_exact(1) (exported; a context-level switch for the server).
+// Experiments: SLLM_ROW_EXACT_MAXN (1..32, default 16), SLLM_ROW_EXACT_NSG (1, 2 or 4, default 2; SLLM_ROW_EXACT_NSG_Q
+// for a quantized cache, default 2), SLLM_ROW_EXACT_FA_TUNED=0 (the baseline config for a quantized cache too),
+// SLLM_ROW_EXACT_PARTS (bit 0 mat-muls, bit 1 flash attention; default 3), SLLM_ROW_EXACT_MM=mv (all shapes on mul_mv).
+static std::atomic<int> g_sllm_row_exact(-1);
+
+static bool sllm_row_exact() {
+    int v = g_sllm_row_exact.load(std::memory_order_relaxed);
+    if (v < 0) {
+        const char * e = getenv("SLLM_ROW_EXACT");
+        v = (e && e[0] && e[0] != '0') ? 1 : 0;
+        g_sllm_row_exact.store(v, std::memory_order_relaxed);
+    }
+    return v != 0;
+}
+
+static int sllm_row_exact_env_int(const char * name, int def, int lo, int hi) {
+    const char * e = getenv(name);
+    if (!e || !e[0]) {
+        return def;
+    }
+    const int v = atoi(e);
+    return v < lo ? lo : (v > hi ? hi : v);
+}
+
+static int sllm_row_exact_maxn() {
+    static const int v = sllm_row_exact_env_int("SLLM_ROW_EXACT_MAXN", 16, 1, 32);
+    return v;
+}
+
+static int sllm_row_exact_nsg() {
+    static const int v = []{ const int n = sllm_row_exact_env_int("SLLM_ROW_EXACT_NSG", 2, 1, 4); return n == 3 ? 2 : n; }();
+    return v;
+}
+
+static int sllm_row_exact_nsg_q() {
+    static const int v = []{ const int n = sllm_row_exact_env_int("SLLM_ROW_EXACT_NSG_Q", 2, 1, 4); return n == 3 ? 2 : n; }();
+    return v;
+}
+
+static bool sllm_row_exact_fa_tuned() {
+    static const bool v = sllm_row_exact_env_int("SLLM_ROW_EXACT_FA_TUNED", 1, 0, 1) != 0;
+    return v;
+}
+
+// a quantized K cache (the vec kernel dequantizes it): the long-KV tuned config applies
+static bool sllm_row_exact_kv_quant(const ggml_tensor * op) {
+    const ggml_type t = op->src[1]->type;
+    return t != GGML_TYPE_F16 && t != GGML_TYPE_BF16 && t != GGML_TYPE_F32;
+}
+
+static bool sllm_row_exact_part(int bit) {
+    static const int parts = sllm_row_exact_env_int("SLLM_ROW_EXACT_PARTS", 3, 0, 3);
+    return sllm_row_exact() && (parts & bit) != 0;
+}
+
+extern "C" __attribute__((visibility("default"))) void ggml_backend_metal_sllm_set_row_exact(int on) {
+    g_sllm_row_exact.store(on ? 1 : 0, std::memory_order_relaxed);
+}
+
+extern "C" __attribute__((visibility("default"))) int ggml_backend_metal_sllm_get_row_exact(void) {
+    return sllm_row_exact() ? 1 : 0;
+}
