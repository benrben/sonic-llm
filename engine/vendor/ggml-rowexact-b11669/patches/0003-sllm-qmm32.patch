+    float4 xr[XPT];
+    #define SLLM_Q6P_LOAD_X(kk) _Pragma("unroll") for (int i = 0; i < XPT; ++i) { const int f = tid + i * NTH; \
+        const int n = min(n0 + f / 8, a.N - 1); xr[i] = *((device const float4 *) (X + (uint64_t) n * a.ldx + (kk)) + f % 8); }
+    #define SLLM_Q6P_STORE_X(buf) _Pragma("unroll") for (int i = 0; i < XPT; ++i) { const int f = tid + i * NTH; \
+        threadgroup half * p = xs + (buf) * NT * 32 + (f / 8) * 32 + (f % 8); \
+        const float4 xc = clamp(xr[i], -65504.0f, 65504.0f); /* saturate instead of inf beyond half's range */ \
+        p[0] = (half) xc.x; p[8] = (half) xc.y; p[16] = (half) xc.z; p[24] = (half) xc.w; }
+
+    SLLM_Q6P_LOAD_X(0)
+    SLLM_Q6P_STORE_X(0)
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    int buf = 0;
+    for (int k0 = 0; k0 < a.K; k0 += 32) {
+        const bool more = k0 + 32 < a.K;
+        if (more) { SLLM_Q6P_LOAD_X(k0 + 32) }
+        #pragma unroll
+        for (int nsub = 0; nsub < 2; ++nsub) {
+            #pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                sllm_raw_q6p r;
+                sllm_ld_q6p(rps[4*nsub + j], k0, kbl, r);
+                half4 w4;
+                sllm_cv_q6p(r, k0, kbl, w4);
+                wR[8*(nsub + 0) + 0 + j] = w4[0];
+                wR[8*(nsub + 0) + 4 + j] = w4[1];
+                wR[8*(nsub + 2) + 0 + j] = w4[2];
+                wR[8*(nsub + 2) + 4 + j] = w4[3];
+            }
+        }
+        auto tX = tensor<threadgroup half, dextents<int32_t, 2>, tensor_inline>(xs + buf * NT * 32, dextents<int32_t, 2>(32, NT));
+        mm.run(tX, wR, cT);
+        if (more) { SLLM_Q6P_STORE_X(buf ^ 1) }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        buf ^= 1;
+    }
+    #undef SLLM_Q6P_LOAD_X
+    #undef SLLM_Q6P_STORE_X
+
+    if (r0 >= a.M || nrem <= 0) return;
+    const int mrem = min(SN, a.M - r0);
+    auto tD = tensor(D + (uint64_t) n0 * a.ldd + r0, dextents<int32_t, 2>(mrem, nrem), array<int, 2>({1, a.ldd}));
+    cT.store(tD);
+}
