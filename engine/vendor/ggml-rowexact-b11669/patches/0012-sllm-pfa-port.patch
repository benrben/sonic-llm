diff -ruN a/src/ggml-metal/kernels/prefill.metal b/src/ggml-metal/kernels/prefill.metal
--- a/src/ggml-metal/kernels/prefill.metal	1970-01-01 02:00:00
+++ b/src/ggml-metal/kernels/prefill.metal	2026-11-03 02:07:58
@@ -0,0 +1,803 @@
+// SLLM patch 7 (phase 2 prefillattn): GQA-packed prefill flash attention ("pfa") on the Metal 4 tensor API.
+//
+// Takes a GGML_OP_FLASH_ATTN_EXT of a prefill chunk that sllm-core hinted (op_params[13], see ggml-metal-pfa.h). The
+// inputs are the op's own: q f32 [D, ne01, H] (any token / head strides), K/V f16 views [D, ne11, HKV] (any cell /
+// head strides), the f16 mask [ne30 >= ne11, >= ne01] (0 visible, -inf hidden; added to the scaled scores), and
+// dst f32 [D, H, ne01]. Differences from ggml's kernel_flash_attn_ext_tensor (fa_tensor.metal):
+//   - one threadgroup covers RT rows = RT/G tokens x the G query heads of one KV head, so each K/V tile read from
+//     memory feeds G heads (ggml: 32 tokens of one head; every K/V tile is read once per query head);
+//   - Q is staged once per op as half (scaled) in a device scratch [HKV][row tiles][G][RT/G][D] (kernel_sllm_pfa_q);
+//   - the mask block classes come from ggml's own blk kernel
+//     (kernel_flash_attn_ext_blk, fa_aux.metal) run with nqptg = RT/G and ncpsg = C (0 hidden: skipped; 2 all zero:
+//     no mask read; 1 mixed: mask added).
+// The shared prefix needs no special pass: its blocks are class 2 for every token tile (dense, no mask reads), the
+// agent's own cells are class 1 near the diagonal, and other agents' pages in the view are class 0. One online softmax
+// runs over both ranges, which is the exact log-sum-exp merge of a prefix pass and a suffix pass done in registers.
+//
+// Per row it computes exactly what ggml's kernel computes (same rounding, same order), so its output is bitwise ggml's:
+// switching an op to it changes no token. From the standalone spike sllm/bench/phase2-prefillattn/pfa.metal (v3: the v1
+// tiling with ggml's per-row softmax). ggml-metal-pfa.m self-tests it at device init against ggml's own kernel
+// (bitwise) and a double-precision reference, and disables this path on a mismatch.
+
+#include "common.h"
+
+#if defined(GGML_METAL_HAS_TENSOR)
+
+using namespace mpp::tensor_ops;
+
+// same layout as ggml_metal_kargs_sllm_pfa in ggml-metal-pfa.h
+typedef struct {
+    int32_t ne01;    // tokens of the op
+    int32_t H;       // query heads
+    int32_t HKV;     // KV heads
+    int32_t ne11;    // cells of the K/V view (a multiple of C)
+    int32_t nblk0;   // C-cell blocks the kernel walks: ne11 / C
+    int32_t blk_ld;  // blk row stride: ceil(ne30 / C), ne30 the mask width
+    int32_t ntile;   // row tiles per KV head: ceil(ne01 / (RT/G))
+    int32_t ns;      // streams (patch 11; kernel_sllm_pfa takes 1)
+    uint64_t nb01;   // q token stride (bytes)
+    uint64_t nb02;   // q head stride
+    uint64_t nb11;   // k cell stride
+    uint64_t nb12;   // k head stride
+    uint64_t nb21;   // v cell stride
+    uint64_t nb22;   // v head stride
+    uint64_t nb31;   // mask row stride
+    uint64_t nb1;    // dst token stride (bytes)
+    float scale;
+    int32_t pad1;
+    // patch 11: stream strides (bytes) of q, k, v, the mask and dst; 0 = shared by every stream
+    uint64_t nb03, nb13, nb23, nb33, nb3;
+} sllm_pfa_args;
+
+#define SLLM_PFA_NEG (-FLT_MAX/2)
+
+// Q f32 -> half * scale into qh [HKV][ntile][G][RT/G][D]; rows past ne01 are zero.
+template <int D, int RT, int G>
+kernel void kernel_sllm_pfa_q(
+        constant sllm_pfa_args & a [[buffer(0)]],
+        device const char * q  [[buffer(1)]],
+        device       half * qh [[buffer(2)]],
+        uint3 gid [[thread_position_in_grid]]) {
+    constexpr int TT = RT / G;
+    const int d4 = gid.x;                 // D/4 lanes
+    const int R  = gid.y;                 // row in [0, ntile*RT)
+    const int hk = gid.z % a.HKV;         // gid.z = stream * HKV + KV head (patch 11; one stream before)
+    const int st = gid.z / a.HKV;
+    q  += (uint64_t) st * a.nb03;
+    qh += (uint64_t) st * a.HKV * a.ntile * RT * D;
+    if (d4 >= D / 4 || R >= a.ntile * RT) return;
+    const int tile = R / RT, rl = R % RT, g = rl / TT, tl = rl % TT;
+    const int t = tile * TT + tl;
+    float4 x = 0.0f;
+    if (t < a.ne01) {
+        x = ((device const float4 *) (q + (uint64_t) t * a.nb01 + (uint64_t) (hk * G + g) * a.nb02))[d4];
+    }
+    ((device half4 *) (qh + ((uint64_t) hk * a.ntile * RT + R) * D))[d4] = (half4) (x * a.scale);
+}
+
+// threadgroup memory: S [RT][C] float | P [RT][C] half | alpha [RT] float
+//
+// The per-row arithmetic is exactly that of ggml's kernel_flash_attn_ext_tensor (fa_tensor.metal, b11669), so every
+// row's result is bitwise the one ggml computes: Q K^T and P V on matmul2d with the same descriptors' inner sizes, one
+// simdgroup per row (rows j = jj*NSG + simdgroup), 2 cells per lane (lane, lane + 32), simd_max / simd_sum, the lazy
+// rescale (the running max moves only when it grows by more than 8), the mask added only on mixed blocks, O scaled by
+// 1/S at the end. Blocks hidden from a whole 32/G-token tile are skipped (ggml skips per 32-token tile and computes
+// exact zeros for the rest), so only the K/V traffic changes. The self-test checks the equality at device init.
+template <int D, int RT, int C, int NSG, int G>
+kernel void kernel_sllm_pfa(
+        constant sllm_pfa_args & a [[buffer(0)]],
+        device const half * qh   [[buffer(1)]],
+        device const char * k    [[buffer(2)]],
+        device const char * v    [[buffer(3)]],
+        device const char * mask [[buffer(4)]],
+        device const char * blk  [[buffer(5)]],
+        device       char * dst  [[buffer(6)]],
+        threadgroup  char * shm  [[threadgroup(0)]],
+        uint3  tg    [[threadgroup_position_in_grid]],
+        ushort tiisg [[thread_index_in_simdgroup]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    constexpr int NW = 32;
+    constexpr int NQ = RT / NSG;          // rows per simdgroup
+    constexpr int NC = C / NW;            // cells per lane
+    constexpr int TT = RT / G;            // tokens per tile
+    static_assert(RT % NSG == 0 && C % NW == 0 && RT % G == 0, "tile");
+
+    const int hk = tg.x, tile = tg.y;
+
+    threadgroup float * ss = (threadgroup float *) shm;
+    threadgroup half  * sp = (threadgroup half *) (ss + RT * C);
+    threadgroup float * sa = (threadgroup float *) (sp + RT * C);
+
+    constexpr auto dqk = matmul2d_descriptor(RT, C, D, false, true, false, matmul2d_descriptor::mode::multiply);
+    constexpr auto dpv = matmul2d_descriptor(RT, D, C, false, false, false, matmul2d_descriptor::mode::multiply_accumulate);
+    matmul2d<dqk, execution_simdgroups<NSG>> mqk;
+    matmul2d<dpv, execution_simdgroups<NSG>> mpv;
+
+    const int ldk = (int) (a.nb11 / 2), ldv = (int) (a.nb21 / 2);
+    device const half * kh = (device const half *) (k + (uint64_t) hk * a.nb12);
+    device const half * vh = (device const half *) (v + (uint64_t) hk * a.nb22);
+
+    auto tQ = tensor((device half *) qh + ((uint64_t) hk * a.ntile + tile) * RT * D, dextents<int32_t, 2>(D, RT), array<int, 2>({1, D}));
+    auto tS = tensor(ss, dextents<int32_t, 2>(C, RT), array<int, 2>({1, C}));
+    auto tP = tensor(sp, dextents<int32_t, 2>(C, RT), array<int, 2>({1, C}));
+    auto tK0 = tensor((device half *) kh, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldk}));
+    auto tV0 = tensor((device half *) vh, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldv}));
+    auto cS = mqk.template get_destination_cooperative_tensor<decltype(tQ), decltype(tK0), float>();
+    auto cO = mpv.template get_destination_cooperative_tensor<decltype(tP), decltype(tV0), float>();
+    #pragma unroll
+    for (uint16_t i = 0; i < cO.get_capacity(); ++i) {
+        if (cO.is_valid_element(i)) cO[i] = 0.0f;
+    }
+
+    device const half * pm[NQ];
+    bool rv[NQ];
+    float M[NQ], S[NQ];
+    #pragma unroll
+    for (int jj = 0; jj < NQ; ++jj) {
+        const int j = jj * NSG + sgitg;
+        const int t = tile * TT + j % TT;
+        rv[jj] = t < a.ne01;
+        pm[jj] = (device const half *) (mask + (uint64_t) (rv[jj] ? t : 0) * a.nb31);
+        M[jj] = SLLM_PFA_NEG;
+        S[jj] = 0.0f;
+    }
+    device const char * brow = blk + (uint64_t) tile * a.blk_ld;
+
+    for (int ib = 0; ib < a.nblk0; ++ib) {
+        const char bc = brow[ib];
+        if (bc == 0) continue;
+        const int cb = ib * C;
+
+        auto tK = tensor((device half *) kh + (uint64_t) cb * ldk, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldk}));
+        mqk.run(tQ, tK, cS);
+        cS.store(tS);
+        threadgroup_barrier(mem_flags::mem_threadgroup);   // also: the previous block's P V is done with P
+
+        #pragma unroll
+        for (int jj = 0; jj < NQ; ++jj) {
+            const int j = jj * NSG + sgitg;
+            float s[NC];
+            #pragma unroll
+            for (int ii = 0; ii < NC; ++ii) s[ii] = ss[j * C + ii * NW + tiisg];
+            if (!rv[jj]) {
+                #pragma unroll
+                for (int ii = 0; ii < NC; ++ii) s[ii] = -INFINITY;
+            } else if (bc != 2) {
+                #pragma unroll
+                for (int ii = 0; ii < NC; ++ii) s[ii] += (float) pm[jj][cb + ii * NW + tiisg];
+            }
+            float m = M[jj];
+            #pragma unroll
+            for (int ii = 0; ii < NC; ++ii) m = max(m, s[ii]);
+            m = simd_max(m);
+            float ms = 1.0f;
+            if (m > M[jj] + 8.0f) {
+                ms = exp(M[jj] - m);
+                M[jj] = m;
+            }
+            float sum = 0.0f;
+            #pragma unroll
+            for (int ii = 0; ii < NC; ++ii) {
+                const half p = (half) exp(s[ii] - M[jj]);   // the sum uses the same rounded values as P V (as ggml)
+                sp[j * C + ii * NW + tiisg] = p;
+                sum += (float) p;
+            }
+            S[jj] = S[jj] * ms + simd_sum(sum);
+            if (tiisg == 0) sa[j] = ms;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        // O = diag(ms) O + P V (ms is exactly 1 for rows that did not rescale)
+        #pragma unroll
+        for (uint16_t i = 0; i < cO.get_capacity(); ++i) {
+            if (cO.is_valid_element(i)) {
+                const auto ix = cO.get_multidimensional_index(i);
+                cO[i] *= sa[ix[1]];
+            }
+        }
+        auto tV = tensor((device half *) vh + (uint64_t) cb * ldv, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldv}));
+        mpv.run(tP, tV, cO);
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    #pragma unroll
+    for (int jj = 0; jj < NQ; ++jj) {
+        const int j = jj * NSG + sgitg;
+        if (tiisg == 0) sa[j] = S[jj] == 0.0f ? 0.0f : 1.0f / S[jj];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    // dst [D, H, ne01]: row (g, tl) of the tile -> token tile*TT + tl, head hk*G + g
+    #pragma unroll
+    for (uint16_t i = 0; i < cO.get_capacity(); ++i) {
+        if (cO.is_valid_element(i)) {
+            const auto ix = cO.get_multidimensional_index(i);
+            const int rr = ix[1], d = ix[0];
+            const int tt = tile * TT + rr % TT, g = rr / TT;
+            if (tt < a.ne01) {
+                ((device float *) (dst + (uint64_t) tt * a.nb1))[(hk * G + g) * D + d] = cO[i] * sa[rr];
+            }
+        }
+    }
+}
+
+#define SLLM_PFA(D, RT, C, NSG, G) \
+    template [[host_name("kernel_sllm_pfa_d" #D "_rt" #RT "_c" #C "_sg" #NSG "_g" #G)]] \
+    kernel void kernel_sllm_pfa<D, RT, C, NSG, G>(constant sllm_pfa_args &, device const half *, device const char *, \
+        device const char *, device const char *, device const char *, device char *, threadgroup char *, uint3, ushort, ushort);
+#define SLLM_PFAQ(D, RT, G) \
+    template [[host_name("kernel_sllm_pfa_q_d" #D "_rt" #RT "_g" #G)]] \
+    kernel void kernel_sllm_pfa_q<D, RT, G>(constant sllm_pfa_args &, device const char *, device half *, uint3);
+
+// the measured tile (RT 32 rows, C 64 cells, 4 simdgroups) for both head sizes and G = 2, 4
+SLLM_PFA(128, 32, 64, 4, 2) SLLM_PFA(128, 32, 64, 4, 4)
+SLLM_PFA(256, 32, 64, 4, 2) SLLM_PFA(256, 32, 64, 4, 4)
+SLLM_PFAQ(128, 32, 2) SLLM_PFAQ(128, 32, 4)
+SLLM_PFAQ(256, 32, 2) SLLM_PFAQ(256, 32, 4)
+
+// SLLM patch 11 (phase2-prefill2): kernel_sllm_pfa2, the same per-row arithmetic as kernel_sllm_pfa (so bitwise
+// ggml's), faster:
+//   - two consecutive visible 64-cell blocks share one Q K^T run over 128 cells, and one P V run over 128 cells when
+//     no row rescales in the second block (matmul2d's result does not depend on how its K extent is split into runs;
+//     the init self-test checks the equality with ggml's kernel); the softmax still walks each 64-cell block in order
+//     with ggml's lazy rescale;
+//   - O is rescaled only when some row of the threadgroup moved its running max in that block (else ms is exactly 1
+//     for every row and O * 1 = O).
+// threadgroup memory: S [RT][128] float | P [RT][128] half | ms [2][RT] float | 2 flags
+template <int D, int RT, int NSG, int G>
+kernel void kernel_sllm_pfa2(
+        constant sllm_pfa_args & a [[buffer(0)]],
+        device const half * qh   [[buffer(1)]],
+        device const char * k    [[buffer(2)]],
+        device const char * v    [[buffer(3)]],
+        device const char * mask [[buffer(4)]],
+        device const char * blk  [[buffer(5)]],
+        device       char * dst  [[buffer(6)]],
+        threadgroup  char * shm  [[threadgroup(0)]],
+        uint3  tg    [[threadgroup_position_in_grid]],
+        ushort tiisg [[thread_index_in_simdgroup]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    constexpr int C = 64, C2 = 128;
+    constexpr int NW = 32;
+    constexpr int NQ = RT / NSG;          // rows per simdgroup
+    constexpr int NC = C / NW;            // cells per lane
+    constexpr int TT = RT / G;            // tokens per tile
+    static_assert(RT % NSG == 0 && RT % G == 0, "tile");
+
+    const int hk = tg.x, tile = tg.y, st = tg.z;   // st: the stream (ne03), each its own query rows, K/V view, mask, dst
+    qh   += (uint64_t) st * a.HKV * a.ntile * RT * D;
+    k    += (uint64_t) st * a.nb13;
+    v    += (uint64_t) st * a.nb23;
+    mask += (uint64_t) st * a.nb33;
+    blk  += (uint64_t) st * a.ntile * a.blk_ld;
+    dst  += (uint64_t) st * a.nb3;
+
+    threadgroup float * ss = (threadgroup float *) shm;
+    threadgroup half  * sp = (threadgroup half *) (ss + RT * C2);
+    threadgroup float * sa = (threadgroup float *) (sp + RT * C2);
+    threadgroup int   * sf = (threadgroup int *) (sa + 2 * RT);   // [0]: a row rescaled in the second block, [1]: in the first
+
+    constexpr auto dqk1 = matmul2d_descriptor(RT, C,  D, false, true, false, matmul2d_descriptor::mode::multiply);
+    constexpr auto dqk2 = matmul2d_descriptor(RT, C2, D, false, true, false, matmul2d_descriptor::mode::multiply);
+    constexpr auto dpv  = matmul2d_descriptor(RT, D, static_cast<int>(dynamic_extent), false, false, false, matmul2d_descriptor::mode::multiply_accumulate);
+    matmul2d<dqk1, execution_simdgroups<NSG>> mqk1;
+    matmul2d<dqk2, execution_simdgroups<NSG>> mqk2;
+    matmul2d<dpv,  execution_simdgroups<NSG>> mpv;
+
+    const int ldk = (int) (a.nb11 / 2), ldv = (int) (a.nb21 / 2);
+    device const half * kh = (device const half *) (k + (uint64_t) hk * a.nb12);
+    device const half * vh = (device const half *) (v + (uint64_t) hk * a.nb22);
+
+    auto tQ  = tensor((device half *) qh + ((uint64_t) hk * a.ntile + tile) * RT * D, dextents<int32_t, 2>(D, RT), array<int, 2>({1, D}));
+    auto tS1 = tensor(ss, dextents<int32_t, 2>(C,  RT), array<int, 2>({1, C2}));
+    auto tS2 = tensor(ss, dextents<int32_t, 2>(C2, RT), array<int, 2>({1, C2}));
+    auto tK1 = tensor((device half *) kh, dextents<int32_t, 2>(D, C),  array<int, 2>({1, ldk}));
+    auto tK2 = tensor((device half *) kh, dextents<int32_t, 2>(D, C2), array<int, 2>({1, ldk}));
+    auto tP0 = tensor(sp, dextents<int32_t, 2>(C2, RT), array<int, 2>({1, C2}));
+    auto tV0 = tensor((device half *) vh, dextents<int32_t, 2>(D, C2), array<int, 2>({1, ldv}));
+    auto cS1 = mqk1.template get_destination_cooperative_tensor<decltype(tQ), decltype(tK1), float>();
+    auto cS2 = mqk2.template get_destination_cooperative_tensor<decltype(tQ), decltype(tK2), float>();
+    auto cO  = mpv.template get_destination_cooperative_tensor<decltype(tP0), decltype(tV0), float>();
+    #pragma unroll
+    for (uint16_t i = 0; i < cO.get_capacity(); ++i) {
+        if (cO.is_valid_element(i)) cO[i] = 0.0f;
+    }
+
+    float M[NQ], S[NQ];
+    #pragma unroll
+    for (int jj = 0; jj < NQ; ++jj) {
+        M[jj] = SLLM_PFA_NEG;
+        S[jj] = 0.0f;
+    }
+    device const char * brow = blk + (uint64_t) tile * a.blk_ld;
+
+    // the softmax of the 64-cell block at cell cb (columns co.. of S and P): kernel_sllm_pfa's per-row arithmetic;
+    // each row's ms -> sa[h*RT + row]; returns whether some row of this simdgroup rescaled
+    auto smax = [&](const char bc, const int cb, const int co, const int h) {
+        bool any = false;
+        #pragma unroll
+        for (int jj = 0; jj < NQ; ++jj) {
+            const int j = jj * NSG + sgitg;
+            const int t = tile * TT + j % TT;
+            float s[NC];
+            #pragma unroll
+            for (int ii = 0; ii < NC; ++ii) s[ii] = ss[j * C2 + co + ii * NW + tiisg];
+            if (t >= a.ne01) {
+                #pragma unroll
+                for (int ii = 0; ii < NC; ++ii) s[ii] = -INFINITY;
+            } else if (bc != 2) {
+                device const half * pm = (device const half *) (mask + (uint64_t) t * a.nb31);
+                #pragma unroll
+                for (int ii = 0; ii < NC; ++ii) s[ii] += (float) pm[cb + ii * NW + tiisg];
+            }
+            float m = M[jj];
+            #pragma unroll
+            for (int ii = 0; ii < NC; ++ii) m = max(m, s[ii]);
+            m = simd_max(m);
+            float ms = 1.0f;
+            if (m > M[jj] + 8.0f) {
+                ms = exp(M[jj] - m);
+                M[jj] = m;
+                any = true;
+            }
+            float sum = 0.0f;
+            #pragma unroll
+            for (int ii = 0; ii < NC; ++ii) {
+                const half p = (half) exp(s[ii] - M[jj]);   // the sum uses the same rounded values as P V (as ggml)
+                sp[j * C2 + co + ii * NW + tiisg] = p;
+                sum += (float) p;
+            }
+            S[jj] = S[jj] * ms + simd_sum(sum);
+            if (tiisg == 0) sa[h * RT + j] = ms;
+        }
+        return any;
+    };
+    auto rescale = [&](const int h) {
+        #pragma unroll
+        for (uint16_t i = 0; i < cO.get_capacity(); ++i) {
+            if (cO.is_valid_element(i)) {
+                const auto ix = cO.get_multidimensional_index(i);
+                cO[i] *= sa[h * RT + ix[1]];
+            }
+        }
+    };
+
+    int ib = 0;
+    while (ib < a.nblk0) {
+        const char b0 = brow[ib];
+        if (b0 == 0) {
+            ++ib;
+            continue;
+        }
+        const char b1 = ib + 1 < a.nblk0 ? brow[ib + 1] : 0;
+        const int cb = ib * C;
+        if (b1 != 0) {
+            // two visible blocks: one Q K^T over 128 cells, then block cb and block cb + 64 in order
+            auto tK = tensor((device half *) kh + (uint64_t) cb * ldk, dextents<int32_t, 2>(D, C2), array<int, 2>({1, ldk}));
+            mqk2.run(tQ, tK, cS2);
+            cS2.store(tS2);
+            if (sgitg == 0 && tiisg == 0) { sf[0] = 0; sf[1] = 0; }
+            threadgroup_barrier(mem_flags::mem_threadgroup);   // also: the previous P V is done with P
+            const bool r0 = smax(b0, cb, 0, 0);
+            const bool r1 = smax(b1, cb + C, C, 1);
+            if (r1 && tiisg == 0) sf[0] = 1;
+            if (r0 && tiisg == 0) sf[1] = 1;
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (sf[1] != 0) rescale(0);
+            if (sf[0] == 0) {
+                // ms of the second block is exactly 1 for every row: O + P0 V0 + P1 V1 in one run
+                auto tP = tensor(sp, dextents<int32_t, 2>(C2, RT), array<int, 2>({1, C2}));
+                auto tV = tensor((device half *) vh + (uint64_t) cb * ldv, dextents<int32_t, 2>(D, C2), array<int, 2>({1, ldv}));
+                mpv.run(tP, tV, cO);
+            } else {
+                auto tP1 = tensor(sp, dextents<int32_t, 2>(C, RT), array<int, 2>({1, C2}));
+                auto tV1 = tensor((device half *) vh + (uint64_t) cb * ldv, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldv}));
+                mpv.run(tP1, tV1, cO);
+                rescale(1);
+                auto tP2 = tensor(sp + C, dextents<int32_t, 2>(C, RT), array<int, 2>({1, C2}));
+                auto tV2 = tensor((device half *) vh + (uint64_t) (cb + C) * ldv, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldv}));
+                mpv.run(tP2, tV2, cO);
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            ib += 2;
+        } else {
+            // a visible block followed by a hidden one (or the end): the one block alone
+            auto tK = tensor((device half *) kh + (uint64_t) cb * ldk, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldk}));
+            mqk1.run(tQ, tK, cS1);
+            cS1.store(tS1);
+            if (sgitg == 0 && tiisg == 0) sf[1] = 0;
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            const bool r0 = smax(b0, cb, 0, 0);
+            if (r0 && tiisg == 0) sf[1] = 1;
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (sf[1] != 0) rescale(0);
+            auto tP1 = tensor(sp, dextents<int32_t, 2>(C, RT), array<int, 2>({1, C2}));
+            auto tV1 = tensor((device half *) vh + (uint64_t) cb * ldv, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldv}));
+            mpv.run(tP1, tV1, cO);
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            ib += 2;
+        }
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    #pragma unroll
+    for (int jj = 0; jj < NQ; ++jj) {
+        const int j = jj * NSG + sgitg;
+        if (tiisg == 0) sa[j] = S[jj] == 0.0f ? 0.0f : 1.0f / S[jj];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    // dst [D, H, ne01]: row (g, tl) of the tile -> token tile*TT + tl, head hk*G + g
+    #pragma unroll
+    for (uint16_t i = 0; i < cO.get_capacity(); ++i) {
+        if (cO.is_valid_element(i)) {
+            const auto ix = cO.get_multidimensional_index(i);
+            const int rr = ix[1], d = ix[0];
+            const int tt = tile * TT + rr % TT, g = rr / TT;
+            if (tt < a.ne01) {
+                ((device float *) (dst + (uint64_t) tt * a.nb1))[(hk * G + g) * D + d] = cO[i] * sa[rr];
+            }
+        }
+    }
+}
+
+#define SLLM_PFA2(D, RT, NSG, G) \
+    template [[host_name("kernel_sllm_pfa2_d" #D "_rt" #RT "_c64_sg" #NSG "_g" #G)]] \
+    kernel void kernel_sllm_pfa2<D, RT, NSG, G>(constant sllm_pfa_args &, device const half *, device const char *, \
+        device const char *, device const char *, device const char *, device char *, threadgroup char *, uint3, ushort, ushort);
+
+SLLM_PFA2(128, 32, 4, 2) SLLM_PFA2(128, 32, 4, 4)
+SLLM_PFA2(256, 32, 4, 2) SLLM_PFA2(256, 32, 4, 4)
+
+#endif // GGML_METAL_HAS_TENSOR
+
+// ---------------------------------------------------------------------------------------------------------------------
+// SLLM patch 13 (phase2-fuse): fused small ops, each bitwise the ggml kernels it replaces (same per-element arithmetic,
+// same reduction structure; ggml-metal-ops.cpp dispatches them with ggml's own thread counts):
+//   kernel_sllm_norm_rope_*  RMS_NORM + MUL (kernel_rms_norm_mul_f32_4) + ROPE NEOX (kernel_rope_neox_f32), then
+//                            mode 0: f32 out; mode 1: + SCALE (kernel_unary_f32_f32_4 scale: scale*x + bias);
+//                            mode 2: + SET_ROWS into an f16 cache row (kernel_set_rows_f16: (half) x)
+//   kernel_sllm_add_norm     ADD (both outputs kept) + RMS_NORM + MUL
+// One threadgroup per row (head of a token, or hidden row); thread t holds float4 t of the row.
+
+typedef struct {
+    int32_t  ne00;     // row width (floats), a multiple of 4
+    int32_t  ne00_t;   // ne00 / 4 (= threads of the norm)
+    int32_t  ne01, ne02;
+    uint64_t nb01, nb02, nb03;        // x row strides (bytes)
+    int32_t  nw1, nw2, nw3, pad0;     // weight broadcast extents
+    uint64_t nbw1, nbw2, nbw3;        // weight strides
+    uint64_t nb1, nb2, nb3;           // dst strides (f32 out; mode 2: unused)
+    float    eps;
+    // rope
+    int32_t  n_dims, n_ctx_orig;
+    float    freq_base, freq_scale, ext_factor, attn_factor, beta_fast, beta_slow;
+    // scale (mode 1)
+    float    scale, bias;
+    // set_rows (mode 2): dst cell stride (bytes), index stride (bytes), index type i64 (1) or i32 (0)
+    uint64_t nbr1, nbi0;
+    int32_t  idx_i64, pad1;
+    // add_norm: second addend strides and the sum's strides
+    uint64_t nbb1, nbb2, nbb3;
+    uint64_t nbs1, nbs2, nbs3;
+    float    eps2;     // norm_add_norm: the second norm's eps
+    int32_t  pad2;
+} sllm_fuse_args;
+
+static float sllm_rope_yarn_ramp(const float low, const float high, const int i0) {
+    const float y = (i0 / 2 - low) / max(0.001f, high - low);
+    return 1.0f - min(1.0f, max(0.0f, y));
+}
+
+static void sllm_rope_yarn(
+    float theta_extrap, float freq_scale, float corr_dims[2], int i0, float ext_factor, float mscale,
+    thread float * cos_theta, thread float * sin_theta) {
+    float theta_interp = freq_scale * theta_extrap;
+    float theta = theta_interp;
+    if (ext_factor != 0.0f) {
+        float ramp_mix = sllm_rope_yarn_ramp(corr_dims[0], corr_dims[1], i0) * ext_factor;
+        theta = theta_interp * (1 - ramp_mix) + theta_extrap * ramp_mix;
+        mscale *= 1.0f + 0.1f * log(1.0f / freq_scale);
+    }
+    *cos_theta = cos(theta) * mscale;
+    *sin_theta = sin(theta) * mscale;
+}
+
+static float sllm_rope_yarn_corr_factor(int n_dims, int n_ctx_orig, float n_rot, float base) {
+    return n_dims * log(n_ctx_orig / (n_rot * 2 * M_PI_F)) / (2 * log(base));
+}
+
+static void sllm_rope_yarn_corr_dims(
+    int n_dims, int n_ctx_orig, float freq_base, float beta_fast, float beta_slow, float dims[2]
+) {
+    dims[0] = max(0.0f,         floor(sllm_rope_yarn_corr_factor(n_dims, n_ctx_orig, beta_fast, freq_base)));
+    dims[1] = min(n_dims - 1.0f, ceil(sllm_rope_yarn_corr_factor(n_dims, n_ctx_orig, beta_slow, freq_base)));
+}
+
+// grid (ne01, ne02, ne03) = (heads, tokens, 1), ne00_t threads; shmem: 32 floats + 2 x ne00 floats.
+// The norm and the rope are ggml's code (kernel_rms_norm_fuse_impl<float4, 2>, kernel_rope_neox<float>) with the same
+// loops, so the compiler emits the same arithmetic (a folded "0 + dot" or a different fma contraction would change
+// the last bit); only their outputs go to threadgroup memory instead of device memory.
+template <int MODE>
+kernel void kernel_sllm_norm_rope(
+        constant sllm_fuse_args & args,
+        device const char * src0,     // x f32 [ne00, ne01, ne02]
+        device const char * src1_0,   // norm weight
+        device const char * src1,     // i32 positions [ne02]
+        device       char * dst,      // mode 0/1: f32 out; mode 2: the f16 cache
+        device const char * idx,      // mode 2: cell of each token
+        threadgroup float * shmem_f32 [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    typedef float4 T;
+
+    if (sgitg == 0) {
+        shmem_f32[tiisg] = 0.0f;
+    }
+
+    const int i01 = tgpig.x;
+    const int i02 = tgpig.y;
+    const int i03 = tgpig.z;
+
+    device const T * x = (device const T *) (src0 + i03*args.nb03 + i02*args.nb02 + i01*args.nb01);
+
+    device const T * f0 = (device const T *) (src1_0 + (i03%args.nw3)*args.nbw3 + (i02%args.nw2)*args.nbw2 + (i01%args.nw1)*args.nbw1);
+
+    float sumf = 0.0f;
+
+    // parallel sum
+    for (int i00 = tpitg.x; i00 < args.ne00_t; i00 += ntg.x) {
+        sumf += dot(x[i00], x[i00]);
+    }
+    sumf = simd_sum(sumf);
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (tiisg == 0) {
+        shmem_f32[sgitg] = sumf;
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    sumf = shmem_f32[tiisg];
+    sumf = simd_sum(sumf);
+
+    const float mean  = sumf/args.ne00;
+    const float scale = 1.0f/sqrt(mean + args.eps);
+
+    threadgroup T * y = (threadgroup T *) (shmem_f32 + 32);
+    for (int i00 = tpitg.x; i00 < args.ne00_t; i00 += ntg.x) {
+        y[i00] = (x[i00]*scale)*f0[i00];
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    // rope (NEOX), from the normalized row in threadgroup memory
+    threadgroup const float * src_row = shmem_f32 + 32;
+    threadgroup       float * rot     = shmem_f32 + 32 + args.ne00;
+    device float * out_row = (device float *) (dst + i03*args.nb3 + i02*args.nb2 + i01*args.nb1);
+
+    float corr_dims[2];
+    sllm_rope_yarn_corr_dims(args.n_dims, args.n_ctx_orig, args.freq_base, args.beta_fast, args.beta_slow, corr_dims);
+
+    device const int32_t * pos = (device const int32_t *) src1;
+
+    const float theta_base = (float) pos[i02];
+    const float inv_ndims = -1.f/args.n_dims;
+
+    float cos_theta;
+    float sin_theta;
+
+    for (int i0 = 2*tpitg.x; i0 < args.ne00; i0 += 2*ntg.x) {
+        if (i0 < args.n_dims) {
+            const int iw = i0;
+            const int ic = iw/2;
+
+            const float theta = theta_base * pow(args.freq_base, inv_ndims*iw);
+
+            const float freq_factor = 1.0f;
+
+            sllm_rope_yarn(theta/freq_factor, args.freq_scale, corr_dims, iw, args.ext_factor, args.attn_factor, &cos_theta, &sin_theta);
+
+            threadgroup const float * const s = src_row + ic;
+
+            const float x0 = s[0];
+            const float x1 = s[args.n_dims/2];
+
+            if (MODE == 0) {
+                device float * d = out_row + ic;
+                d[0]             = fma(x0, cos_theta, -(x1*sin_theta));
+                d[args.n_dims/2] = fma(x1, cos_theta, x0*sin_theta);
+            } else {
+                threadgroup float * d = rot + ic;
+                d[0]             = fma(x0, cos_theta, -(x1*sin_theta));
+                d[args.n_dims/2] = fma(x1, cos_theta, x0*sin_theta);
+            }
+        } else {
+            if (MODE == 0) {
+                out_row[i0]     = src_row[i0];
+                out_row[i0 + 1] = src_row[i0 + 1];
+            } else {
+                rot[i0]     = src_row[i0];
+                rot[i0 + 1] = src_row[i0 + 1];
+            }
+        }
+    }
+
+    if (MODE == 0) {
+        return;
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    const T r = ((threadgroup const T *) rot)[tpitg.x];
+    if (MODE == 1) {
+        // kernel_unary_impl<float4, float4, float4>, OP_UNARY_NUM_SCALE
+        const T xs = (T) r;
+        ((device T *) out_row)[tpitg.x] = (T) (args.scale * xs + args.bias);
+    }
+    if (MODE == 2) {
+        // kernel_set_rows_f: dst_row[ind] = (TD) src_row[ind]
+        const int64_t cell = args.idx_i64 ? ((device const int64_t *) (idx + i02*args.nbi0))[0]
+                                          : (int64_t) ((device const int32_t *) (idx + i02*args.nbi0))[0];
+        device half4 * d = (device half4 *) (dst + cell*args.nbr1 + (uint64_t) i01*args.ne00*2);
+        d[tpitg.x] = (half4) r;
+    }
+}
+
+typedef decltype(kernel_sllm_norm_rope<0>) kernel_sllm_norm_rope_t;
+template [[host_name("kernel_sllm_norm_rope_f32")]]   kernel kernel_sllm_norm_rope_t kernel_sllm_norm_rope<0>;
+template [[host_name("kernel_sllm_norm_rope_scale")]] kernel kernel_sllm_norm_rope_t kernel_sllm_norm_rope<1>;
+template [[host_name("kernel_sllm_norm_rope_rows")]]  kernel kernel_sllm_norm_rope_t kernel_sllm_norm_rope<2>;
+
+// ADD + RMS_NORM + MUL: s = a + b (written), y = (s*scale)*w (written); nth threads per row as ggml's norm picks them
+kernel void kernel_sllm_add_norm(
+        constant sllm_fuse_args & args,
+        device const char * srca,
+        device const char * srcb,
+        device const char * srcw,
+        device       char * sum,
+        device       char * dst,
+        threadgroup float * shmem_f32 [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    if (sgitg == 0) {
+        shmem_f32[tiisg] = 0.0f;
+    }
+
+    const int i01 = tgpig.x;
+    const int i02 = tgpig.y;
+    const int i03 = tgpig.z;
+
+    device const float4 * a  = (device const float4 *) (srca + i03*args.nb03 + i02*args.nb02 + i01*args.nb01);
+    device const float4 * b  = (device const float4 *) (srcb + i03*args.nbb3 + i02*args.nbb2 + i01*args.nbb1);
+    device       float4 * s  = (device       float4 *) (sum  + i03*args.nbs3 + i02*args.nbs2 + i01*args.nbs1);
+    device const float4 * f0 = (device const float4 *) (srcw + (i03%args.nw3)*args.nbw3 + (i02%args.nw2)*args.nbw2 + (i01%args.nw1)*args.nbw1);
+    device       float4 * y  = (device       float4 *) (dst  + i03*args.nb3  + i02*args.nb2  + i01*args.nb1);
+
+    float sumf = 0.0f;
+    for (int i00 = tpitg.x; i00 < args.ne00_t; i00 += ntg.x) {
+        const float4 v = a[i00] + b[i00];
+        s[i00] = v;
+        sumf += dot(v, v);
+    }
+    sumf = simd_sum(sumf);
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (tiisg == 0) {
+        shmem_f32[sgitg] = sumf;
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    sumf = shmem_f32[tiisg];
+    sumf = simd_sum(sumf);
+
+    const float mean  = sumf/args.ne00;
+    const float scale = 1.0f/sqrt(mean + args.eps);
+
+    for (int i00 = tpitg.x; i00 < args.ne00_t; i00 += ntg.x) {
+        y[i00] = (s[i00]*scale)*f0[i00];
+    }
+}
+
+// RMS_NORM + MUL + ADD (kernel_rms_norm_fuse_impl<float4, 3>), then RMS_NORM + MUL (kernel_rms_norm_fuse_impl<float4, 2>)
+// of that sum, in one pass (Gemma-3: a post-norm with its residual add, then the next pre-norm). Both are ggml's code
+// with ggml's loops; the sum is written (an output) and re-read by the same threads for the second norm.
+kernel void kernel_sllm_norm_add_norm(
+        constant sllm_fuse_args & args,
+        device const char * src0,     // x
+        device const char * src1_0,   // first weight
+        device const char * src1_1,   // the residual
+        device const char * src2_0,   // second weight
+        device       char * sum,      // first norm * w + residual
+        device       char * dst,      // second norm * w
+        threadgroup float * shmem_f32 [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort3 tpitg[[thread_position_in_threadgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort3   ntg[[threads_per_threadgroup]]) {
+    typedef float4 T;
+
+    if (sgitg == 0) {
+        shmem_f32[tiisg] = 0.0f;
+    }
+
+    const int i01 = tgpig.x;
+    const int i02 = tgpig.y;
+    const int i03 = tgpig.z;
+
+    device const T * x  = (device const T *) (src0   + i03*args.nb03 + i02*args.nb02 + i01*args.nb01);
+    device const T * f0 = (device const T *) (src1_0 + (i03%args.nw3)*args.nbw3 + (i02%args.nw2)*args.nbw2 + (i01%args.nw1)*args.nbw1);
+    device const T * f1 = (device const T *) (src1_1 + i03*args.nbb3 + i02*args.nbb2 + i01*args.nbb1);
+    device const T * g0 = (device const T *) (src2_0 + (i03%args.nw3)*args.nbw3 + (i02%args.nw2)*args.nbw2 + (i01%args.nw1)*args.nbw1);
+
+    float sumf = 0.0f;
+
+    // parallel sum
+    for (int i00 = tpitg.x; i00 < args.ne00_t; i00 += ntg.x) {
+        sumf += dot(x[i00], x[i00]);
+    }
+    sumf = simd_sum(sumf);
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (tiisg == 0) {
+        shmem_f32[sgitg] = sumf;
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    sumf = shmem_f32[tiisg];
+    sumf = simd_sum(sumf);
+
+    const float mean  = sumf/args.ne00;
+    const float scale = 1.0f/sqrt(mean + args.eps);
+
+    device T * y = (device T *) (sum + i03*args.nbs3 + i02*args.nbs2 + i01*args.nbs1);
+    for (int i00 = tpitg.x; i00 < args.ne00_t; i00 += ntg.x) {
+        y[i00] = (x[i00]*scale)*f0[i00] + f1[i00];
+    }
+
+    // the second norm (ggml's kernel run on y): its shared memory is re-zeroed as at that kernel's start
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sgitg == 0) {
+        shmem_f32[tiisg] = 0.0f;
+    }
+
+    device const T * x2 = (device const T *) y;
+
+    float sumf2 = 0.0f;
+
+    for (int i00 = tpitg.x; i00 < args.ne00_t; i00 += ntg.x) {
+        sumf2 += dot(x2[i00], x2[i00]);
+    }
+    sumf2 = simd_sum(sumf2);
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (tiisg == 0) {
+        shmem_f32[sgitg] = sumf2;
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    sumf2 = shmem_f32[tiisg];
+    sumf2 = simd_sum(sumf2);
+
+    const float mean2  = sumf2/args.ne00;
+    const float scale2 = 1.0f/sqrt(mean2 + args.eps2);
+
+    device T * y2 = (device T *) (dst + i03*args.nb3 + i02*args.nb2 + i01*args.nb1);
+    for (int i00 = tpitg.x; i00 < args.ne00_t; i00 += ntg.x) {
+        y2[i00] = (x2[i00]*scale2)*g0[i00];
+    }
+}
