+// SLLM profiling (patches-profile/0102)
+#include <atomic>
+#include <cstdio>
+#include <mutex>
+#include <string>
+struct sllm_np_meta {
+    std::string line; // the JSON fields of the op (without the timing)
+};
+static int sllm_np_mode = -1; // -1 unknown, 0 off, 1 on
+static std::atomic<int> sllm_np_next{0};
+static std::vector<sllm_np_meta> sllm_np_metas;
+static std::mutex sllm_np_mu;
+static long sllm_np_graph = 0;
+
+static bool sllm_np_on() {
+    if (sllm_np_mode < 0) {
+        sllm_np_mode = getenv("SLLM_METAL_NODEPROF") != nullptr;
+        if (sllm_np_mode) {
+            sllm_np_metas.resize(ggml_metal_sllm_nodeprof_max_slots());
+        }
+    }
+    return sllm_np_mode == 1;
+}
+
+static void sllm_np_tensor(std::string & s, const char * key, const ggml_tensor * t) {
+    char b[512];
+    if (!t) {
+        return;
+    }
+    snprintf(b, sizeof(b), ",\"%s\":{\"name\":\"%s\",\"type\":\"%s\",\"op\":\"%s\",\"ne\":[%lld,%lld,%lld,%lld],\"nb\":[%zu,%zu,%zu,%zu],\"cont\":%d}",
+            key, t->name, ggml_type_name(t->type), ggml_op_name(t->op), (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2],
+            (long long) t->ne[3], t->nb[0], t->nb[1], t->nb[2], t->nb[3], ggml_is_contiguous(t) ? 1 : 0);
+    s += b;
+}
+
+static int sllm_np_skip(const ggml_tensor * node) {
+    if (ggml_is_empty(node)) {
+        return 1;
+    }
+    switch (node->op) {
+        case GGML_OP_NONE: case GGML_OP_RESHAPE: case GGML_OP_VIEW: case GGML_OP_TRANSPOSE: case GGML_OP_PERMUTE: return 1;
+        default: break;
+    }
+    return (node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0;
+}
+
+void ggml_metal_sllm_nodeprof_flush(void) {
+    if (!sllm_np_on()) {
+        return;
+    }
+    const int n = std::min(sllm_np_next.load(), ggml_metal_sllm_nodeprof_max_slots());
+    if (n == 0) {
+        return;
+    }
+    std::vector<uint64_t> ticks(2 * n);
+    const double ns = ggml_metal_sllm_nodeprof_resolve(n, ticks.data());
+    FILE * f = fopen(getenv("SLLM_METAL_NODEPROF"), "a");
+    if (f) {
+        for (int i = 0; i < n; ++i) {
+            fprintf(f, "{\"graph\":%ld,\"slot\":%d,\"t0_ns\":%.1f,\"t1_ns\":%.1f%s}\n", sllm_np_graph, i, ticks[2 * i] * ns,
+                    ticks[2 * i + 1] * ns, sllm_np_metas[i].line.c_str());
+        }
+        fclose(f);
+    }
+    sllm_np_graph++;
+    sllm_np_next.store(0);
+}
