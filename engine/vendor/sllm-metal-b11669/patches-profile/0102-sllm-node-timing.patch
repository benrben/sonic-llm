+// SLLM profiling (patches-profile/0102): per-encoder GPU timestamps
+#include <mach/mach_time.h>
+#define SLLM_NP_PER_BUF 2048
+#define SLLM_NP_NBUF    8
+static id<MTLCounterSampleBuffer> sllm_np_bufs[SLLM_NP_NBUF];
+static id<MTLDevice> sllm_np_dev = nil;
+static MTLTimestamp sllm_np_cpu0 = 0, sllm_np_gpu0 = 0;
+
+int ggml_metal_sllm_nodeprof_max_slots(void) {
+    return SLLM_NP_PER_BUF / 2 * SLLM_NP_NBUF;
+}
+
+static id<MTLCounterSampleBuffer> sllm_np_buf(id<MTLDevice> dev, int b) {
+    if (sllm_np_bufs[b]) {
+        return sllm_np_bufs[b];
+    }
+    @synchronized ([NSNull null]) {
+        if (sllm_np_bufs[b]) {
+            return sllm_np_bufs[b];
+        }
+        if (!sllm_np_dev) {
+            sllm_np_dev = [dev retain];
+            [dev sampleTimestamps:&sllm_np_cpu0 gpuTimestamp:&sllm_np_gpu0];
+            if (![dev supportsCounterSampling:MTLCounterSamplingPointAtStageBoundary]) {
+                GGML_ABORT("sllm nodeprof: no stage-boundary counter sampling on this device");
+            }
+        }
+        id<MTLCounterSet> ts = nil;
+        for (id<MTLCounterSet> cs in dev.counterSets) {
+            if ([cs.name isEqualToString:MTLCommonCounterSetTimestamp]) { ts = cs; }
+        }
+        if (!ts) {
+            GGML_ABORT("sllm nodeprof: no timestamp counter set");
+        }
+        MTLCounterSampleBufferDescriptor * d = [MTLCounterSampleBufferDescriptor new];
+        d.counterSet = ts;
+        d.storageMode = MTLStorageModeShared;
+        d.sampleCount = SLLM_NP_PER_BUF;
+        NSError * err = nil;
+        id<MTLCounterSampleBuffer> buf = [dev newCounterSampleBufferWithDescriptor:d error:&err];
+        [d release];
+        if (!buf) {
+            GGML_ABORT("sllm nodeprof: newCounterSampleBuffer failed: %s", err ? [[err localizedDescription] UTF8String] : "?");
+        }
+        sllm_np_bufs[b] = buf;
+    }
+    return sllm_np_bufs[b];
+}
+
+ggml_metal_encoder_t ggml_metal_encoder_init_sampled(ggml_metal_cmd_buf_t cmd_buf_raw, bool concurrent, int slot) {
+    ggml_metal_encoder_t res = calloc(1, sizeof(struct ggml_metal_encoder));
+    id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>) cmd_buf_raw;
+    const int b = slot / (SLLM_NP_PER_BUF / 2), s = slot % (SLLM_NP_PER_BUF / 2);
+    MTLComputePassDescriptor * pd = [MTLComputePassDescriptor computePassDescriptor];
+    pd.dispatchType = concurrent ? MTLDispatchTypeConcurrent : MTLDispatchTypeSerial;
+    pd.sampleBufferAttachments[0].sampleBuffer = sllm_np_buf(cmd_buf.device, b);
+    pd.sampleBufferAttachments[0].startOfEncoderSampleIndex = 2 * s;
+    pd.sampleBufferAttachments[0].endOfEncoderSampleIndex = 2 * s + 1;
+    res->obj = [cmd_buf computeCommandEncoderWithDescriptor:pd];
+    [res->obj retain];
+    return res;
+}
+
+double ggml_metal_sllm_nodeprof_resolve(int n_slots, uint64_t * ticks) {
+    if (!sllm_np_dev || n_slots <= 0) {
+        return 0.0;
+    }
+    const int per = SLLM_NP_PER_BUF / 2;
+    for (int b = 0; b * per < n_slots && b < SLLM_NP_NBUF; ++b) {
+        const int n = MIN(per, n_slots - b * per);
+        if (!sllm_np_bufs[b]) {
+            memset(ticks + 2 * b * per, 0, 2 * n * sizeof(uint64_t));
+            continue;
+        }
+        NSData * d = [sllm_np_bufs[b] resolveCounterRange:NSMakeRange(0, 2 * n)];
+        if (!d) {
+            memset(ticks + 2 * b * per, 0, 2 * n * sizeof(uint64_t));
+            continue;
+        }
+        memcpy(ticks + 2 * b * per, d.bytes, MIN(d.length, 2 * n * sizeof(uint64_t)));
+    }
+    // GPU ticks to ns: the CPU/GPU timestamp pairs at the first buffer and now (sampleTimestamps' CPU side is ns)
+    MTLTimestamp c1 = 0, g1 = 0;
+    [sllm_np_dev sampleTimestamps:&c1 gpuTimestamp:&g1];
+    if (g1 <= sllm_np_gpu0) {
+        return 1.0;
+    }
+    return (double) (c1 - sllm_np_cpu0) / (double) (g1 - sllm_np_gpu0);
+}
