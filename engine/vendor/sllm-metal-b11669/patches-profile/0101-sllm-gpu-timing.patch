+#include <mach/mach_time.h>
+
+// SLLM profiling (patches-profile/0101): the GPU time of the command buffers of each graph compute, read back on the
+// next synchronize. Times are seconds in the host timebase of MTLCommandBuffer.GPUStartTime (mach_absolute_time).
+// out[0] busy (sum of GPUEndTime - GPUStartTime), out[1] first GPUStartTime, out[2] last GPUEndTime, out[3] command
+// buffers counted, out[4] the host time now. The accumulators reset on every call.
+static double sllm_gpu_busy = 0.0, sllm_gpu_first = 0.0, sllm_gpu_last = 0.0, sllm_gpu_ncb = 0.0;
+static int sllm_gpu_pending = 0;
+static double sllm_host_now(void) {
+    static mach_timebase_info_data_t tb;
+    if (tb.denom == 0) { mach_timebase_info(&tb); }
+    return (double) mach_absolute_time() * tb.numer / tb.denom * 1e-9;
+}
+GGML_BACKEND_API void ggml_backend_metal_sllm_gpu_times(double * out) {
+    out[0] = sllm_gpu_busy; out[1] = sllm_gpu_first; out[2] = sllm_gpu_last; out[3] = sllm_gpu_ncb; out[4] = sllm_host_now();
+    sllm_gpu_busy = sllm_gpu_first = sllm_gpu_last = sllm_gpu_ncb = 0.0;
+}
 
