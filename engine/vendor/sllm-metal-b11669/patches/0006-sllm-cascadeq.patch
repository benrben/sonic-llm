+// ---------------------------------------------------------------------------------------------------------------
+// SLLM patch 6 (kvmixed): the suffix pass over q8_0 own pages. A mixed-precision decode group keeps the shared prefix
+// (and each agent's partly filled tail page) in the f16 K/V view of the op and its full own pages in q8_0 K/V views
+// (src[5] / src[6]); the mask covers [f16 view cells | q8_0 view cells]. ggml-metal-cascadeq.m runs the f16 part
+// through the cascade kernels above and this kernel over the q8_0 cells; the merge kernel combines both.
+//
+// kernel_sllm_cascade_suffixq8: one threadgroup per (KV head, agent), 4 simdgroups, over the agent's q8_0 block list
+// (from kernel_sllm_cascade_scan run on the q8_0 part of the mask with p0 = p1 = 0). The arithmetic is the f16 suffix
+// pass's (one lane per cell for Q.K over all G heads, simdgroup-wide V rows); only the loads differ. Strides in `a`:
+// nb11 / nb12 / nb21 / nb22 are the q8_0 views' cell and head strides (bytes), ne11 the q8_0 cells, mask points at the
+// first q8_0 column, and the partial goes to slot a.S. a.pad0 bit 0: the q8_0 keys hold H k, H the orthonormal
+// Sylvester-Hadamard matrix of size D (llama.cpp's attention rotation for quantised keys, D034); since
+// q . k = (H q) . (H k), the kernel rotates its queries. From the standalone spike bench/phase2-suffixq8/suffixq.metal.
+
+struct sllm_block_q8 { half d; int8_t qs[32]; };
+
+// 4 bytes at a 2-byte aligned address (q8_0 block payloads start at offset 2)
+static inline uint sllm_q8_ld4(device const uchar * p) {
+    device const ushort * u = (device const ushort *) p;
+    return (uint) u[0] | ((uint) u[1] << 16);
+}
+
+template <int D, int G, int NS>
+kernel void kernel_sllm_cascade_suffixq8(
+        constant sllm_cascade_args & a [[buffer(0)]],
+        device const char  * q     [[buffer(1)]],
+        device const char  * k     [[buffer(2)]],
+        device const char  * v     [[buffer(3)]],
+        device const char  * mask  [[buffer(4)]],
+        device       float * po    [[buffer(5)]],
+        device       float * pml   [[buffer(6)]],
+        device const int   * lists [[buffer(7)]],
+        device const int   * cnt   [[buffer(8)]],
+        threadgroup  float * shm   [[threadgroup(0)]],
+        uint   tgi [[threadgroup_position_in_grid]],
+        ushort tid [[thread_index_in_threadgroup]],
+        ushort sgi [[simdgroup_index_in_threadgroup]],
+        ushort tii [[thread_index_in_simdgroup]]) {
+    constexpr int DL = D / 32;
+    const int hk = tgi % a.HKV, n = tgi / a.HKV;
+    threadgroup float * sq = shm;                 // [G][D]
+    threadgroup float * sm = sq + G * D;          // [NS][G][2 + D]
+    for (int e = tid; e < G * D; e += NS * 32) {
+        const int g = e / D, d = e % D;
+        sq[e] = *((device const float *) (q + (uint64_t) n * a.nb01 + (uint64_t) (hk * G + g) * a.nb02) + d);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (a.pad0 & 1) {
+        // fast Walsh-Hadamard transform of each query row (Sylvester order), then the 1/sqrt(D) of the orthonormal H
+        for (int h = 1; h < D; h <<= 1) {
+            for (int e = tid; e < G * D / 2; e += NS * 32) {
+                const int g = e / (D / 2), t = e % (D / 2);
+                const int i = g * D + (t / h) * 2 * h + (t % h);
+                const float x = sq[i], y = sq[i + h];
+                sq[i] = x + y; sq[i + h] = x - y;
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+        const float rs = rsqrt((float) D);
+        for (int e = tid; e < G * D; e += NS * 32) sq[e] *= rs;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    threadgroup const float4 * q4 = (threadgroup const float4 *) sq;
+
+    float M[G], L[G], o[G][DL];
+    #pragma unroll
+    for (int g = 0; g < G; ++g) {
+        M[g] = SLLM_NEG; L[g] = 0.0f;
+        #pragma unroll
+        for (int i = 0; i < DL; ++i) o[g][i] = 0.0f;
+    }
+    device const half * mrow = (device const half *) (mask + (uint64_t) n * a.nb31);
+    device const int * lst = lists + (uint64_t) n * a.nblk;
+    const int nb = cnt[n];
+    device const char * kb = k + (uint64_t) hk * a.nb12;
+    device const char * vb = v + (uint64_t) hk * a.nb22;
+    const int d0 = tii * DL;                      // this lane's V dims (all inside one 32-value block)
+    for (int j = sgi; j < nb; j += NS) {
+        const int c0 = lst[j];
+        const int cell = c0 + tii;
+        const float mval = cell < a.ne11 ? (float) mrow[cell] : -INFINITY;
+        const bool fin = mval > -MAXHALF;
+        float x[G];
+        #pragma unroll
+        for (int g = 0; g < G; ++g) x[g] = -INFINITY;
+        if (fin) {
+            device const sllm_block_q8 * kr = (device const sllm_block_q8 *) (kb + (uint64_t) cell * a.nb11);
+            float acc[G];
+            #pragma unroll
+            for (int g = 0; g < G; ++g) acc[g] = 0.0f;
+            for (int b = 0; b < D / 32; ++b) {
+                device const uchar * qs = (device const uchar *) kr[b].qs;
+                float part[G];
+                #pragma unroll
+                for (int g = 0; g < G; ++g) part[g] = 0.0f;
+                #pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    const float4 kk = (float4) as_type<char4>(sllm_q8_ld4(qs + 4 * i));
+                    #pragma unroll
+                    for (int g = 0; g < G; ++g) part[g] += dot(kk, q4[g * (D / 4) + b * 8 + i]);
+                }
+                const float dk = (float) kr[b].d;
+                #pragma unroll
+                for (int g = 0; g < G; ++g) acc[g] += dk * part[g];
+            }
+            #pragma unroll
+            for (int g = 0; g < G; ++g) x[g] = acc[g] * a.scale + mval;
+        }
+        float p[G];
+        #pragma unroll
+        for (int g = 0; g < G; ++g) {
+            const float Mn = max(M[g], simd_max(x[g]));
+            const float ms = exp(M[g] - Mn);
+            p[g] = exp(x[g] - Mn);
+            L[g] = L[g] * ms + simd_sum(p[g]);
+            M[g] = Mn;
+            #pragma unroll
+            for (int i = 0; i < DL; ++i) o[g][i] *= ms;
+        }
+        const uint vis = (uint) ((simd_vote::vote_t) simd_ballot(fin));
+        for (int jj = 0; jj < 32; ++jj) {
+            if (!(vis & (1u << jj))) continue;
+            device const sllm_block_q8 * vr = (device const sllm_block_q8 *) (vb + (uint64_t) (c0 + jj) * a.nb21) + d0 / 32;
+            const float dv = (float) vr->d;
+            device const uchar * qs = (device const uchar *) vr->qs + d0 % 32;
+            float vv[DL];
+            #pragma unroll
+            for (int i = 0; i < DL; i += 4) {
+                const float4 t = (float4) as_type<char4>(sllm_q8_ld4(qs + i)) * dv;
+                vv[i] = t[0]; vv[i + 1] = t[1]; vv[i + 2] = t[2]; vv[i + 3] = t[3];
+            }
+            #pragma unroll
+            for (int g = 0; g < G; ++g) {
+                const float pj = simd_shuffle(p[g], jj);
+                #pragma unroll
+                for (int i = 0; i < DL; ++i) o[g][i] += pj * vv[i];
+            }
+        }
+    }
+    #pragma unroll
+    for (int g = 0; g < G; ++g) {
+        threadgroup float * e = sm + (sgi * G + g) * (2 + D);
+        if (tii == 0) { e[0] = M[g]; e[1] = L[g]; }
+        #pragma unroll
+        for (int i = 0; i < DL; ++i) e[2 + tii * DL + i] = o[g][i];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    // merge the NS simdgroup partials into slot S
+    for (int g = sgi; g < G; g += NS) {
+        const int r = n * G + g;
+        float Mm = SLLM_NEG, Lm = 0.0f, om[DL];
+        #pragma unroll
+        for (int i = 0; i < DL; ++i) om[i] = 0.0f;
+        for (int t = 0; t < NS; ++t) {
+            threadgroup const float * es = sm + (t * G + g) * (2 + D);
+            const float mt = es[0], lt = es[1];
+            if (!(lt > 0.0f)) continue;
+            const float Mn = max(Mm, mt);
+            const float e1 = exp(Mm - Mn), e2 = exp(mt - Mn);
+            #pragma unroll
+            for (int i = 0; i < DL; ++i) om[i] = om[i] * e1 + es[2 + tii * DL + i] * e2;
+            Lm = Lm * e1 + lt * e2;
+            Mm = Mn;
+        }
+        device float * pr = po + (((uint64_t) a.S * a.HKV + hk) * a.Rpad + r) * D + tii * DL;
+        #pragma unroll
+        for (int i = 0; i < DL; ++i) pr[i] = om[i];
+        if (tii == 0) {
+            device float * ml = pml + (((uint64_t) a.S * a.HKV + hk) * a.Rpad + r) * 2;
+            ml[0] = Mm; ml[1] = Lm;
+        }
+    }
+}
+
+#define SLLM_CASCADE_SUFFIXQ8(D, G) \
+    template [[host_name("kernel_sllm_cascade_suffixq8_d" #D "_g" #G)]] kernel void kernel_sllm_cascade_suffixq8<D, G, 4>( \
+        constant sllm_cascade_args &, device const char *, device const char *, device const char *, device const char *, \
+        device float *, device float *, device const int *, device const int *, threadgroup float *, uint, ushort, ushort, ushort);
+SLLM_CASCADE_SUFFIXQ8(128, 2) SLLM_CASCADE_SUFFIXQ8(128, 4) SLLM_CASCADE_SUFFIXQ8(256, 2) SLLM_CASCADE_SUFFIXQ8(256, 4)
+
