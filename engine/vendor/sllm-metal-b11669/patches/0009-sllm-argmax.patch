+
+// SLLM patch 9 (phase2-decodeprof): argmax over long rows with a full threadgroup per row (ggml-metal-argmax.m).
+// Result per row: the first index of the maximum, NaN ignored, -1 when no element is above -inf.
+
+// same layout as ggml_metal_kargs_sllm_argmax in ggml-metal-argmax.h
+typedef struct {
+    int32_t  ne00;
+    int32_t  pad;
+    uint64_t nb01;
+} ggml_metal_kargs_sllm_argmax;
+
+// (v, i) of a simdgroup's lanes -> the lane-uniform winner: the largest v, then the lowest valid index
+static inline void sllm_argmax_simd(thread float & v, thread int32_t & i) {
+    const float m = simd_max(v);
+    const int32_t c = (v == m && i >= 0) ? i : 0x7fffffff;
+    const int32_t r = simd_min(c);
+    v = m;
+    i = r == 0x7fffffff ? -1 : r;
+}
+
+kernel void kernel_sllm_argmax(
+        constant ggml_metal_kargs_sllm_argmax & a,
+        device const char * src,
+        device    int32_t * dst,
+        uint3  tg   [[threadgroup_position_in_grid]],
+        ushort tid  [[thread_index_in_threadgroup]],
+        ushort sg   [[simdgroup_index_in_threadgroup]],
+        ushort lane [[thread_index_in_simdgroup]],
+        uint3  ntg  [[threads_per_threadgroup]]) {
+    threadgroup float   sv[32];
+    threadgroup int32_t si[32];
+    const int32_t nth = (int32_t) ntg.x;
+    device const float  * x  = (device const float *) (src + (uint64_t) tg.x * a.nb01);
+    device const float4 * x4 = (device const float4 *) x;
+    const int32_t n4 = a.ne00 / 4;
+    float   v = -INFINITY;
+    int32_t i = -1;
+    // each thread keeps the first index of its own maximum: its elements in increasing order, strict > (NaN never
+    // wins, -inf never counts)
+    for (int32_t k = tid; k < n4; k += nth) {
+        const float4 y = x4[k];
+        if (y.x > v) { v = y.x; i = 4*k + 0; }
+        if (y.y > v) { v = y.y; i = 4*k + 1; }
+        if (y.z > v) { v = y.z; i = 4*k + 2; }
+        if (y.w > v) { v = y.w; i = 4*k + 3; }
+    }
+    for (int32_t k = 4*n4 + tid; k < a.ne00; k += nth) {
+        const float y = x[k];
+        if (y > v) { v = y; i = k; }
+    }
+    sllm_argmax_simd(v, i);
+    if (lane == 0) {
+        sv[sg] = v;
+        si[sg] = i;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sg == 0) {
+        const int32_t nsg = (nth + 31) / 32;
+        v = (int32_t) lane < nsg ? sv[lane] : -INFINITY;
+        i = (int32_t) lane < nsg ? si[lane] : -1;
+        sllm_argmax_simd(v, i);
+        if (lane == 0) {
+            dst[tg.x] = i;
+        }
+    }
+}
