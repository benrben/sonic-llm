@@ -0,0 +1,239 @@
+// SLLM patch 9 (decisions.md D042, phase2-decodeprof): dispatch, self-test and status of the two-pass argmax.
+//
+// Why: ggml's kernel_argmax_f32 runs one threadgroup per row with nth threads, and its rule (nth doubles from 32 while
+// nth * rows < 256) gives 64 threads per row at 32 rows. For the greedy sampling of a 32-row decode step over a
+// 151,936 / 262,208-token vocabulary that is 2,048 threads for 19 / 34 MB of logits: 1.3 ms (Qwen3-0.6B) and 3.6 ms
+// (Gemma-3-4B) per step, about 3% of the bandwidth (results/phase2-decodeprof).
+//
+// The SLLM path: the same one threadgroup per row, but 1,024 threads reading float4 (rows of at least 2,048 elements,
+// 16-byte aligned rows). No scratch: ggml-base allows no extra allocation for ARGMAX.
+//
+// Result: the FIRST index of the row's maximum, NaN ignored, -1 when no element is above -inf. That equals ggml's
+// result whenever the maximum is unique. On an exact tie ggml returns the index its thread layout happens to keep
+// (which depends on the row count); this path returns the lowest index (llama.cpp's CPU greedy sampler does too).
+//
+// Mode (env SLLM_ARGMAX, read once at device init): unset or "1" auto; "0" off (every ARGMAX on ggml, the A/B switch).
+
+#import "ggml-metal-argmax.h"
+
+#import "ggml-impl.h"
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+
+#include <math.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define SLLM_ARGMAX_MIN_NE00 2048
+#define SLLM_ARGMAX_NTHREADS 1024
+
+static struct {
+    bool initialized;
+    bool active;
+    bool off;
+    char reason[256];
+    bool selftest_ran;
+    bool selftest_pass;
+    int  selftest_cases;
+    double selftest_ms;
+    atomic_ullong dispatches;
+} g_am;
+
+static bool sllm_argmax_takes(const struct ggml_tensor * op) {
+    if (!g_am.active || op->op != GGML_OP_ARGMAX) {
+        return false;
+    }
+    const struct ggml_tensor * s = op->src[0];
+    return s->type == GGML_TYPE_F32 && op->type == GGML_TYPE_I32 && s->ne[0] >= SLLM_ARGMAX_MIN_NE00 &&
+        s->ne[0] <= INT32_MAX && s->ne[1] <= INT32_MAX && s->ne[2] == 1 && s->ne[3] == 1 && s->nb[0] == sizeof(float) &&
+        ggml_is_contiguous(op);
+}
+
+static struct ggml_metal_pipeline_with_params sllm_argmax_pipeline(ggml_metal_library_t lib, const char * base) {
+    struct ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, base);
+    if (!res.pipeline) {
+        res = ggml_metal_library_compile_pipeline(lib, base, base, NULL);
+    }
+    return res;
+}
+
+static bool sllm_argmax_encode_raw(ggml_metal_library_t lib, ggml_metal_encoder_t enc, int64_t ne00, int64_t nrows, uint64_t nb01,
+        struct ggml_metal_buffer_id src, struct ggml_metal_buffer_id dst) {
+    if (src.offs % 16 != 0 || nb01 % 16 != 0) {
+        return false;
+    }
+    struct ggml_metal_pipeline_with_params p = sllm_argmax_pipeline(lib, "kernel_sllm_argmax");
+    if (!p.pipeline) {
+        return false;
+    }
+    const int nth = MIN(SLLM_ARGMAX_NTHREADS, ggml_metal_pipeline_max_theads_per_threadgroup(p));
+    if (nth < 32 || nth % 32 != 0) {
+        return false;
+    }
+    ggml_metal_kargs_sllm_argmax args = { /*.ne00 =*/ (int32_t) ne00, /*.pad =*/ 0, /*.nb01 =*/ nb01 };
+    ggml_metal_encoder_set_pipeline(enc, p);
+    ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer  (enc, src, 1);
+    ggml_metal_encoder_set_buffer  (enc, dst, 2);
+    ggml_metal_encoder_dispatch_threadgroups(enc, (int) nrows, 1, 1, nth, 1, 1);
+    return true;
+}
+
+bool ggml_metal_sllm_argmax_encode(ggml_metal_library_t lib, ggml_metal_encoder_t enc, const struct ggml_tensor * op,
+        struct ggml_metal_buffer_id src, struct ggml_metal_buffer_id dst) {
+    if (!sllm_argmax_takes(op)) {
+        return false;
+    }
+    if (!sllm_argmax_encode_raw(lib, enc, op->src[0]->ne[0], op->src[0]->ne[1], op->src[0]->nb[1], src, dst)) {
+        return false;
+    }
+    atomic_fetch_add(&g_am.dispatches, 1);
+    return true;
+}
+
+//
+// self-test: against a CPU reference (first index of the maximum, NaN ignored, -1 when nothing is above -inf): rows
+// with and without a scalar tail, padded row strides, a planted tie, a row of -inf, NaNs, the maximum in the last
+// element (the tail) and at the front
+//
+
+static int sllm_argmax_ref(const float * x, int64_t n) {
+    float best = -INFINITY;
+    int arg = -1;
+    for (int64_t i = 0; i < n; ++i) {
+        if (x[i] > best) {
+            best = x[i];
+            arg = (int) i;
+        }
+    }
+    return arg;
+}
+
+static bool sllm_argmax_selftest(ggml_metal_device_t dev, ggml_metal_library_t lib, char * why, size_t why_n) {
+    const int64_t shapes[2][2] = { { 50004, 6 }, { 20002, 64 } }; // no scalar tail; a 2-element tail
+    id<MTLDevice> device = (id<MTLDevice>) ggml_metal_device_get_obj(dev);
+    if (!device) {
+        snprintf(why, why_n, "no MTLDevice");
+        return false;
+    }
+    bool ok = true;
+    int cases = 0;
+    uint64_t s = 0x5EEDA11ull;
+    @autoreleasepool {
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        if (!queue) {
+            snprintf(why, why_n, "newCommandQueue failed");
+            return false;
+        }
+        for (int si = 0; si < 2 && ok; ++si) {
+            const int64_t ne00 = shapes[si][0], nrows = shapes[si][1], ld = (ne00 + 3) & ~3; // 16-byte row stride
+            const size_t dbytes = (size_t) nrows*sizeof(int32_t);
+            id<MTLBuffer> bx = [device newBufferWithLength:(size_t) (ld*nrows)*sizeof(float) options:MTLResourceStorageModeShared];
+            id<MTLBuffer> bd = [device newBufferWithLength:dbytes options:MTLResourceStorageModeShared];
+            if (!bx || !bd) {
+                snprintf(why, why_n, "buffer allocation failed");
+                ok = false;
+            } else {
+                float * x = (float *) [bx contents];
+                for (int64_t i = 0; i < ld*nrows; ++i) {
+                    s ^= s << 13; s ^= s >> 7; s ^= s << 17;
+                    x[i] = (float) ((s >> 40) % 2000000) / 1000.0f - 1000.0f;
+                }
+                float * r;
+                r = x + 1*ld; r[7001] = 5000.0f; r[ne00 - 3] = 5000.0f;                     // tie: the lower index
+                r = x + 2*ld; for (int64_t i = 0; i < ne00; ++i) r[i] = -INFINITY;         // none above -inf: -1
+                r = x + 3*ld; for (int64_t i = 0; i < ne00; i += 7) r[i] = NAN; r[12345] = 4000.0f; // NaNs ignored
+                r = x + 4*ld; r[ne00 - 1] = 6000.0f;                                       // the last element
+                r = x + 5*ld; r[0] = 7000.0f; r[1] = 7000.0f;                              // tie at the front
+                memset([bd contents], 0xAB, dbytes);
+
+                id<MTLCommandBuffer> cb = [queue commandBuffer];
+                ggml_metal_encoder_t enc = ggml_metal_encoder_init((ggml_metal_cmd_buf_t) cb, false);
+                const struct ggml_metal_buffer_id ix = { (void *) bx, 0 }, idd = { (void *) bd, 0 };
+                const bool enc_ok = sllm_argmax_encode_raw(lib, enc, ne00, nrows, (uint64_t) ld*sizeof(float), ix, idd);
+                ggml_metal_encoder_end_encoding(enc);
+                ggml_metal_encoder_free(enc);
+                if (!enc_ok) {
+                    snprintf(why, why_n, "argmax pipelines not available");
+                    ok = false;
+                } else {
+                    [cb commit];
+                    [cb waitUntilCompleted];
+                    if ([cb status] != MTLCommandBufferStatusCompleted) {
+                        snprintf(why, why_n, "command buffer failed: %s", [[[cb error] description] UTF8String]);
+                        ok = false;
+                    }
+                }
+                const int32_t * d = (const int32_t *) [bd contents];
+                for (int64_t row = 0; row < nrows && ok; ++row) {
+                    const int want = sllm_argmax_ref(x + row*ld, ne00);
+                    ++cases;
+                    if (d[row] != want) {
+                        snprintf(why, why_n, "mismatch ne00=%lld rows=%lld row %lld: got %d, want %d", (long long) ne00,
+                                (long long) nrows, (long long) row, d[row], want);
+                        ok = false;
+                    }
+                }
+            }
+            [bx release];
+            [bd release];
+        }
+        [queue release];
+    }
+    g_am.selftest_cases = cases;
+    return ok;
+}
+
+void ggml_metal_sllm_argmax_device_init(ggml_metal_device_t dev, ggml_metal_library_t lib) {
+    if (g_am.initialized) {
+        return;
+    }
+    g_am.initialized = true;
+    g_am.active = false;
+    atomic_store(&g_am.dispatches, 0);
+    const char * env = getenv("SLLM_ARGMAX");
+    g_am.off = env && strcmp(env, "0") == 0;
+    if (g_am.off) {
+        snprintf(g_am.reason, sizeof(g_am.reason), "disabled by SLLM_ARGMAX=0");
+    } else if (!lib) {
+        snprintf(g_am.reason, sizeof(g_am.reason), "no Metal library");
+    } else {
+        char why[200] = "";
+        const int64_t t0 = ggml_time_us();
+        g_am.selftest_ran = true;
+        g_am.selftest_pass = sllm_argmax_selftest(dev, lib, why, sizeof(why));
+        g_am.selftest_ms = (ggml_time_us() - t0)/1e3;
+        g_am.active = g_am.selftest_pass;
+        snprintf(g_am.reason, sizeof(g_am.reason), "%s%s", g_am.selftest_pass ? "self-test passed" : "self-test failed: ",
+                g_am.selftest_pass ? "" : why);
+    }
+    if (g_am.active) {
+        GGML_LOG_INFO("%s: SLLM argmax active (self-test %d rows, %.1f ms)\n", __func__, g_am.selftest_cases, g_am.selftest_ms);
+    } else if (g_am.off) {
+        GGML_LOG_INFO("%s: SLLM argmax off (%s)\n", __func__, g_am.reason);
+    } else {
+        GGML_LOG_WARN("%s: SLLM argmax disabled, using ggml's kernel: %s\n", __func__, g_am.reason);
+    }
+}
+
+const char * ggml_backend_metal_sllm_argmax_status(void) {
+    static _Thread_local char buf[512];
+    char reason[300];
+    size_t j = 0;
+    for (size_t i = 0; g_am.reason[i] && j + 2 < sizeof(reason); ++i) {
+        const char c = g_am.reason[i];
+        if (c == '"' || c == '\\') reason[j++] = '\\';
+        reason[j++] = (c == '\n' || c == '\r' || c == '\t') ? ' ' : c;
+    }
+    reason[j] = 0;
+    snprintf(buf, sizeof(buf),
+        "{\"patch\":\"sllm-argmax-1\",\"initialized\":%s,\"active\":%s,\"mode\":\"%s\",\"reason\":\"%s\","
+        "\"selftest\":{\"ran\":%s,\"pass\":%s,\"rows\":%d,\"ms\":%.2f},\"min_ne00\":%d,\"dispatches\":%llu}",
+        g_am.initialized ? "true" : "false", g_am.active ? "true" : "false", g_am.off ? "off" : "auto", reason,
+        g_am.selftest_ran ? "true" : "false", g_am.selftest_pass ? "true" : "false", g_am.selftest_cases, g_am.selftest_ms,
+        SLLM_ARGMAX_MIN_NE00, (unsigned long long) atomic_load(&g_am.dispatches));
+    return buf;
+}
