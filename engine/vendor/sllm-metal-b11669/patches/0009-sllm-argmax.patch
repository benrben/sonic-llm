+// SLLM patch 9 (decisions.md D042, phase2-decodeprof): argmax over long rows with a full threadgroup per row
+// (kernels/qmm.metal, kernel_sllm_argmax), for greedy sampling of many rows at once.
+#pragma once
+
+#include "ggml.h"
+#include "ggml-metal-device.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// kernel arguments; the same layout is declared in kernels/qmm.metal
+typedef struct {
+    int32_t  ne00; // row length
+    int32_t  pad;
+    uint64_t nb01; // bytes per src row
+} ggml_metal_kargs_sllm_argmax;
+
+// encode the op when the SLLM path takes it; false (nothing encoded) means ggml's kernel runs it
+bool ggml_metal_sllm_argmax_encode(ggml_metal_library_t lib, ggml_metal_encoder_t enc, const struct ggml_tensor * op,
+        struct ggml_metal_buffer_id src, struct ggml_metal_buffer_id dst);
+
+// called once by ggml_metal_device_init after the library is built: reads SLLM_ARGMAX, runs the self-test
+void ggml_metal_sllm_argmax_device_init(ggml_metal_device_t dev, ggml_metal_library_t lib);
+
+// exported: a JSON object describing the patch, the mode, the self-test and the dispatch count (thread-local buffer)
+const char * ggml_backend_metal_sllm_argmax_status(void);
+
+#ifdef __cplusplus
+}
