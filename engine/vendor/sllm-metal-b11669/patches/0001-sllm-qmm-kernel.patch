SLLM patch 1/2 (D042): the qmm kernel (kernels/qmm.metal) and its dispatch/self-test/status unit (ggml-metal-qmm.{h,m}). New files only.
Against llama.cpp b11669 (source tarball 620d222), applied with patch -p1 in ggml/.

--- a/src/ggml-metal/kernels/qmm.metal
+++ b/src/ggml-metal/kernels/qmm.metal
@@ -0,0 +1,217 @@
+// SLLM patch (decisions.md D042): batched quantized matmul for 9..128 token rows on the Metal 4 tensor API.
+//
+//   dst[n][m] = sum_k src0[m][k] * src1[n][k]     src0: Q4_0 / Q4_1 / Q6_K rows (ggml block layout), src1: f32, dst: f32
+//
+// The kernel of the phase 2 qmm spike (sllm/bench/phase2-qmm/qmm.metal, kernel_qmm2 with T = 1), unchanged in its math:
+// - one threadgroup = NSG simdgroups x SN weight rows (TM = 64 rows) x NT token rows (16 up to 16 tokens, else 32);
+// - each simdgroup dequantizes its weight rows straight into the right-input cooperative tensor of a single-simdgroup
+//   matmul2d (registers; the weights never go through threadgroup memory);
+// - the activations are read from device memory as the left operand (rounded to half inside matmul2d, relaxed
+//   precision, the same as ggml's tensor-API mul_mm);
+// - Q4_0 / Q4_1 load the next K chunk's weight bytes while the current chunk multiplies; Q6_K does not;
+// - optional split-K over grid z: slice s writes its partial sums at dst + s*N*ldd, kernel_sllm_qmm_reduce adds
+//   them into slice 0 (= dst) in place.
+//
+// The register layout of the right-input cooperative tensor is not documented. It was probed on the M5
+// (sllm/bench/phase2-qmm/dev/probe.metal): the SN x KC tile is split into 16x16 sub-tiles, n-sub-tile fastest; in each,
+// a lane holds rows nb..nb+3 at columns kb and kb+8. ggml-metal-qmm.m runs a self-test against a CPU reference at
+// device init and disables this path if the result does not match.
+
+#include "common.h"
+
+#if defined(GGML_METAL_HAS_TENSOR)
+
+using namespace mpp::tensor_ops;
+
+// same layout as ggml_metal_kargs_sllm_qmm in ggml-metal-qmm.h
+typedef struct {
+    int32_t K;
+    int32_t M;
+    int32_t N;
+    int32_t nb01;
+    int32_t ldx;
+    int32_t ldd;
+    int32_t ksplit;
+    int32_t pad;
+} ggml_metal_kargs_sllm_qmm;
+
+#define SLLM_QMM_TM  64
+#define SLLM_QMM_KC  32
+#define SLLM_QMM_NSG 2
+
+struct sllm_block_q4_0 { half d; uint8_t qs[16]; };
+struct sllm_block_q4_1 { half d; half m; uint8_t qs[16]; };
+struct sllm_block_q6_K { uint8_t ql[128]; uint8_t qh[64]; int8_t scales[16]; half d; };
+
+// four weights of one row at kk + t + {0, 8, 16, 24} (kk % 32 == 0, t in 0..7)
+static inline void sllm_deq4(device const sllm_block_q6_K * row, int kk, int t, thread half4 & w) {
+    device const sllm_block_q6_K & b = row[kk / 256];
+    const int l0 = kk % 256, h = l0 / 128, g = (l0 % 128) / 32;
+    device const uchar * ql = b.ql + 64*h + 32*(g & 1) + t;
+    device const uchar * qh = b.qh + 32*h + t;
+    const ushort shl = (g >= 2) ? 4 : 0, shh = 2*g;
+    const ushort4 lo = (ushort4(ql[0], ql[8], ql[16], ql[24]) >> shl) & 0xF;
+    const ushort4 hi = (ushort4(qh[0], qh[8], qh[16], qh[24]) >> shh) & 3;
+    const half4 q = half4(short4(lo | (hi << 4)) - 32);
+    const float d = b.d;
+    const half s0 = (half) (d * b.scales[8*h + 2*g]), s1 = (half) (d * b.scales[8*h + 2*g + 1]);
+    w = q * half4(s0, s0, s1, s1);
+}
+static inline void sllm_deq4(device const sllm_block_q4_0 * row, int kk, int t, thread half4 & w) {
+    device const sllm_block_q4_0 & b = row[kk / 32];
+    const ushort q0 = b.qs[t], q1 = b.qs[t + 8];
+    w = (half4(ushort4(q0 & 0xF, q1 & 0xF, q0 >> 4, q1 >> 4)) - 8.h) * b.d;
+}
+static inline void sllm_deq4(device const sllm_block_q4_1 * row, int kk, int t, thread half4 & w) {
+    device const sllm_block_q4_1 & b = row[kk / 32];
+    const ushort q0 = b.qs[t], q1 = b.qs[t + 8];
+    w = half4(ushort4(q0 & 0xF, q1 & 0xF, q0 >> 4, q1 >> 4)) * b.d + b.m;
+}
+
+// split dequant for software pipelining: ld4 issues the loads (next K chunk, before the matmul of the current one),
+// cv4 turns the raw values into four halfs (after the matmul)
+struct sllm_raw_q4_0 { half d; ushort q0, q1; };
+struct sllm_raw_q4_1 { half d, m; ushort q0, q1; };
+template <typename BQ> struct sllm_raw_of { typedef sllm_raw_q4_0 type; };
+template <> struct sllm_raw_of<sllm_block_q4_1> { typedef sllm_raw_q4_1 type; };
+
+static inline void sllm_ld4(device const sllm_block_q4_0 * row, int kk, int t, thread sllm_raw_q4_0 & r) {
+    device const sllm_block_q4_0 & b = row[kk / 32]; r.d = b.d; r.q0 = b.qs[t]; r.q1 = b.qs[t + 8];
+}
+static inline void sllm_cv4(thread const sllm_raw_q4_0 & r, thread half4 & w) {
+    w = (half4(ushort4(r.q0 & 0xF, r.q1 & 0xF, r.q0 >> 4, r.q1 >> 4)) - 8.h) * r.d;
+}
+static inline void sllm_ld4(device const sllm_block_q4_1 * row, int kk, int t, thread sllm_raw_q4_1 & r) {
+    device const sllm_block_q4_1 & b = row[kk / 32]; r.d = b.d; r.m = b.m; r.q0 = b.qs[t]; r.q1 = b.qs[t + 8];
+}
+static inline void sllm_cv4(thread const sllm_raw_q4_1 & r, thread half4 & w) {
+    w = half4(ushort4(r.q0 & 0xF, r.q1 & 0xF, r.q0 >> 4, r.q1 >> 4)) * r.d + r.m;
+}
+// Q6_K never takes the prefetch path; these keep the template well formed
+static inline void sllm_ld4(device const sllm_block_q6_K *, int, int, thread sllm_raw_q4_0 &) {}
+
+template <typename BQ, int NT>
+kernel void kernel_sllm_qmm(
+        constant ggml_metal_kargs_sllm_qmm & a,
+        device const char  * W,
+        device const float * X,
+        device       float * D,
+        uint3  tg   [[threadgroup_position_in_grid]],
+        ushort sg   [[simdgroup_index_in_threadgroup]]) {
+    constexpr int TM  = SLLM_QMM_TM;
+    constexpr int KC  = SLLM_QMM_KC;
+    constexpr int SN  = TM / SLLM_QMM_NSG;
+    const int n0 = tg.x * NT;
+    const int r0 = tg.y * TM + sg * SN;
+    const int kb = tg.z * a.ksplit;
+    const int ke = min(a.K, kb + a.ksplit);
+
+    constexpr auto desc = matmul2d_descriptor(NT, SN, KC, false, false, true,
+                                              matmul2d_descriptor::mode::multiply_accumulate);
+    matmul2d<desc, execution_simdgroup> mm;
+
+    device const float * xb = X + (uint64_t) n0 * a.ldx;
+    const int nrem = clamp(a.N - n0, 0, NT);
+    auto tX0 = tensor((device float *) xb, dextents<int32_t, 2>(KC, NT), array<int, 2>({1, a.ldx}));
+    auto wR = mm.template get_right_input_cooperative_tensor<float, half, float>();
+    auto cT = mm.template get_destination_cooperative_tensor<decltype(tX0), decltype(wR), float>();
+    #pragma unroll
+    for (uint16_t i = 0; i < cT.get_capacity(); ++i) {
+        if (cT.is_valid_element(i)) cT[i] = 0.0f;
+    }
+
+    // element i = 8*sub + 4*e + j of wR  ->  (n = nb + 16*nsub + j, k = kb + 8*e + 16*ksub); nb, kb from element 0
+    constexpr int NSUB = SN / 16;
+    const auto ix0 = wR.get_multidimensional_index((uint16_t) 0);
+    const int nb = ix0[0], kbl = ix0[1];
+
+    constexpr bool PF = !is_same<BQ, sllm_block_q6_K>::value;
+    typedef typename sllm_raw_of<BQ>::type RAW;
+    constexpr int NRAW = NSUB * 4 * (KC / 32);
+    RAW raw[NRAW];
+    device const BQ * rps[NSUB * 4];
+    #pragma unroll
+    for (int nsub = 0; nsub < NSUB; ++nsub) {
+        #pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            const int gr = min(r0 + nb + 16*nsub + j, a.M - 1);
+            rps[4*nsub + j] = (device const BQ *) (W + (uint64_t) gr * a.nb01);
+        }
+    }
+    #define SLLM_LOAD_RAW(kk) _Pragma("unroll") for (int q = 0; q < NSUB * 4; ++q) { \
+        _Pragma("unroll") for (int c = 0; c < KC / 32; ++c) sllm_ld4(rps[q], (kk) + 32*c, kbl, raw[q * (KC/32) + c]); }
+
+    if (PF) { SLLM_LOAD_RAW(kb) }
+    for (int k0 = kb; k0 < ke; k0 += KC) {
+        if (PF) {
+            #pragma unroll
+            for (int nsub = 0; nsub < NSUB; ++nsub) {
+                #pragma unroll
+                for (int j = 0; j < 4; ++j) {
+                    #pragma unroll
+                    for (int c = 0; c < KC / 32; ++c) {
+                        half4 w4;
+                        sllm_cv4(raw[(4*nsub + j) * (KC/32) + c], w4);
+                        wR[8*(nsub + NSUB*(2*c + 0)) + 0 + j] = w4[0];
+                        wR[8*(nsub + NSUB*(2*c + 0)) + 4 + j] = w4[1];
+                        wR[8*(nsub + NSUB*(2*c + 1)) + 0 + j] = w4[2];
+                        wR[8*(nsub + NSUB*(2*c + 1)) + 4 + j] = w4[3];
+                    }
+                }
+            }
+            if (k0 + KC < ke) { SLLM_LOAD_RAW(k0 + KC) }   // next chunk's loads are in flight during this matmul
+        } else {
+            #pragma unroll
+            for (int nsub = 0; nsub < NSUB; ++nsub) {
+                #pragma unroll
+                for (int j = 0; j < 4; ++j) {
+                    device const BQ * rp = rps[4*nsub + j];
+                    #pragma unroll
+                    for (int c = 0; c < KC / 32; ++c) {
+                        half4 w4;   // weights at k0 + 32c + kbl + {0, 8, 16, 24}
+                        sllm_deq4(rp, k0 + 32*c, kbl, w4);
+                        wR[8*(nsub + NSUB*(2*c + 0)) + 0 + j] = w4[0];
+                        wR[8*(nsub + NSUB*(2*c + 0)) + 4 + j] = w4[1];
+                        wR[8*(nsub + NSUB*(2*c + 1)) + 0 + j] = w4[2];
+                        wR[8*(nsub + NSUB*(2*c + 1)) + 4 + j] = w4[3];
+                    }
+                }
+            }
+        }
+        if (nrem > 0) {
+            auto tX = tensor((device float *) xb + k0, dextents<int32_t, 2>(KC, nrem), array<int, 2>({1, a.ldx}));
+            mm.run(tX, wR, cT);
+        }
+    }
+    #undef SLLM_LOAD_RAW
+
+    if (r0 >= a.M || nrem <= 0) return;
+    const int mrem = min(SN, a.M - r0);
+    device float * dt = D + (uint64_t) tg.z * a.N * a.ldd + (uint64_t) n0 * a.ldd + r0;
+    auto tD = tensor(dt, dextents<int32_t, 2>(mrem, nrem), array<int, 2>({1, a.ldd}));
+    cT.store(tD);
+}
+
+// sum the split-K partials in place: D[i] += sum_{s >= 1} D[s*N*ldd + i]   (N*ldd % 4 == 0, checked on the host)
+kernel void kernel_sllm_qmm_reduce(
+        constant ggml_metal_kargs_sllm_qmm & a,
+        device float * D,
+        uint gid [[thread_position_in_grid]]) {
+    const int S = (a.K + a.ksplit - 1) / a.ksplit;
+    const uint64_t total = (uint64_t) a.N * a.ldd;
+    if ((uint64_t) gid * 4 >= total) return;
+    device float4 * d4 = (device float4 *) D;
+    float4 acc = d4[gid];
+    for (int s = 1; s < S; ++s) acc += ((device const float4 *) (D + (uint64_t) s * total))[gid];
+    d4[gid] = acc;
+}
+
+#define SLLM_QMM_INST(BQ, NT) \
+    template [[host_name("kernel_sllm_qmm_" #BQ "_nt" #NT)]] kernel void kernel_sllm_qmm<sllm_block_##BQ, NT>( \
+        constant ggml_metal_kargs_sllm_qmm &, device const char *, device const float *, device float *, uint3, ushort);
+
+SLLM_QMM_INST(q4_0, 16) SLLM_QMM_INST(q4_0, 32)
+SLLM_QMM_INST(q4_1, 16) SLLM_QMM_INST(q4_1, 32)
+SLLM_QMM_INST(q6_K, 16) SLLM_QMM_INST(q6_K, 32)
+
+#endif // GGML_METAL_HAS_TENSOR
--- a/src/ggml-metal/ggml-metal-qmm.h
+++ b/src/ggml-metal/ggml-metal-qmm.h
@@ -0,0 +1,58 @@
+// SLLM patch (decisions.md D042): dispatch, self-test and status of the batched quantized matmul (kernels/qmm.metal).
+#pragma once
+
+#include "ggml.h"
+#include "ggml-metal-device.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// kernel arguments; the same layout is declared in kernels/qmm.metal (kept out of ggml-metal-impl.h so that the
+// embedded sources of every official kernel stay byte-identical to b11669)
+typedef struct {
+    int32_t K;      // reduction length (ne00)
+    int32_t M;      // weight rows (ne01)
+    int32_t N;      // src1 rows (ne11*ne12*ne13)
+    int32_t nb01;   // bytes per weight row
+    int32_t ldx;    // floats per src1 row
+    int32_t ldd;    // floats per dst row
+    int32_t ksplit; // K length of one split-K slice (grid z)
+    int32_t pad;
+} ggml_metal_kargs_sllm_qmm;
+
+
+struct ggml_metal_sllm_qmm_plan {
+    enum ggml_type type; // GGML_TYPE_Q4_0, GGML_TYPE_Q4_1 or GGML_TYPE_Q6_K
+    int nt;              // token rows per threadgroup: 16 or 32
+    int S;               // split-K slices (1 = none); slices 1..S-1 live in the extra space after dst
+    ggml_metal_kargs_sllm_qmm args;
+};
+
+// true when the qmm path takes this MUL_MAT (enabled, supported layout, and (type, N) in the dispatch table);
+// a pure function of the tensor shapes and the process-wide state fixed at device init
+bool ggml_metal_sllm_qmm_plan_op(const struct ggml_tensor * op, struct ggml_metal_sllm_qmm_plan * plan);
+
+// bytes of split-K scratch the dst of this MUL_MAT needs beyond ggml_nbytes (0 when qmm does not take it)
+size_t ggml_metal_sllm_qmm_extra(const struct ggml_tensor * op);
+
+// encode the plan; false (nothing encoded) when a pipeline is missing or a buffer is misaligned
+bool ggml_metal_sllm_qmm_encode(ggml_metal_library_t lib, ggml_metal_encoder_t enc, const struct ggml_metal_sllm_qmm_plan * plan,
+        struct ggml_metal_buffer_id w, struct ggml_metal_buffer_id x, struct ggml_metal_buffer_id d);
+
+// called once by ggml_metal_device_init after the library is built: reads SLLM_QMM, runs the self-test
+void ggml_metal_sllm_qmm_device_init(ggml_metal_device_t dev, ggml_metal_library_t lib, bool has_tensor);
+
+// called by the library compile when kernels/qmm.metal fails to build (the rest of the library is unaffected)
+void ggml_metal_sllm_qmm_note_compile_failure(const char * msg);
+
+// exported: a JSON object describing the patch, the mode, the self-test and the dispatch count (thread-local buffer)
+const char * ggml_backend_metal_sllm_qmm_status(void);
+
+#ifdef __cplusplus
+}
+#endif
