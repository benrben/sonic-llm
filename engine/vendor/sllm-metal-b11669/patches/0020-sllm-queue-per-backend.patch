SLLM patch 0020 (phase 3 helper lane, opt-in): SLLM_METAL_QUEUE_PER_BACKEND=1 gives every Metal backend a command queue of
its own instead of the device queue shared by all backends of the process (llama.cpp TAG_QUEUE_PER_BACKEND, left
commented out upstream). Graphs, async copies and events of a backend go to its queue, so the brain and the helper
submit to two queues. Unset: byte-for-byte the same behaviour (the shared queue). Against llama.cpp b11669 (620d222)
after patches 0001-0013, applied with patch -p1 in ggml/.

--- a/src/ggml-metal/ggml-metal-context.m
+++ b/src/ggml-metal/ggml-metal-context.m
@@ -30,6 +30,12 @@
     ggml_metal_device_t  dev;
     ggml_metal_library_t lib;
 
+    // SLLM patch 0020: the queue this backend's graphs, async copies and events go to. The device's shared queue by
+    // default; with SLLM_METAL_QUEUE_PER_BACKEND=1 a queue of its own (owned), so two backends of one process (the
+    // brain's and the helper's) submit to two queues and the GPU can run their command buffers side by side.
+    id<MTLCommandQueue> queue;
+    bool own_queue;
+
     ggml_metal_event_t ev_cpy;  // for async copies
     ggml_metal_event_t ev_sync; // destination completion signal
 
@@ -113,11 +119,20 @@
         //       the graph encoders and async ops would use the backend queue while the sync ops would use the device queue?
         //res->queue = [device newCommandQueue]; [TAG_QUEUE_PER_BACKEND]
         id<MTLCommandQueue> queue = ggml_metal_device_get_queue(dev);
+        {
+            const char * qpb = getenv("SLLM_METAL_QUEUE_PER_BACKEND");
+            if (qpb && atoi(qpb) != 0) {
+                queue = [device newCommandQueue];
+                res->own_queue = true;
+                GGML_LOG_INFO("%s: SLLM: command queue per backend\n", __func__);
+            }
+        }
         if (queue == nil) {
             GGML_LOG_ERROR("%s: error: failed to create command queue\n", __func__);
             free(res);
             return NULL;
         }
+        res->queue = queue;
 
         res->dev = dev;
         res->lib = ggml_metal_device_get_library(dev);
@@ -245,6 +260,9 @@
     Block_release(ctx->encode_async);
 
     //[ctx->queue release]; // [TAG_QUEUE_PER_BACKEND]
+    if (ctx->own_queue) {
+        [ctx->queue release];
+    }
 
     dispatch_release(ctx->d_queue);
 
