SLLM patch 3/4 (D042): the shared-prefix decode attention kernel (cascade): new files only.
Against llama.cpp b11669 (source tarball 620d222) after patches 1-2, applied with patch -p1 in ggml/.

--- a/src/ggml-metal/kernels/cascade.metal
+++ b/src/ggml-metal/kernels/cascade.metal
@@ -0,0 +1,498 @@
+// SLLM patch (decisions.md D042, after D048 qmm): shared-prefix decode attention ("cascade") on the Metal 4 tensor API.
+//
+// Takes a GGML_OP_FLASH_ATTN_EXT of a decode group whose K/V view holds a prefix range [p0, p1) that every query row
+// may attend (the shared prefix pages; sllm-core names it in op_params[13..15], see ggml-metal-cascade.h). Inputs are
+// the op's own: q f32 [D, ne01, H], K/V f16 views [D, ne11, HKV] (any cell/head strides), the f16 mask [ne11, >= ne01]
+// added to the scaled scores, dst f32 [D, H, ne01]. The result is the exact softmax over every row's finite mask
+// entries, whatever the range: it only decides which pass reads which cell.
+//
+//   kernel_sllm_cascade_scan   per agent row: the list of 32-cell blocks outside [p0, p1) with a finite mask entry,
+//                              and Q as half [HKV][Rpad][D] (row r = agent * G + g)
+//   kernel_sllm_cascade_fused  one dispatch: HKV * S * row_tiles prefix threadgroups (every row of a KV-head group
+//                              against 1/S of [p0, p1), Q K^T and P V on matmul2d, online softmax, hidden blocks
+//                              skipped) followed by HKV * ne01 suffix threadgroups (one per KV head and agent: the
+//                              agent's own blocks, all G heads per K row read); each writes unnormalised (O, max, sum)
+//   kernel_sllm_cascade_merge  the exact log-sum-exp merge of the S + 1 partials, normalised, into dst
+//
+// From the standalone spike sllm/bench/phase2-cascade/cascade_tc.metal (the math is unchanged). The cooperative
+// destination tensor's element -> (column, row) map comes from get_multidimensional_index; ggml-metal-cascade.m runs
+// a self-test against a CPU reference at device init and disables this path on a mismatch.
+
+#include "common.h"
+
+#if defined(GGML_METAL_HAS_TENSOR)
+
+using namespace mpp::tensor_ops;
+
+// same layout as ggml_metal_kargs_sllm_cascade in ggml-metal-cascade.h
+typedef struct {
+    int32_t ne01;    // agents (query rows)
+    int32_t H;       // query heads
+    int32_t HKV;     // KV heads
+    int32_t G;       // H / HKV
+    int32_t R;       // ne01 * G rows per KV head
+    int32_t Rpad;    // R padded to the prefix row tile
+    int32_t ne11;    // cells of the K/V view
+    int32_t p0;      // prefix range [p0, p1) of the view (multiples of 32)
+    int32_t p1;
+    int32_t chunk;   // prefix cells per split (multiple of the prefix block)
+    int32_t S;       // prefix splits
+    int32_t nblk;    // capacity of a row's block list
+    uint64_t nb01;   // q: row (agent) stride, bytes
+    uint64_t nb02;   // q: head stride
+    uint64_t nb11;   // k: cell stride
+    uint64_t nb12;   // k: head stride
+    uint64_t nb21;   // v: cell stride
+    uint64_t nb22;   // v: head stride
+    uint64_t nb31;   // mask: row stride
+    float scale;
+    int32_t pad0;
+} sllm_cascade_args;
+
+#define SLLM_CASCADE_B 32          // cells per suffix block
+#define SLLM_NEG (-FLT_MAX/2)
+
+// ---------------------------------------------------------------------------------------------------------------
+// scan: block lists and the half Q scratch. 256 threads per agent row.
+kernel void kernel_sllm_cascade_scan(
+        constant sllm_cascade_args & a [[buffer(0)]],
+        device const char  * q     [[buffer(1)]],
+        device const char  * mask  [[buffer(2)]],
+        device       half  * qh    [[buffer(3)]],   // [HKV][Rpad][D]
+        device       int   * lists [[buffer(4)]],   // [ne01][nblk] block start cells
+        device       int   * cnt   [[buffer(5)]],   // [ne01]
+        constant     int   & D     [[buffer(6)]],
+        threadgroup  int   * sh    [[threadgroup(0)]],
+        uint   tg  [[threadgroup_position_in_grid]],
+        ushort tid [[thread_index_in_threadgroup]],
+        ushort sgi [[simdgroup_index_in_threadgroup]],
+        ushort tii [[thread_index_in_simdgroup]]) {
+    const int n = tg;
+    // Q -> scaled half as in ggml tensor attention, rows n*G .. n*G + G - 1 (zero padding)
+    for (int e = tid; e < a.H * D; e += 256) {
+        const int h = e / D, d = e % D;
+        const int hk = h / a.G, g = h % a.G;
+        const int r = n * a.G + g;
+        if (r >= a.Rpad) continue;
+        const float x = n < a.ne01 ? *((device const float *) (q + (uint64_t) n * a.nb01 + (uint64_t) h * a.nb02) + d) : 0.0f;
+        qh[((uint64_t) hk * a.Rpad + r) * D + d] = (half) (x * a.scale);
+    }
+    if (n >= a.ne01) return;
+
+    // blocks outside [p0, p1): [0, p0) then [p1, ne11)
+    const int nb_lo = a.p0 / SLLM_CASCADE_B;
+    const int nb_hi = (a.ne11 - a.p1 + SLLM_CASCADE_B - 1) / SLLM_CASCADE_B;
+    const int nbt = nb_lo + nb_hi;
+    const int per = (nbt + 255) / 256;       // <= 32 (the dispatcher checks)
+    device const half * mrow = (device const half *) (mask + (uint64_t) n * a.nb31);
+    uint bits = 0;
+    for (int i = 0; i < per; ++i) {
+        const int b = tid * per + i;
+        if (b >= nbt) break;
+        const int c0 = b < nb_lo ? b * SLLM_CASCADE_B : a.p1 + (b - nb_lo) * SLLM_CASCADE_B;
+        bool any = false;
+        if (c0 + SLLM_CASCADE_B <= a.ne11) {
+            device const half4 * m4 = (device const half4 *) (mrow + c0);
+            for (int j = 0; j < SLLM_CASCADE_B / 4; ++j) {
+                const half4 m = m4[j];
+                any = any || (m[0] > -MAXHALF) || (m[1] > -MAXHALF) || (m[2] > -MAXHALF) || (m[3] > -MAXHALF);
+            }
+        } else {
+            for (int c = c0; c < a.ne11; ++c) any = any || (mrow[c] > -MAXHALF);
+        }
+        bits |= any ? (1u << i) : 0u;
+    }
+    const int mine = popcount(bits);
+    // exclusive scan over the 256 threads (8 simdgroups)
+    const int incl = simd_prefix_inclusive_sum(mine);
+    if (tii == 31) sh[sgi] = incl;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    int base = 0;
+    for (int s = 0; s < sgi; ++s) base += sh[s];
+    int off = base + incl - mine;
+    device int * lst = lists + (uint64_t) n * a.nblk;
+    for (int i = 0; i < per; ++i) {
+        if (bits & (1u << i)) {
+            const int b = tid * per + i;
+            lst[off++] = b < nb_lo ? b * SLLM_CASCADE_B : a.p1 + (b - nb_lo) * SLLM_CASCADE_B;
+        }
+    }
+    if (tid == 255) cnt[n] = off;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// prefix: RT rows x C cells per step, NSG simdgroups (matmul2d execution_simdgroups<NSG>).
+//   threadgroup memory: S [RT][C] float | P [RT][C] half | alpha [RT] float | flags [2][NSG] int (by step parity)
+template <int D, int RT, int C, int NSG>
+static inline void sllm_cascade_prefix_body(
+        constant sllm_cascade_args & a,
+        device const half  * qh,
+        device const char  * k,
+        device const char  * v,
+        device const char  * mask,
+        device       float * po,     // [S(+1)][HKV][Rpad][D]
+        device       float * pml,    // [S(+1)][HKV][Rpad][2]
+        threadgroup  char  * shm,
+        uint3  tg, ushort tid, ushort sgi, ushort tii) {
+    constexpr int NT  = NSG * 32;
+    constexpr int TPR = NT / RT;          // threads per row in the softmax (power of 2, <= 32)
+    constexpr int CPT = C / TPR;          // cells per thread
+    static_assert(TPR >= 1 && TPR <= 32 && CPT >= 1, "tile");
+
+    const int hk = tg.x, s = tg.y, r0 = tg.z * RT;
+
+    threadgroup float * ss = (threadgroup float *) shm;
+    threadgroup half  * sp = (threadgroup half *) (ss + RT * C);
+    threadgroup float * sa = (threadgroup float *) (sp + RT * C);
+    threadgroup int   * sf = (threadgroup int *) (sa + RT);
+
+    constexpr auto dqk = matmul2d_descriptor(RT, C, D, false, true, false, matmul2d_descriptor::mode::multiply);
+    constexpr auto dpv = matmul2d_descriptor(RT, D, C, false, false, false, matmul2d_descriptor::mode::multiply_accumulate);
+    matmul2d<dqk, execution_simdgroups<NSG>> mqk;
+    matmul2d<dpv, execution_simdgroups<NSG>> mpv;
+
+    const int ldk = (int) (a.nb11 / 2), ldv = (int) (a.nb21 / 2);
+    device const half * kh = (device const half *) (k + (uint64_t) hk * a.nb12);
+    device const half * vh = (device const half *) (v + (uint64_t) hk * a.nb22);
+
+    auto tQ = tensor((device half *) qh + ((uint64_t) hk * a.Rpad + r0) * D, dextents<int32_t, 2>(D, RT), array<int, 2>({1, D}));
+    auto tS = tensor(ss, dextents<int32_t, 2>(C, RT), array<int, 2>({1, C}));
+    auto tP = tensor(sp, dextents<int32_t, 2>(C, RT), array<int, 2>({1, C}));
+    auto tK0 = tensor((device half *) kh, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldk}));
+    auto tV0 = tensor((device half *) vh, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldv}));
+    auto cS = mqk.template get_destination_cooperative_tensor<decltype(tQ), decltype(tK0), float>();
+    auto cO = mpv.template get_destination_cooperative_tensor<decltype(tP), decltype(tV0), float>();
+    #pragma unroll
+    for (uint16_t i = 0; i < cO.get_capacity(); ++i) {
+        if (cO.is_valid_element(i)) cO[i] = 0.0f;
+    }
+
+    const int lr = tid / TPR;                 // softmax row of this thread
+    const int lc = (tid % TPR) * CPT;
+    const int r = r0 + lr;
+    const bool rvalid = r < a.R;
+    device const half * mrow = (device const half *) (mask + (uint64_t) (rvalid ? r / a.G : 0) * a.nb31);
+    float M = SLLM_NEG, L = 0.0f;
+
+    const int c_begin = a.p0 + s * a.chunk;
+    const int c_end = min(a.p1, c_begin + a.chunk);
+    for (int cb = c_begin; cb < c_end; cb += C) {
+        // this thread's mask values; is any cell of the tile visible to any row?
+        half mv[CPT];
+        bool any = false;
+        #pragma unroll
+        for (int c = 0; c < CPT; ++c) {
+            mv[c] = rvalid ? mrow[cb + lc + c] : -INFINITY;
+            any = any || (mv[c] > -MAXHALF);
+        }
+        any = simd_any(any);
+        if (tii == 0) sf[((cb / C) & 1) * NSG + sgi] = any ? 1 : 0;   // parity buffer: a fast simdgroup must not overwrite flags a slow one still reads
+        threadgroup_barrier(mem_flags::mem_threadgroup);   // also: the previous step's P V is done with P
+        int vis = 0;
+        #pragma unroll
+        for (int i = 0; i < NSG; ++i) vis |= sf[((cb / C) & 1) * NSG + i];
+        if (!vis) continue;
+
+        auto tK = tensor((device half *) kh + (uint64_t) cb * ldk, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldk}));
+        mqk.run(tQ, tK, cS);
+        cS.store(tS);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        // online softmax, TPR threads per row
+        float x[CPT];
+        float mx = SLLM_NEG;
+        #pragma unroll
+        for (int c = 0; c < CPT; ++c) {
+            x[c] = ss[lr * C + lc + c] + (float) mv[c];
+            mx = max(mx, x[c]);
+        }
+        #pragma unroll
+        for (int o = 1; o < TPR; o <<= 1) mx = max(mx, simd_shuffle_xor(mx, o));
+        const float Mn = max(M, mx);
+        const float ms = exp(M - Mn);
+        float sum = 0.0f;
+        #pragma unroll
+        for (int c = 0; c < CPT; ++c) {
+            const half p = (half) exp(x[c] - Mn);
+            sum += (float) p; // normalize the same rounded probabilities used by P V
+            sp[lr * C + lc + c] = p;
+        }
+        #pragma unroll
+        for (int o = 1; o < TPR; o <<= 1) sum += simd_shuffle_xor(sum, o);
+        L = L * ms + sum;
+        M = Mn;
+        if (tid % TPR == 0) sa[lr] = ms;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        #pragma unroll
+        for (uint16_t i = 0; i < cO.get_capacity(); ++i) {
+            if (cO.is_valid_element(i)) {
+                const auto ix = cO.get_multidimensional_index(i);
+                cO[i] *= sa[ix[1]];
+            }
+        }
+        auto tV = tensor((device half *) vh + (uint64_t) cb * ldv, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldv}));
+        mpv.run(tP, tV, cO);
+    }
+
+    device float * o0 = po + (((uint64_t) s * a.HKV + hk) * a.Rpad + r0) * D;
+    auto tO = tensor(o0, dextents<int32_t, 2>(D, RT), array<int, 2>({1, D}));
+    cO.store(tO);
+    if (tid % TPR == 0) {
+        device float * ml = pml + (((uint64_t) s * a.HKV + hk) * a.Rpad + r) * 2;
+        ml[0] = M;
+        ml[1] = rvalid ? L : 0.0f;
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// suffix + merge: one threadgroup per (KV head, agent), NS simdgroups.
+//   threadgroup memory: q [G][D] float | partials [NS][G][2 + D] float
+// PARTIAL: write this pass's unnormalised (O, max, sum) to slot a.S of po/pml (the fused path, merged later by
+// kernel_sllm_cascade_merge); otherwise merge the S prefix partials here and write dst.
+template <int D, int G, int NS, bool PARTIAL>
+static inline void sllm_cascade_suffix_body(
+        constant sllm_cascade_args & a,
+        device const char  * q,
+        device const char  * k,
+        device const char  * v,
+        device const char  * mask,
+        device       float * po,
+        device       float * pml,
+        device const int   * lists,
+        device const int   * cnt,
+        device       float * dst,
+        threadgroup  float * shm,
+        uint3  tg, ushort tid, ushort sgi, ushort tii) {
+    constexpr int DL = D / 32;
+    const int hk = tg.x, n = tg.y;
+    threadgroup float * sq = shm;                 // [G][D]
+    threadgroup float * sm = sq + G * D;          // [NS][G][2 + D]
+    for (int e = tid; e < G * D; e += NS * 32) {
+        const int g = e / D, d = e % D;
+        sq[e] = (float) (half) (*((device const float *) (q + (uint64_t) n * a.nb01 + (uint64_t) (hk * G + g) * a.nb02) + d) * a.scale);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    float M[G], L[G], o[G][DL];
+    #pragma unroll
+    for (int g = 0; g < G; ++g) {
+        M[g] = SLLM_NEG; L[g] = 0.0f;
+        #pragma unroll
+        for (int i = 0; i < DL; ++i) o[g][i] = 0.0f;
+    }
+    device const half * mrow = (device const half *) (mask + (uint64_t) n * a.nb31);
+    device const int * lst = lists + (uint64_t) n * a.nblk;
+    const int nb = cnt[n];
+    device const char * kb = k + (uint64_t) hk * a.nb12;
+    device const char * vb = v + (uint64_t) hk * a.nb22 + tii * DL * 2;
+    for (int j = sgi; j < nb; j += NS) {
+        const int c0 = lst[j];
+        const int cell = c0 + tii;
+        const float mval = cell < a.ne11 ? (float) mrow[cell] : -INFINITY;
+        const bool fin = mval > -MAXHALF;
+        float x[G];
+        #pragma unroll
+        for (int g = 0; g < G; ++g) x[g] = -INFINITY;
+        if (fin) {
+            device const half4 * k4 = (device const half4 *) (kb + (uint64_t) cell * a.nb11);
+            float acc[G];
+            #pragma unroll
+            for (int g = 0; g < G; ++g) acc[g] = 0.0f;
+            for (int i = 0; i < D / 4; ++i) {
+                const float4 kk = (float4) k4[i];
+                #pragma unroll
+                for (int g = 0; g < G; ++g) acc[g] += dot(kk, ((threadgroup const float4 *) (sq + g * D))[i]);
+            }
+            #pragma unroll
+            for (int g = 0; g < G; ++g) x[g] = acc[g] + mval;
+        }
+        float p[G];
+        #pragma unroll
+        for (int g = 0; g < G; ++g) {
+            const float Mn = max(M[g], simd_max(x[g]));
+            const float ms = exp(M[g] - Mn);
+            p[g] = exp(x[g] - Mn);
+            L[g] = L[g] * ms + simd_sum(p[g]);
+            M[g] = Mn;
+            #pragma unroll
+            for (int i = 0; i < DL; ++i) o[g][i] *= ms;
+        }
+        const uint vis = (uint) ((simd_vote::vote_t) simd_ballot(fin));
+        for (int jj = 0; jj < 32; ++jj) {
+            if (!(vis & (1u << jj))) continue;
+            device const half * vr = (device const half *) (vb + (uint64_t) (c0 + jj) * a.nb21);
+            float vv[DL];
+            if (DL % 4 == 0) {
+                #pragma unroll
+                for (int i = 0; i < DL; i += 4) {
+                    const float4 t = (float4) *((device const half4 *) (vr + i));
+                    vv[i] = t[0]; vv[i + 1] = t[1]; vv[i + 2] = t[2]; vv[i + 3] = t[3];
+                }
+            } else {
+                #pragma unroll
+                for (int i = 0; i < DL; ++i) vv[i] = (float) vr[i];
+            }
+            #pragma unroll
+            for (int g = 0; g < G; ++g) {
+                const float pj = simd_shuffle(p[g], jj);
+                #pragma unroll
+                for (int i = 0; i < DL; ++i) o[g][i] += pj * vv[i];
+            }
+        }
+    }
+    #pragma unroll
+    for (int g = 0; g < G; ++g) {
+        threadgroup float * e = sm + (sgi * G + g) * (2 + D);
+        if (tii == 0) { e[0] = M[g]; e[1] = L[g]; }
+        #pragma unroll
+        for (int i = 0; i < DL; ++i) e[2 + tii * DL + i] = o[g][i];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (PARTIAL) {
+        // merge the NS simdgroup partials into slot S
+        for (int g = sgi; g < G; g += NS) {
+            const int r = n * G + g;
+            float Mm = SLLM_NEG, Lm = 0.0f, om[DL];
+            #pragma unroll
+            for (int i = 0; i < DL; ++i) om[i] = 0.0f;
+            for (int t = 0; t < NS; ++t) {
+                threadgroup const float * es = sm + (t * G + g) * (2 + D);
+                const float mt = es[0], lt = es[1];
+                if (!(lt > 0.0f)) continue;
+                const float Mn = max(Mm, mt);
+                const float e1 = exp(Mm - Mn), e2 = exp(mt - Mn);
+                #pragma unroll
+                for (int i = 0; i < DL; ++i) om[i] = om[i] * e1 + es[2 + tii * DL + i] * e2;
+                Lm = Lm * e1 + lt * e2;
+                Mm = Mn;
+            }
+            device float * pr = po + (((uint64_t) a.S * a.HKV + hk) * a.Rpad + r) * D + tii * DL;
+            #pragma unroll
+            for (int i = 0; i < DL; ++i) pr[i] = om[i];
+            if (tii == 0) {
+                device float * ml = pml + (((uint64_t) a.S * a.HKV + hk) * a.Rpad + r) * 2;
+                ml[0] = Mm; ml[1] = Lm;
+            }
+        }
+        return;
+    }
+    // simdgroup g merges query head g: the NS suffix partials, then the S prefix partials
+    for (int g = sgi; g < G; g += NS) {
+        const int r = n * G + g;
+        float Mm = SLLM_NEG, Lm = 0.0f, om[DL];
+        #pragma unroll
+        for (int i = 0; i < DL; ++i) om[i] = 0.0f;
+        for (int t = 0; t < NS + a.S; ++t) {
+            float mt, lt;
+            threadgroup const float * es = nullptr;
+            device const float * ed = nullptr;
+            if (t < NS) {
+                es = sm + (t * G + g) * (2 + D);
+                mt = es[0]; lt = es[1];
+            } else {
+                const int s = t - NS;
+                device const float * ml = pml + (((uint64_t) s * a.HKV + hk) * a.Rpad + r) * 2;
+                mt = ml[0]; lt = ml[1];
+                ed = po + (((uint64_t) s * a.HKV + hk) * a.Rpad + r) * D;
+            }
+            if (!(lt > 0.0f)) continue;
+            const float Mn = max(Mm, mt);
+            const float e1 = exp(Mm - Mn), e2 = exp(mt - Mn);
+            #pragma unroll
+            for (int i = 0; i < DL; ++i) {
+                const float ov = es ? es[2 + tii * DL + i] : ed[tii * DL + i];
+                om[i] = om[i] * e1 + ov * e2;
+            }
+            Lm = Lm * e1 + lt * e2;
+            Mm = Mn;
+        }
+        device float * op = dst + ((uint64_t) n * a.H + hk * G + g) * D + tii * DL;
+        const float il = Lm > 0.0f ? 1.0f / Lm : 0.0f;
+        #pragma unroll
+        for (int i = 0; i < DL; ++i) op[i] = om[i] * il;
+    }
+}
+
+// fused: one dispatch of n_pre = HKV * S * row_tiles prefix threadgroups followed by HKV * ne01 suffix threadgroups
+// (4 simdgroups each), so the compute-bound prefix overlaps the bandwidth-bound suffix; kernel_sllm_cascade_merge
+// combines the S + 1 partials.
+template <int D, int RT, int C, int G>
+kernel void kernel_sllm_cascade_fused(
+        constant sllm_cascade_args & a [[buffer(0)]],
+        device const char  * q     [[buffer(1)]],
+        device const half  * qh    [[buffer(2)]],
+        device const char  * k     [[buffer(3)]],
+        device const char  * v     [[buffer(4)]],
+        device const char  * mask  [[buffer(5)]],
+        device       float * po    [[buffer(6)]],
+        device       float * pml   [[buffer(7)]],
+        device const int   * lists [[buffer(8)]],
+        device const int   * cnt   [[buffer(9)]],
+        threadgroup  char  * shm   [[threadgroup(0)]],
+        uint   tgi [[threadgroup_position_in_grid]],
+        ushort tid [[thread_index_in_threadgroup]],
+        ushort sgi [[simdgroup_index_in_threadgroup]],
+        ushort tii [[thread_index_in_simdgroup]]) {
+    const int rtiles = a.Rpad / RT;
+    const int n_pre = a.HKV * a.S * rtiles;
+    if ((int) tgi < n_pre) {
+        const int t = tgi;
+        // kv head fastest: the threadgroups running together read different heads of the same prefix cells
+        const uint3 tg = uint3(t % a.HKV, (t / a.HKV) % a.S, t / (a.HKV * a.S));
+        sllm_cascade_prefix_body<D, RT, C, 4>(a, qh, k, v, mask, po, pml, shm, tg, tid, sgi, tii);
+    } else {
+        const int t = tgi - n_pre;
+        const uint3 tg = uint3(t % a.HKV, t / a.HKV, 0);
+        sllm_cascade_suffix_body<D, G, 4, true>(a, q, k, v, mask, po, pml, lists, cnt, nullptr, (threadgroup float *) shm, tg, tid, sgi, tii);
+    }
+}
+
+// merge the S + 1 partials: one simdgroup per (query head, agent)
+template <int D>
+kernel void kernel_sllm_cascade_merge(
+        constant sllm_cascade_args & a [[buffer(0)]],
+        device const float * po  [[buffer(1)]],
+        device const float * pml [[buffer(2)]],
+        device       float * dst [[buffer(3)]],
+        uint2  tg  [[threadgroup_position_in_grid]],
+        ushort tii [[thread_index_in_simdgroup]]) {
+    constexpr int DL = D / 32;
+    const int h = tg.x, n = tg.y;
+    const int hk = h / a.G, r = n * a.G + h % a.G;
+    float Mm = SLLM_NEG, Lm = 0.0f, om[DL];
+    #pragma unroll
+    for (int i = 0; i < DL; ++i) om[i] = 0.0f;
+    for (int s = 0; s <= a.S; ++s) {
+        device const float * ml = pml + (((uint64_t) s * a.HKV + hk) * a.Rpad + r) * 2;
+        const float mt = ml[0], lt = ml[1];
+        if (!(lt > 0.0f)) continue;
+        device const float * pr = po + (((uint64_t) s * a.HKV + hk) * a.Rpad + r) * D + tii * DL;
+        const float Mn = max(Mm, mt);
+        const float e1 = exp(Mm - Mn), e2 = exp(mt - Mn);
+        #pragma unroll
+        for (int i = 0; i < DL; ++i) om[i] = om[i] * e1 + pr[i] * e2;
+        Lm = Lm * e1 + lt * e2;
+        Mm = Mn;
+    }
+    device float * op = dst + ((uint64_t) n * a.H + h) * D + tii * DL;
+    const float il = Lm > 0.0f ? 1.0f / Lm : 0.0f;
+    #pragma unroll
+    for (int i = 0; i < DL; ++i) op[i] = om[i] * il;
+}
+
+#define SLLM_CASCADE_FUSED(D, RT, C, G) \
+    template [[host_name("kernel_sllm_cascade_fused_d" #D "_rt" #RT "_c" #C "_g" #G)]] \
+    kernel void kernel_sllm_cascade_fused<D, RT, C, G>(constant sllm_cascade_args &, device const char *, \
+        device const half *, device const char *, device const char *, device const char *, device float *, \
+        device float *, device const int *, device const int *, threadgroup char *, uint, ushort, ushort, ushort);
+#define SLLM_CASCADE_MERGE(D) \
+    template [[host_name("kernel_sllm_cascade_merge_d" #D)]] kernel void kernel_sllm_cascade_merge<D>( \
+        constant sllm_cascade_args &, device const float *, device const float *, device float *, uint2, ushort);
+SLLM_CASCADE_FUSED(128, 16, 64, 2) SLLM_CASCADE_FUSED(128, 32, 64, 2)
+SLLM_CASCADE_FUSED(128, 16, 64, 4) SLLM_CASCADE_FUSED(128, 32, 64, 4)
+SLLM_CASCADE_FUSED(256, 16, 64, 2) SLLM_CASCADE_FUSED(256, 32, 64, 2)
+SLLM_CASCADE_FUSED(256, 16, 64, 4) SLLM_CASCADE_FUSED(256, 32, 64, 4)
+SLLM_CASCADE_MERGE(128) SLLM_CASCADE_MERGE(256)
+
+#endif // GGML_METAL_HAS_TENSOR
--- a/src/ggml-metal/ggml-metal-cascade.h
+++ b/src/ggml-metal/ggml-metal-cascade.h
@@ -0,0 +1,81 @@
+// SLLM patch (decisions.md D042, after D048 qmm): dispatch, self-test and status of the shared-prefix decode attention
+// ("cascade", kernels/cascade.metal).
+//
+// The hint: sllm-core marks a decode group's GGML_OP_FLASH_ATTN_EXT whose K/V view starts with (or holds) the shared
+// prefix pages by writing three op parameters, which official ggml never reads (it uses slots 0..4):
+//   op_params[13] = GGML_METAL_SLLM_CASCADE_MAGIC
+//   op_params[14] = p0, op_params[15] = p1: the prefix range [p0, p1) in cells of the op's K/V view
+// The kernel is exact for any range (each cell is read once per row, by one of its two passes); the range only
+// decides the speed. Without the magic, or when a condition below fails, the op runs ggml's own kernels.
+#pragma once
+
+#include "ggml.h"
+#include "ggml-metal-device.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define GGML_METAL_SLLM_CASCADE_MAGIC 0x534C4341 // "SLCA"
+
+// kernel arguments; the same layout is declared in kernels/cascade.metal
+typedef struct {
+    int32_t ne01;    // agents (query rows)
+    int32_t H;       // query heads
+    int32_t HKV;     // KV heads
+    int32_t G;       // H / HKV
+    int32_t R;       // ne01 * G rows per KV head
+    int32_t Rpad;    // R padded to the prefix row tile
+    int32_t ne11;    // cells of the K/V view
+    int32_t p0;      // prefix range [p0, p1) of the view
+    int32_t p1;
+    int32_t chunk;   // prefix cells per split
+    int32_t S;       // prefix splits
+    int32_t nblk;    // capacity of a row's block list
+    uint64_t nb01, nb02;   // q strides (bytes)
+    uint64_t nb11, nb12;   // k strides
+    uint64_t nb21, nb22;   // v strides
+    uint64_t nb31;         // mask row stride
+    float scale;
+    int32_t pad0;
+} ggml_metal_kargs_sllm_cascade;
+
+struct ggml_metal_sllm_cascade_plan {
+    int D;      // head size (128 or 256)
+    int rt;     // prefix row tile (16 or 32)
+    int c;      // prefix cells per step (64)
+    int n_pre;  // prefix threadgroups (HKV * S * row_tiles)
+    // scratch after dst (offsets from the end of dst, bytes)
+    size_t off_qh, off_lists, off_cnt, off_po, off_pml, extra;
+    ggml_metal_kargs_sllm_cascade args;
+};
+
+// true when the cascade path takes this FLASH_ATTN_EXT (enabled, hinted, supported shapes and layout); a pure
+// function of the tensor and the process-wide state fixed at device init
+bool ggml_metal_sllm_cascade_plan_op(const struct ggml_tensor * op, struct ggml_metal_sllm_cascade_plan * plan);
+
+// bytes of scratch the dst of this FLASH_ATTN_EXT needs beyond ggml_nbytes (0 when the cascade does not take it)
+size_t ggml_metal_sllm_cascade_extra(const struct ggml_tensor * op);
+
+// encode the plan (scan, barrier, fused, barrier, merge); false (nothing encoded) when a pipeline is missing or a
+// buffer is misaligned
+bool ggml_metal_sllm_cascade_encode(ggml_metal_library_t lib, ggml_metal_encoder_t enc, const struct ggml_metal_sllm_cascade_plan * plan,
+        struct ggml_metal_buffer_id q, struct ggml_metal_buffer_id k, struct ggml_metal_buffer_id v,
+        struct ggml_metal_buffer_id mask, struct ggml_metal_buffer_id dst);
+
+// called once by ggml_metal_device_init after the library is built: reads SLLM_CASCADE, runs the self-test
+void ggml_metal_sllm_cascade_device_init(ggml_metal_device_t dev, ggml_metal_library_t lib, bool has_tensor);
+
+// called by the library compile when kernels/cascade.metal fails to build (the rest of the library is unaffected)
+void ggml_metal_sllm_cascade_note_compile_failure(const char * msg);
+
+// exported: a JSON object describing the patch, the mode, the self-test and the dispatch count (thread-local buffer)
+const char * ggml_backend_metal_sllm_cascade_status(void);
+
+#ifdef __cplusplus
+}
+#endif
--- a/src/ggml-metal/ggml-metal-cascade.m
+++ b/src/ggml-metal/ggml-metal-cascade.m
@@ -0,0 +1,516 @@
+// SLLM patch (decisions.md D042, after D048 qmm): dispatch, self-test and status of the shared-prefix decode attention
+// ("cascade", kernels/cascade.metal).
+//
+// Mode (env SLLM_CASCADE, read once at device init):
+//   unset or "1"  auto: the cascade takes a hinted FLASH_ATTN_EXT with >= 8 query rows when the self-test passed
+//   "0"           off: every FLASH_ATTN_EXT goes through the official ggml path (A/B switch)
+//   "force"       test only: any number of query rows
+// SLLM_CASCADE_TRACE=1 prints every cascade dispatch, and why a hinted op was not taken, to stderr (tests only: it is
+// per encode).
+//
+// Conditions (else ggml's own kernels): the hint (op_params[13] = GGML_METAL_SLLM_CASCADE_MAGIC, [p0, p1) in
+// op_params[14..15], p0 % 32 == 0, (p1 - p0) % 64 == 0); the Metal 4 tensor API; q f32, K/V f16 with contiguous head
+// rows, head size 128 or 256 (K and V equal), G = H / HKV in {2, 4}, one stream (ne03 = 1); an f16 mask covering every
+// row, one for all heads; no sinks, no ALiBi, no logit softcap; dst contiguous f32.
+//
+// Tiles (sllm/results/phase2-cascade, standalone sweep): prefix row tile 16 rows up to 16 rows per KV head, else 32;
+// 64 cells per prefix step; 4 prefix splits up to 32 rows per KV head, else 2.
+
+#import "ggml-metal-cascade.h"
+
+#import "ggml-impl.h"
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+
+#include <math.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define SLLM_CASCADE_C      64  // prefix cells per step
+#define SLLM_CASCADE_B      32  // suffix block (cells)
+#define SLLM_CASCADE_NTH    128 // fused kernel: 4 simdgroups
+#define SLLM_CASCADE_MIN_N  8   // auto mode: fewest query rows (agents)
+
+enum sllm_cascade_mode { SLLM_CASCADE_MODE_AUTO = 0, SLLM_CASCADE_MODE_OFF = 1, SLLM_CASCADE_MODE_FORCE = 2 };
+
+static struct {
+    bool initialized;
+    bool active;
+    bool trace;
+    enum sllm_cascade_mode mode;
+    char reason[256];
+    bool compile_failed;
+    char compile_msg[256];
+    bool selftest_ran;
+    bool selftest_pass;
+    int  selftest_cases;
+    double selftest_worst_max_rel;
+    double selftest_worst_rel_rms;
+    double selftest_ms;
+    atomic_ullong dispatches;
+} g_cas;
+
+void ggml_metal_sllm_cascade_note_compile_failure(const char * msg) {
+    g_cas.compile_failed = true;
+    snprintf(g_cas.compile_msg, sizeof(g_cas.compile_msg), "%s", msg ? msg : "unknown");
+}
+
+static size_t sllm_cas_align(size_t x) { return (x + 255) & ~(size_t) 255; }
+
+// fill the plan from the shapes; false when a size limit is exceeded
+static bool sllm_cascade_fill_plan(struct ggml_metal_sllm_cascade_plan * p, int D, int N, int H, int HKV, int ne11, int p0, int p1,
+        uint64_t nb01, uint64_t nb02, uint64_t nb11, uint64_t nb12, uint64_t nb21, uint64_t nb22, uint64_t nb31, float scale) {
+    const int G = H/HKV;
+    const int R = N*G;
+    const int rt = R <= 16 ? 16 : 32;
+    const int Rpad = (R + rt - 1)/rt*rt;
+    const int P = p1 - p0;
+    int S = R <= 32 ? 4 : 2;
+    int chunk = (P + S - 1)/S;
+    chunk = (chunk + SLLM_CASCADE_C - 1)/SLLM_CASCADE_C*SLLM_CASCADE_C;
+    S = (P + chunk - 1)/chunk;
+    const int nbt = p0/SLLM_CASCADE_B + (ne11 - p1 + SLLM_CASCADE_B - 1)/SLLM_CASCADE_B;
+    if (nbt > 256*32) {
+        return false; // the scan keeps one bit per block in a register: at most 32 blocks per thread
+    }
+    const int nblk = nbt > 0 ? nbt : 1;
+
+    p->D     = D;
+    p->rt    = rt;
+    p->c     = SLLM_CASCADE_C;
+    p->n_pre = HKV*S*(Rpad/rt);
+
+    size_t off = 0;
+    p->off_qh    = off; off += sllm_cas_align((size_t) HKV*Rpad*D*2);
+    p->off_lists = off; off += sllm_cas_align((size_t) N*nblk*4);
+    p->off_cnt   = off; off += sllm_cas_align((size_t) N*4);
+    p->off_po    = off; off += sllm_cas_align((size_t) (S + 1)*HKV*Rpad*D*4);
+    p->off_pml   = off; off += sllm_cas_align((size_t) (S + 1)*HKV*Rpad*2*4);
+    p->extra     = off;
+
+    ggml_metal_kargs_sllm_cascade * a = &p->args;
+    memset(a, 0, sizeof(*a));
+    a->ne01 = N; a->H = H; a->HKV = HKV; a->G = G; a->R = R; a->Rpad = Rpad; a->ne11 = ne11;
+    a->p0 = p0; a->p1 = p1; a->chunk = chunk; a->S = S; a->nblk = nblk;
+    a->nb01 = nb01; a->nb02 = nb02; a->nb11 = nb11; a->nb12 = nb12; a->nb21 = nb21; a->nb22 = nb22; a->nb31 = nb31;
+    a->scale = scale;
+    return true;
+}
+
+// a hinted op the cascade does not take: say why when tracing (the condition number counts the checks below)
+static bool sllm_cas_reject(const struct ggml_tensor * op, int cond) {
+    if (g_cas.trace) {
+        fprintf(stderr, "sllm_cascade: hinted op %s not taken (condition %d)\n", op->name, cond);
+    }
+    return false;
+}
+
+bool ggml_metal_sllm_cascade_plan_op(const struct ggml_tensor * op, struct ggml_metal_sllm_cascade_plan * plan) {
+    if (!g_cas.active || op->op != GGML_OP_FLASH_ATTN_EXT) {
+        return false;
+    }
+    if (ggml_get_op_params_i32(op, 13) != GGML_METAL_SLLM_CASCADE_MAGIC) {
+        return false;
+    }
+    const struct ggml_tensor * q = op->src[0];
+    const struct ggml_tensor * k = op->src[1];
+    const struct ggml_tensor * v = op->src[2];
+    const struct ggml_tensor * m = op->src[3];
+    if (!q || !k || !v || !m || op->src[4]) {
+        return sllm_cas_reject(op, 1);
+    }
+    float scale, max_bias, softcap;
+    memcpy(&scale,    (const int32_t *) op->op_params + 0, sizeof(float));
+    memcpy(&max_bias, (const int32_t *) op->op_params + 1, sizeof(float));
+    memcpy(&softcap,  (const int32_t *) op->op_params + 2, sizeof(float));
+    if (max_bias != 0.0f || softcap != 0.0f) {
+        return sllm_cas_reject(op, 2);
+    }
+    if (q->type != GGML_TYPE_F32 || k->type != GGML_TYPE_F16 || v->type != GGML_TYPE_F16 || m->type != GGML_TYPE_F16 || op->type != GGML_TYPE_F32) {
+        return sllm_cas_reject(op, 3);
+    }
+    const int64_t D = q->ne[0], N = q->ne[1], H = q->ne[2];
+    const int64_t ne11 = k->ne[1], HKV = k->ne[2];
+    if ((D != 128 && D != 256) || k->ne[0] != D || v->ne[0] != D || v->ne[1] != ne11 || v->ne[2] != HKV) {
+        return sllm_cas_reject(op, 4);
+    }
+    if (q->ne[3] != 1 || k->ne[3] != 1 || v->ne[3] != 1 || HKV <= 0 || H % HKV != 0 || (H/HKV != 2 && H/HKV != 4)) {
+        return sllm_cas_reject(op, 5);
+    }
+    if (N < (g_cas.mode == SLLM_CASCADE_MODE_FORCE ? 1 : SLLM_CASCADE_MIN_N) || N > 4096 || ne11 > (1 << 24)) {
+        return sllm_cas_reject(op, 6);
+    }
+    const int64_t p0 = ggml_get_op_params_i32(op, 14), p1 = ggml_get_op_params_i32(op, 15);
+    if (p0 < 0 || p1 <= p0 || p1 > ne11 || p0 % SLLM_CASCADE_B != 0 || (p1 - p0) % SLLM_CASCADE_C != 0) {
+        return sllm_cas_reject(op, 7);
+    }
+    // strides: q rows of f32, K/V head rows of contiguous halfs (half4 loads, matmul2d device operands)
+    if (q->nb[0] != sizeof(float) || q->nb[1] % 4 != 0 || q->nb[2] % 4 != 0) {
+        return sllm_cas_reject(op, 8);
+    }
+    if (k->nb[0] != 2 || v->nb[0] != 2 || k->nb[1] % 16 != 0 || k->nb[2] % 16 != 0 || v->nb[1] % 16 != 0 || v->nb[2] % 16 != 0 ||
+        k->nb[1]/2 > INT32_MAX || v->nb[1]/2 > INT32_MAX) {
+        return sllm_cas_reject(op, 9);
+    }
+    if (m->ne[0] < ne11 || m->ne[1] < N || m->ne[2] != 1 || m->ne[3] != 1 || m->nb[0] != 2 || m->nb[1] % 16 != 0) {
+        return sllm_cas_reject(op, 10);
+    }
+    if (op->ne[0] != D || op->ne[1] != H || op->ne[2] != N || op->ne[3] != 1 || !ggml_is_contiguous(op)) {
+        return sllm_cas_reject(op, 11);
+    }
+    struct ggml_metal_sllm_cascade_plan p;
+    if (!sllm_cascade_fill_plan(&p, (int) D, (int) N, (int) H, (int) HKV, (int) ne11, (int) p0, (int) p1,
+            q->nb[1], q->nb[2], k->nb[1], k->nb[2], v->nb[1], v->nb[2], m->nb[1], scale)) {
+        return sllm_cas_reject(op, 12);
+    }
+    if (plan) {
+        *plan = p;
+    }
+    return true;
+}
+
+size_t ggml_metal_sllm_cascade_extra(const struct ggml_tensor * op) {
+    struct ggml_metal_sllm_cascade_plan p;
+    if (!ggml_metal_sllm_cascade_plan_op(op, &p)) {
+        return 0;
+    }
+    return p.extra;
+}
+
+static struct ggml_metal_pipeline_with_params sllm_cas_get_pipeline(ggml_metal_library_t lib, const char * base) {
+    struct ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, base);
+    if (!res.pipeline) {
+        res = ggml_metal_library_compile_pipeline(lib, base, base, NULL);
+    }
+    return res;
+}
+
+static struct ggml_metal_buffer_id sllm_cas_at(struct ggml_metal_buffer_id b, size_t off) {
+    b.offs += off;
+    return b;
+}
+
+bool ggml_metal_sllm_cascade_encode(ggml_metal_library_t lib, ggml_metal_encoder_t enc, const struct ggml_metal_sllm_cascade_plan * plan,
+        struct ggml_metal_buffer_id q, struct ggml_metal_buffer_id k, struct ggml_metal_buffer_id v,
+        struct ggml_metal_buffer_id mask, struct ggml_metal_buffer_id dst) {
+    const ggml_metal_kargs_sllm_cascade * a = &plan->args;
+    if (q.offs % 4 != 0 || k.offs % 16 != 0 || v.offs % 16 != 0 || mask.offs % 16 != 0 || dst.offs % 16 != 0) {
+        if (g_cas.trace) {
+            fprintf(stderr, "sllm_cascade: misaligned buffers (q %zu, k %zu, v %zu, mask %zu, dst %zu)\n",
+                    (size_t) q.offs, (size_t) k.offs, (size_t) v.offs, (size_t) mask.offs, (size_t) dst.offs);
+        }
+        return false;
+    }
+    char name[96];
+    struct ggml_metal_pipeline_with_params p_scan = sllm_cas_get_pipeline(lib, "kernel_sllm_cascade_scan");
+    snprintf(name, sizeof(name), "kernel_sllm_cascade_fused_d%d_rt%d_c%d_g%d", plan->D, plan->rt, plan->c, a->G);
+    struct ggml_metal_pipeline_with_params p_fus = sllm_cas_get_pipeline(lib, name);
+    snprintf(name, sizeof(name), "kernel_sllm_cascade_merge_d%d", plan->D);
+    struct ggml_metal_pipeline_with_params p_mrg = sllm_cas_get_pipeline(lib, name);
+    if (!p_scan.pipeline || !p_fus.pipeline || !p_mrg.pipeline || ggml_metal_pipeline_max_theads_per_threadgroup(p_fus) < SLLM_CASCADE_NTH) {
+        return false;
+    }
+    const size_t tg_pre = (size_t) plan->rt*plan->c*(4 + 2) + (size_t) plan->rt*4 + 32;
+    const size_t tg_suf = (size_t) (a->G*plan->D + 4*a->G*(2 + plan->D))*4;
+    const size_t tg_fus = ((tg_pre > tg_suf ? tg_pre : tg_suf) + 15)/16*16;
+    if (tg_fus > 32768) {
+        return false;
+    }
+
+    const size_t base = (size_t) plan->D*a->H*a->ne01*sizeof(float); // ggml_nbytes(dst)
+    const struct ggml_metal_buffer_id b_qh    = sllm_cas_at(dst, base + plan->off_qh);
+    const struct ggml_metal_buffer_id b_lists = sllm_cas_at(dst, base + plan->off_lists);
+    const struct ggml_metal_buffer_id b_cnt   = sllm_cas_at(dst, base + plan->off_cnt);
+    const struct ggml_metal_buffer_id b_po    = sllm_cas_at(dst, base + plan->off_po);
+    const struct ggml_metal_buffer_id b_pml   = sllm_cas_at(dst, base + plan->off_pml);
+    const int32_t D = plan->D;
+
+    ggml_metal_kargs_sllm_cascade args = *a;
+
+    // 1. block lists and half Q
+    ggml_metal_encoder_set_pipeline(enc, p_scan);
+    ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer  (enc, q,       1);
+    ggml_metal_encoder_set_buffer  (enc, mask,    2);
+    ggml_metal_encoder_set_buffer  (enc, b_qh,    3);
+    ggml_metal_encoder_set_buffer  (enc, b_lists, 4);
+    ggml_metal_encoder_set_buffer  (enc, b_cnt,   5);
+    ggml_metal_encoder_set_bytes   (enc, (void *) &D, sizeof(D), 6);
+    ggml_metal_encoder_set_threadgroup_memory_size(enc, 64, 0);
+    ggml_metal_encoder_dispatch_threadgroups(enc, (a->Rpad + a->G - 1)/a->G, 1, 1, 256, 1, 1);
+
+    ggml_metal_encoder_memory_barrier(enc);
+
+    // 2. prefix and suffix passes in one dispatch
+    ggml_metal_encoder_set_pipeline(enc, p_fus);
+    ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer  (enc, q,       1);
+    ggml_metal_encoder_set_buffer  (enc, b_qh,    2);
+    ggml_metal_encoder_set_buffer  (enc, k,       3);
+    ggml_metal_encoder_set_buffer  (enc, v,       4);
+    ggml_metal_encoder_set_buffer  (enc, mask,    5);
+    ggml_metal_encoder_set_buffer  (enc, b_po,    6);
+    ggml_metal_encoder_set_buffer  (enc, b_pml,   7);
+    ggml_metal_encoder_set_buffer  (enc, b_lists, 8);
+    ggml_metal_encoder_set_buffer  (enc, b_cnt,   9);
+    ggml_metal_encoder_set_threadgroup_memory_size(enc, tg_fus, 0);
+    ggml_metal_encoder_dispatch_threadgroups(enc, plan->n_pre + a->HKV*a->ne01, 1, 1, SLLM_CASCADE_NTH, 1, 1);
+
+    ggml_metal_encoder_memory_barrier(enc);
+
+    // 3. merge
+    ggml_metal_encoder_set_pipeline(enc, p_mrg);
+    ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer  (enc, b_po,  1);
+    ggml_metal_encoder_set_buffer  (enc, b_pml, 2);
+    ggml_metal_encoder_set_buffer  (enc, dst,   3);
+    ggml_metal_encoder_dispatch_threadgroups(enc, a->H, a->ne01, 1, 32, 1, 1);
+
+    atomic_fetch_add(&g_cas.dispatches, 1);
+    if (g_cas.trace) {
+        fprintf(stderr, "sllm_cascade: D=%d N=%d H=%d HKV=%d cells=%d prefix=[%d,%d) S=%d rt=%d\n",
+                plan->D, a->ne01, a->H, a->HKV, a->ne11, a->p0, a->p1, a->S, plan->rt);
+    }
+    return true;
+}
+
+//
+// self-test: both head sizes, G = 2 and 4, padded row tiles, a prefix range in the middle of the view (suffix cells on
+// both sides), blocks hidden from every row (window), partly hidden blocks, own cells ending mid-block; against an
+// exact double softmax over the finite mask entries
+//
+
+static uint64_t sllm_cas_rng(uint64_t * s) {
+    *s ^= *s << 13; *s ^= *s >> 7; *s ^= *s << 17;
+    return *s;
+}
+static float sllm_cas_rngf(uint64_t * s) { // uniform in [-1, 1)
+    return (float) (sllm_cas_rng(s) >> 40) / (float) (1ull << 23) - 1.0f;
+}
+
+struct sllm_cas_case {
+    int D, H, HKV, N, low, P, own;  // view: [0, low) other cells, [low, low + P) prefix, then N x own-page runs of 256
+    int hide;                       // prefix cells [low, low + hide) hidden from every row (a window)
+};
+
+static bool sllm_cascade_selftest(ggml_metal_device_t dev, ggml_metal_library_t lib, char * why, size_t why_n) {
+    const struct sllm_cas_case cases[4] = {
+        { 128, 4, 2,  9, 256,  512, 40, 64 },
+        { 256, 8, 4, 12,   0, 1024, 200, 640 },
+        { 128, 8, 2,  8,   0,  256, 256, 0 },
+        { 128, 4, 2,  9, 256,  512, 40, 64 }, // constant V; also a fully masked row
+    };
+    id<MTLDevice> device = (id<MTLDevice>) ggml_metal_device_get_obj(dev);
+    if (!device) {
+        snprintf(why, why_n, "no MTLDevice");
+        return false;
+    }
+    bool ok = true;
+    const int64_t t0 = ggml_time_us();
+    double worst_max = 0.0, worst_rms = 0.0;
+    int n_cases = 0;
+
+    @autoreleasepool {
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        if (!queue) {
+            snprintf(why, why_n, "newCommandQueue failed");
+            return false;
+        }
+        for (int ci = 0; ci < 4 && ok; ++ci) {
+            const struct sllm_cas_case c = cases[ci];
+            const int G = c.H/c.HKV;
+            const int ne11 = c.low + c.P + c.N*256;
+            const int p0 = c.low, p1 = c.low + c.P;
+            const size_t rowk = (size_t) c.HKV*c.D;  // halfs per cell
+            struct ggml_metal_sllm_cascade_plan plan;
+            if (!sllm_cascade_fill_plan(&plan, c.D, c.N, c.H, c.HKV, ne11, p0, p1, (uint64_t) c.H*c.D*4, (uint64_t) c.D*4,
+                    rowk*2, (uint64_t) c.D*2, rowk*2, (uint64_t) c.D*2, (uint64_t) ne11*2, 1.0f/sqrtf((float) c.D))) {
+                snprintf(why, why_n, "plan failed for case %d", ci);
+                ok = false;
+                break;
+            }
+            const size_t dst_bytes = (size_t) c.D*c.H*c.N*4;
+            id<MTLBuffer> bq = [device newBufferWithLength:(size_t) c.N*c.H*c.D*4 options:MTLResourceStorageModeShared];
+            id<MTLBuffer> bk = [device newBufferWithLength:(size_t) ne11*rowk*2 options:MTLResourceStorageModeShared];
+            id<MTLBuffer> bv = [device newBufferWithLength:(size_t) ne11*rowk*2 options:MTLResourceStorageModeShared];
+            id<MTLBuffer> bm = [device newBufferWithLength:(size_t) c.N*ne11*2 options:MTLResourceStorageModeShared];
+            id<MTLBuffer> bd = [device newBufferWithLength:dst_bytes + plan.extra options:MTLResourceStorageModeShared];
+            if (!bq || !bk || !bv || !bm || !bd) {
+                snprintf(why, why_n, "buffer allocation failed");
+                ok = false;
+            }
+            if (ok) {
+                uint64_t seed = 0xCA5CADE0ull + 977*ci;
+                float * q = (float *) [bq contents];
+                __fp16 * k = (__fp16 *) [bk contents];
+                __fp16 * v = (__fp16 *) [bv contents];
+                __fp16 * m = (__fp16 *) [bm contents];
+                float * d = (float *) [bd contents];
+                for (size_t i = 0; i < (size_t) c.N*c.H*c.D; ++i) q[i] = 3.0f*sllm_cas_rngf(&seed);
+                for (size_t i = 0; i < (size_t) ne11*rowk; ++i) { k[i] = (__fp16) sllm_cas_rngf(&seed); v[i] = ci == 3 ? (__fp16) 1.0f : (__fp16) sllm_cas_rngf(&seed); }
+                for (size_t i = 0; i < dst_bytes/4; ++i) d[i] = NAN;
+                for (int n = 0; n < c.N; ++n) {
+                    __fp16 * row = m + (size_t) n*ne11;
+                    for (int j = 0; j < ne11; ++j) row[j] = (__fp16) -INFINITY;
+                    // prefix: hidden [low, low + hide) for every row; rows of odd agents also hide the next 96 cells
+                    const int vis0 = p0 + c.hide + ((n & 1) ? 96 : 0);
+                    for (int j = vis0; j < p1; ++j) row[j] = 0;
+                    // own cells: a run that ends mid-block, in the agent's own page
+                    const int own = c.own - (n % 3)*7;
+                    for (int j = 0; j < own; ++j) row[p1 + n*256 + j] = 0;
+                    // agent 0 also sees a few low cells (suffix blocks before the prefix)
+                    if (n == 0) for (int j = 0; j < (c.low < 37 ? c.low : 37); ++j) row[j] = 0;
+                    if (ci == 3 && n == 0) for (int j = 0; j < ne11; ++j) row[j] = (__fp16) -INFINITY;
+                }
+
+                id<MTLCommandBuffer> cb = [queue commandBuffer];
+                ggml_metal_encoder_t enc = ggml_metal_encoder_init((ggml_metal_cmd_buf_t) cb, false);
+                const struct ggml_metal_buffer_id iq = { (void *) bq, 0 }, ik = { (void *) bk, 0 }, iv = { (void *) bv, 0 },
+                                                  im = { (void *) bm, 0 }, idd = { (void *) bd, 0 };
+                const bool enc_ok = ggml_metal_sllm_cascade_encode(lib, enc, &plan, iq, ik, iv, im, idd);
+                ggml_metal_encoder_end_encoding(enc);
+                ggml_metal_encoder_free(enc);
+                if (!enc_ok) {
+                    snprintf(why, why_n, "pipelines for D=%d G=%d rt=%d not available", c.D, G, plan.rt);
+                    ok = false;
+                } else {
+                    [cb commit];
+                    [cb waitUntilCompleted];
+                    if ([cb status] != MTLCommandBufferStatusCompleted) {
+                        snprintf(why, why_n, "command buffer failed: %s", [[[cb error] description] UTF8String]);
+                        ok = false;
+                    }
+                }
+                if (ok) {
+                    double * sc = (double *) malloc((size_t) ne11*sizeof(double));
+                    double se = 0.0, sr = 0.0, maxerr = 0.0, maxref = 0.0;
+                    bool finite = true;
+                    for (int n = 0; n < c.N; ++n) {
+                        for (int h = 0; h < c.H; ++h) {
+                            const int hk = h/G;
+                            const float * qq = q + ((size_t) n*c.H + h)*c.D;
+                            double mx = -INFINITY;
+                            for (int j = 0; j < ne11; ++j) {
+                                const float mv = (float) m[(size_t) n*ne11 + j];
+                                if (!(mv > -65504.0f)) { sc[j] = -INFINITY; continue; }
+                                double acc = 0.0;
+                                for (int e = 0; e < c.D; ++e) acc += (double) qq[e]*(double) k[(size_t) j*rowk + (size_t) hk*c.D + e];
+                                sc[j] = acc/sqrt((double) c.D) + mv;
+                                if (sc[j] > mx) mx = sc[j];
+                            }
+                            double l = 0.0;
+                            for (int j = 0; j < ne11; ++j) { sc[j] = isinf(sc[j]) ? 0.0 : exp(sc[j] - mx); l += sc[j]; }
+                            for (int e = 0; e < c.D; ++e) {
+                                double acc = 0.0;
+                                for (int j = 0; j < ne11; ++j) if (sc[j] != 0.0) acc += sc[j]*(double) v[(size_t) j*rowk + (size_t) hk*c.D + e];
+                                const double ref = l > 0.0 ? acc/l : 0.0;
+                                const double got = d[((size_t) n*c.H + h)*c.D + e];
+                                if (!isfinite(got)) finite = false;
+                                const double err = fabs(got - ref);
+                                se += err*err; sr += ref*ref;
+                                if (err > maxerr) maxerr = err;
+                                if (fabs(ref) > maxref) maxref = fabs(ref);
+                            }
+                        }
+                    }
+                    free(sc);
+                    const double rel_rms = sr > 0 ? sqrt(se/sr) : 1.0;
+                    const double max_rel = maxref > 0 ? maxerr/maxref : 1.0;
+                    if (max_rel > worst_max) worst_max = max_rel;
+                    if (rel_rms > worst_rms) worst_rms = rel_rms;
+                    ++n_cases;
+                    const double max_tol = ci == 3 ? 1e-6 : 5e-3, rms_tol = ci == 3 ? 1e-6 : 2e-3;
+                    if (!finite || !(max_rel < max_tol) || !(rel_rms < rms_tol)) {
+                        snprintf(why, why_n, "mismatch D=%d G=%d N=%d: max_abs/max_ref %.3g, rel_rms %.3g%s",
+                                 c.D, G, c.N, max_rel, rel_rms, finite ? "" : ", non-finite output");
+                        ok = false;
+                    }
+                }
+            }
+            [bq release]; [bk release]; [bv release]; [bm release]; [bd release];
+        }
+        [queue release];
+    }
+
+    g_cas.selftest_cases         = n_cases;
+    g_cas.selftest_worst_max_rel = worst_max;
+    g_cas.selftest_worst_rel_rms = worst_rms;
+    g_cas.selftest_ms            = (ggml_time_us() - t0)/1e3;
+    return ok;
+}
+
+void ggml_metal_sllm_cascade_device_init(ggml_metal_device_t dev, ggml_metal_library_t lib, bool has_tensor) {
+    if (g_cas.initialized) {
+        return;
+    }
+    g_cas.initialized = true;
+    g_cas.active = false;
+    atomic_store(&g_cas.dispatches, 0);
+
+    const char * tr  = getenv("SLLM_CASCADE_TRACE");
+    const char * env = getenv("SLLM_CASCADE");
+    if (env && strcmp(env, "0") == 0) {
+        g_cas.mode = SLLM_CASCADE_MODE_OFF;
+    } else if (env && strcmp(env, "force") == 0) {
+        g_cas.mode = SLLM_CASCADE_MODE_FORCE;
+    } else {
+        g_cas.mode = SLLM_CASCADE_MODE_AUTO;
+    }
+
+    if (g_cas.mode == SLLM_CASCADE_MODE_OFF) {
+        snprintf(g_cas.reason, sizeof(g_cas.reason), "disabled by SLLM_CASCADE=0");
+    } else if (!has_tensor) {
+        snprintf(g_cas.reason, sizeof(g_cas.reason), "no Metal 4 tensor API on this device");
+    } else if (!lib) {
+        snprintf(g_cas.reason, sizeof(g_cas.reason), "no Metal library");
+    } else if (g_cas.compile_failed) {
+        snprintf(g_cas.reason, sizeof(g_cas.reason), "kernels/cascade.metal failed to compile: %s", g_cas.compile_msg);
+    } else {
+        char why[200] = "";
+        g_cas.selftest_ran  = true;
+        g_cas.selftest_pass = sllm_cascade_selftest(dev, lib, why, sizeof(why));
+        if (g_cas.selftest_pass) {
+            g_cas.active = true;
+            snprintf(g_cas.reason, sizeof(g_cas.reason), "self-test passed");
+        } else {
+            snprintf(g_cas.reason, sizeof(g_cas.reason), "self-test failed: %s", why);
+        }
+        atomic_store(&g_cas.dispatches, 0);
+    }
+    g_cas.trace = tr && strcmp(tr, "1") == 0;
+
+    if (g_cas.active) {
+        GGML_LOG_INFO("%s: SLLM cascade active (mode %s; self-test %d cases, worst max/ref %.2e, worst rel rms %.2e, %.1f ms)\n",
+                __func__, g_cas.mode == SLLM_CASCADE_MODE_FORCE ? "force" : "auto", g_cas.selftest_cases,
+                g_cas.selftest_worst_max_rel, g_cas.selftest_worst_rel_rms, g_cas.selftest_ms);
+    } else if (g_cas.mode == SLLM_CASCADE_MODE_OFF) {
+        GGML_LOG_INFO("%s: SLLM cascade off (%s)\n", __func__, g_cas.reason);
+    } else {
+        GGML_LOG_WARN("%s: SLLM cascade disabled, using ggml for every flash attention: %s\n", __func__, g_cas.reason);
+    }
+}
+
+const char * ggml_backend_metal_sllm_cascade_status(void) {
+    static _Thread_local char buf[1024];
+    char reason[300];
+    size_t j = 0;
+    for (size_t i = 0; g_cas.reason[i] && j + 2 < sizeof(reason); ++i) {
+        const char c = g_cas.reason[i];
+        if (c == '"' || c == '\\') reason[j++] = '\\';
+        reason[j++] = (c == '\n' || c == '\r' || c == '\t') ? ' ' : c;
+    }
+    reason[j] = 0;
+    snprintf(buf, sizeof(buf),
+        "{\"patch\":\"sllm-cascade-1\",\"initialized\":%s,\"active\":%s,\"mode\":\"%s\",\"reason\":\"%s\","
+        "\"selftest\":{\"ran\":%s,\"pass\":%s,\"cases\":%d,\"worst_max_rel\":%.3e,\"worst_rel_rms\":%.3e,\"ms\":%.2f},"
+        "\"rule\":\"hinted FLASH_ATTN_EXT (op_params[13..15]), f16 K/V, D in {128,256}, G in {2,4}, N>=%d\",\"dispatches\":%llu}",
+        g_cas.initialized ? "true" : "false", g_cas.active ? "true" : "false",
+        g_cas.mode == SLLM_CASCADE_MODE_OFF ? "off" : g_cas.mode == SLLM_CASCADE_MODE_FORCE ? "force" : "auto", reason,
+        g_cas.selftest_ran ? "true" : "false", g_cas.selftest_pass ? "true" : "false", g_cas.selftest_cases,
+        g_cas.selftest_worst_max_rel, g_cas.selftest_worst_rel_rms, g_cas.selftest_ms,
+        SLLM_CASCADE_MIN_N, (unsigned long long) atomic_load(&g_cas.dispatches));
+    return buf;
+}
