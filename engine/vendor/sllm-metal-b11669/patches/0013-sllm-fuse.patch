+// ---- SLLM patch 13 (phase2-fuse): fused small ops (kernels/prefill.metal) ----------------------------------------
+// The kernels repeat the per-element arithmetic and the reduction structure of the ggml kernels they replace, with
+// ggml's own thread count for the norm, so their outputs are bitwise ggml's (sllm results/phase2-fuse checks it end to
+// end). When a condition fails here the ops run unfused (ggml's path), as if the pattern had not matched.
+
+// same layout as sllm_fuse_args in kernels/prefill.metal
+typedef struct {
+    int32_t  ne00, ne00_t, ne01, ne02;
+    uint64_t nb01, nb02, nb03;
+    int32_t  nw1, nw2, nw3, pad0;
+    uint64_t nbw1, nbw2, nbw3;
+    uint64_t nb1, nb2, nb3;
+    float    eps;
+    int32_t  n_dims, n_ctx_orig;
+    float    freq_base, freq_scale, ext_factor, attn_factor, beta_fast, beta_slow;
+    float    scale, bias;
+    uint64_t nbr1, nbi0;
+    int32_t  idx_i64, pad1;
+    uint64_t nbb1, nbb2, nbb3;
+    uint64_t nbs1, nbs2, nbs3;
+    float    eps2;
+    int32_t  pad2;
+} ggml_metal_sllm_fuse_args;
+
+static ggml_metal_pipeline_with_params ggml_metal_sllm_fuse_pipeline(ggml_metal_library_t lib, const char * name) {
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        res = ggml_metal_library_compile_pipeline(lib, name, name, nullptr);
+    }
+    return res;
+}
+
+// ggml_metal_op_norm's thread count for this norm op fused with n_fuse - 1 ops (its rule, with its pipeline's limit)
+static int ggml_metal_sllm_fuse_norm_nth(ggml_metal_library_t lib, const ggml_tensor * nrm, int ne00_t, int n_fuse = 2) {
+    auto p = ggml_metal_library_get_pipeline_norm(lib, nrm, n_fuse);
+    if (!p.pipeline) {
+        return -1;
+    }
+    const int mx = ggml_metal_pipeline_max_theads_per_threadgroup(p);
+    int nth = 32;
+    while (nth < ne00_t && nth < mx) {
+        nth *= 2;
+    }
+    nth = std::min(nth, mx);
+    nth = std::min(nth, (ne00_t + 31)/32*32);
+    return nth;
+}
+
+static void ggml_metal_sllm_fuse_weight(ggml_metal_sllm_fuse_args & a, const ggml_tensor * w) {
+    a.nw1 = (int32_t) w->ne[1]; a.nw2 = (int32_t) w->ne[2]; a.nw3 = (int32_t) w->ne[3];
+    a.nbw1 = w->nb[1]; a.nbw2 = w->nb[2]; a.nbw3 = w->nb[3];
+}
+
+// RMS_NORM + MUL + ROPE [+ SCALE | + VIEW + SET_ROWS] at idx (n non-empty nodes); returns the nodes consumed, 0 = not taken
+static int ggml_metal_op_sllm_norm_rope(ggml_metal_op_t ctx, int idx, ggml_metal_fusion_id id, int n) {
+    const ggml_tensor * nrm  = ctx->node(idx);
+    const ggml_tensor * mul  = ctx->node(idx + 1);
+    const ggml_tensor * rope = ctx->node(idx + 2);
+    const ggml_tensor * last = ctx->node(idx + n - 1);
+    const ggml_tensor * x    = nrm->src[0];
+
+    const int ne00 = (int) x->ne[0], ne00_t = ne00/4;
+    if (ggml_metal_sllm_fuse_norm_nth(ctx->lib, nrm, ne00_t) != ne00_t) {
+        return 0;
+    }
+    const int mode = id == GGML_METAL_FUSION_SLLM_NORM_ROPE ? 0 : id == GGML_METAL_FUSION_SLLM_NORM_ROPE_SCALE ? 1 : 2;
+    static const char * names[3] = { "kernel_sllm_norm_rope_f32", "kernel_sllm_norm_rope_scale", "kernel_sllm_norm_rope_rows" };
+    auto pipeline = ggml_metal_sllm_fuse_pipeline(ctx->lib, names[mode]);
