+// RMS_NORM + MUL + ROPE (NEOX) [+ SCALE | + VIEW + SET_ROWS f16]: the shapes the fused kernel takes (one float4 per thread
+// of a row; the encoder also requires ggml's norm thread count to equal ne00/4)
+static bool ggml_metal_fusion_check_sllm_norm_rope(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(mode);
+
+    if (!ggml_metal_sllm_fuse_on(fusion->id)) {
+        return false;
+    }
+
+    const ggml_tensor * nrm  = nodes[0];
+    const ggml_tensor * mul  = nodes[1];
+    const ggml_tensor * rope = nodes[2];
+    const ggml_tensor * x    = nrm->src[0];
+
+    if (nrm->op != GGML_OP_RMS_NORM || mul->op != GGML_OP_MUL || rope->op != GGML_OP_ROPE) {
+        return false;
+    }
+    if (x->type != GGML_TYPE_F32 || nrm->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 || rope->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const int64_t ne00 = x->ne[0];
+    if (ne00 % 4 != 0 || ne00 > 4096 || x->nb[0] != 4 || x->nb[1] % 16 != 0 || x->nb[2] % 16 != 0 || x->nb[3] % 16 != 0 || x->ne[3] != 1) {
+        return false;
+    }
+    // the MUL: norm output times a weight row as wide as the norm input (broadcast over heads / tokens)
+    const ggml_tensor * w = mul->src[1];
+    if (mul->src[0] != nrm || !w || w->type != GGML_TYPE_F32 || w->ne[0] != ne00 || w->nb[0] != 4 || w->nb[1] % 16 != 0 ||
+        !ggml_are_same_shape(mul, nrm) || x->ne[1] % w->ne[1] != 0 || x->ne[2] % w->ne[2] != 0 || x->ne[3] % w->ne[3] != 0) {
+        return false;
+    }
+    // the ROPE: NEOX, no frequency factors, no offset, one position per token, a contiguous output of the same shape
+    const int32_t * rp = (const int32_t *) rope->op_params;
+    const int n_dims = rp[1], rmode = rp[2], n_offs = rp[15];
+    const ggml_tensor * pos = rope->src[1];
+    if (rope->src[0] != mul || rope->src[2] || rmode != GGML_ROPE_TYPE_NEOX || n_offs != 0 || n_dims <= 0 || n_dims % 2 != 0 ||
+        n_dims > ne00 || !pos || pos->type != GGML_TYPE_I32 || pos->ne[0] != x->ne[2] || !ggml_are_same_shape(rope, mul) ||
+        !ggml_is_contiguous(rope) || !ggml_is_contiguous(mul) || !ggml_is_contiguous(nrm)) {
+        return false;
+    }
+    if (fusion->id == GGML_METAL_FUSION_SLLM_NORM_ROPE_SCALE) {
+        const ggml_tensor * sc = nodes[3];
+        if (sc->op != GGML_OP_SCALE || sc->src[0] != rope || sc->type != GGML_TYPE_F32 || !ggml_are_same_shape(sc, rope) || !ggml_is_contiguous(sc)) {
+            return false;
+        }
+    }
+    if (fusion->id == GGML_METAL_FUSION_SLLM_NORM_ROPE_ROWS) {
+        const ggml_tensor * sr  = nodes[3];
+        const ggml_tensor * src = sr->src[0];
+        const ggml_tensor * ix  = sr->src[1];
+        // set_rows(cache, view_2d(rope, ne00*heads, tokens), idx): every row is one token's heads back to back
+        if (sr->op != GGML_OP_SET_ROWS || !src || src->view_src != rope || src->view_offs != 0 || src->ne[0] != ne00*rope->ne[1] ||
+            src->ne[1] != rope->ne[2] || src->ne[2] != 1 || src->ne[3] != 1 || src->nb[1] != rope->nb[2] ||
+            sr->type != GGML_TYPE_F16 || sr->nb[0] != 2 || sr->ne[0] != src->ne[0] || sr->ne[2] != 1 || sr->ne[3] != 1 ||
+            !ix || (ix->type != GGML_TYPE_I64 && ix->type != GGML_TYPE_I32) || ix->ne[0] != src->ne[1] || ix->ne[1] != 1 ||
+            ix->ne[2] != 1 || ix->ne[3] != 1) {
+            return false;
+        }
+        // the norm, mul and rope outputs are not written: nothing outside the group may read them (the raw group
+        // includes the VIEW between the rope and the set_rows)
+        int raw[5] = { node_idxs[idx], node_idxs[idx + 1], node_idxs[idx + 2], -1, node_idxs[idx + 3] };
+        for (int i = raw[2] + 1; i < raw[4]; ++i) {
+            if (gf->nodes[i] == src) {
+                raw[3] = i;
+            }
+        }
+        if (raw[3] < 0) {
+            return false;
+        }
+        const ggml_op ops[5] = { GGML_OP_RMS_NORM, GGML_OP_MUL, GGML_OP_ROPE, GGML_OP_VIEW, GGML_OP_SET_ROWS };
+        if (!ggml_can_fuse_subgraph_ext(gf, raw, 5, ops, &raw[4], 1)) {
+            return false;
+        }
+    }
+    return true;
+}
