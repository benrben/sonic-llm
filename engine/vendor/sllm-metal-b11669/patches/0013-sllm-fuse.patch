+// ---- SLLM patch 13 (phase2-fuse) -------------------------------------------
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+
+bool ggml_metal_sllm_fuse_enabled(void) {
+    static const bool on = [] {
+        const char * e = getenv("SLLM_FUSE");
+        return !(e && strcmp(e, "0") == 0);
+    }();
+    return on;
+}
+
+// SLLM_FUSE_MASK (A/B and bisection): bit 0 norm+rope, 1 norm+rope+scale, 2 norm+rope+set_rows, 3 add+norm,
+// 4 norm+add+norm (default all)
+static bool ggml_metal_sllm_fuse_on(ggml_metal_fusion_id id) {
+    static const int mask = [] {
+        const char * e = getenv("SLLM_FUSE_MASK");
+        return e ? atoi(e) : 31;
+    }();
+    if (!ggml_metal_sllm_fuse_enabled()) {
+        return false;
+    }
+    switch (id) {
+        case GGML_METAL_FUSION_SLLM_NORM_ROPE:       return mask & 1;
+        case GGML_METAL_FUSION_SLLM_NORM_ROPE_SCALE: return mask & 2;
+        case GGML_METAL_FUSION_SLLM_NORM_ROPE_ROWS:  return mask & 4;
+        case GGML_METAL_FUSION_SLLM_ADD_NORM:        return mask & 8;
+        case GGML_METAL_FUSION_SLLM_NORM_ADD_NORM:   return mask & 16;
+        default:                                     return false;
+    }
+}
+
+static std::atomic<unsigned long long> g_sllm_fuse_dispatches{0};
+
+unsigned long long ggml_metal_sllm_fuse_dispatches(void) {
+    return g_sllm_fuse_dispatches.load();
+}
+
+void ggml_metal_sllm_fuse_count(void) {
+    g_sllm_fuse_dispatches++;
+}
+
+// exported: the SLLM fusions' status (sllm-core caps: ggml_metal.fuse)
+extern "C" const char * ggml_backend_metal_sllm_fuse_status(void) {
+    static thread_local char buf[512];
+    snprintf(buf, sizeof(buf),
+        "{\"patch\":\"sllm-fuse-1\",\"active\":%s,\"rule\":\"RMS_NORM+MUL+ROPE(neox)[+SCALE|+SET_ROWS f16], ADD+RMS_NORM+MUL, RMS_NORM+MUL+ADD+RMS_NORM+MUL; "
+        "bitwise ggml's kernels; SLLM_FUSE=0 off\",\"dispatches\":%llu}",
+        ggml_metal_sllm_fuse_enabled() ? "true" : "false", (unsigned long long) g_sllm_fuse_dispatches.load());
+    return buf;
+}
