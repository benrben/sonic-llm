         res->encode_async = nil;
@@ -249,8 +256,33 @@
 
 const char * ggml_metal_get_name(ggml_metal_t ctx) {
     return ctx->name;
+}
+
+// SLLM patch 5/5: record why a command buffer failed (and log it)
+static void ggml_metal_sllm_note_error(ggml_metal_t ctx, id<MTLCommandBuffer> cmd_buf, int idx) {
+    NSError * err = cmd_buf ? [cmd_buf error] : nil;
+    snprintf(ctx->sllm_error, sizeof(ctx->sllm_error), "command buffer %d status %d%s%s%s code %ld: %s", idx,
+            cmd_buf ? (int) [cmd_buf status] : -1, err ? " (" : "", err ? [err.domain UTF8String] : "", err ? ")" : "",
+            err ? (long) err.code : 0L, err ? [err.localizedDescription UTF8String] : "no error object");
+    GGML_LOG_ERROR("%s: %s\n", __func__, ctx->sllm_error);
 }
 
+bool ggml_metal_sllm_take_error(ggml_metal_t ctx, char * msg, size_t n) {
+    if (!ctx->has_error) {
+        return false;
+    }
+    if (msg && n > 0) {
+        snprintf(msg, n, "%s", ctx->sllm_error[0] ? ctx->sllm_error : "a command buffer failed earlier");
+    }
+    ctx->has_error = false;
+    ctx->sllm_error[0] = 0;
+    return true;
+}
+
+void ggml_metal_sllm_inject_error(ggml_metal_t ctx) {
+    ctx->sllm_inject = true;
+}
