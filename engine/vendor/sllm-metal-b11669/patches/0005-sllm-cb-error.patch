+// SLLM patch 5/5: a failed command buffer is reported to the caller that asks, with Metal's error, and the backend is
+// usable again afterwards (stock ggml keeps it in the error state until it is recreated)
+bool ggml_metal_sllm_take_error(ggml_metal_t ctx, char * msg, size_t n);
+void ggml_metal_sllm_inject_error(ggml_metal_t ctx);
+
 void ggml_metal_set_tensor_async(ggml_metal_t ctx, struct ggml_tensor * tensor, const void * data, size_t offset, size_t size);
