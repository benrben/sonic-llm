+
+// SLLM patch 5/5: after a synchronize, take the command-buffer failure it found (Metal's error text in msg) and clear
+// the backend's error state; false when there was none. sllm-core calls it after every step (through dlsym).
+extern "C" __attribute__((visibility("default"))) bool ggml_backend_metal_sllm_take_error(ggml_backend_t backend, char * msg, size_t n) {
+    if (!backend || !ggml_backend_is_metal(backend)) {
+        return false;
+    }
+    return ggml_metal_sllm_take_error((ggml_metal_t) backend->context, msg, n);
 }
 
+// SLLM patch 5/5, tests only: the next synchronize of this backend reports a failed command buffer
+extern "C" __attribute__((visibility("default"))) void ggml_backend_metal_sllm_inject_error(ggml_backend_t backend) {
+    if (backend && ggml_backend_is_metal(backend)) {
+        ggml_metal_sllm_inject_error((ggml_metal_t) backend->context);
+    }
+}
+
 bool ggml_backend_is_metal(ggml_backend_t backend) {
     return backend != NULL && ggml_guid_matches(backend->guid, ggml_backend_metal_guid());
 }
