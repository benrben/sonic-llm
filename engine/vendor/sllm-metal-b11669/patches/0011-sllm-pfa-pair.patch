+
+// SLLM patch 11 (phase2-prefill2): kernel_sllm_pfa2, the same per-row arithmetic as kernel_sllm_pfa (so bitwise
+// ggml's), faster:
+//   - two consecutive visible 64-cell blocks share one Q K^T run over 128 cells, and one P V run over 128 cells when
+//     no row rescales in the second block (matmul2d's result does not depend on how its K extent is split into runs;
+//     the init self-test checks the equality with ggml's kernel); the softmax still walks each 64-cell block in order
+//     with ggml's lazy rescale;
+//   - O is rescaled only when some row of the threadgroup moved its running max in that block (else ms is exactly 1
+//     for every row and O * 1 = O).
+// threadgroup memory: S [RT][128] float | P [RT][128] half | ms [2][RT] float | 2 flags
+template <int D, int RT, int NSG, int G>
+kernel void kernel_sllm_pfa2(
+        constant sllm_pfa_args & a [[buffer(0)]],
+        device const half * qh   [[buffer(1)]],
+        device const char * k    [[buffer(2)]],
+        device const char * v    [[buffer(3)]],
+        device const char * mask [[buffer(4)]],
+        device const char * blk  [[buffer(5)]],
+        device       char * dst  [[buffer(6)]],
+        threadgroup  char * shm  [[threadgroup(0)]],
+        uint3  tg    [[threadgroup_position_in_grid]],
+        ushort tiisg [[thread_index_in_simdgroup]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]]) {
+    constexpr int C = 64, C2 = 128;
+    constexpr int NW = 32;
+    constexpr int NQ = RT / NSG;          // rows per simdgroup
+    constexpr int NC = C / NW;            // cells per lane
+    constexpr int TT = RT / G;            // tokens per tile
+    static_assert(RT % NSG == 0 && RT % G == 0, "tile");
+
+    const int hk = tg.x, tile = tg.y, st = tg.z;   // st: the stream (ne03), each its own query rows, K/V view, mask, dst
+    qh   += (uint64_t) st * a.HKV * a.ntile * RT * D;
+    k    += (uint64_t) st * a.nb13;
+    v    += (uint64_t) st * a.nb23;
+    mask += (uint64_t) st * a.nb33;
+    blk  += (uint64_t) st * a.ntile * a.blk_ld;
+    dst  += (uint64_t) st * a.nb3;
+
+    threadgroup float * ss = (threadgroup float *) shm;
+    threadgroup half  * sp = (threadgroup half *) (ss + RT * C2);
+    threadgroup float * sa = (threadgroup float *) (sp + RT * C2);
+    threadgroup int   * sf = (threadgroup int *) (sa + 2 * RT);   // [0]: a row rescaled in the second block, [1]: in the first
+
+    constexpr auto dqk1 = matmul2d_descriptor(RT, C,  D, false, true, false, matmul2d_descriptor::mode::multiply);
+    constexpr auto dqk2 = matmul2d_descriptor(RT, C2, D, false, true, false, matmul2d_descriptor::mode::multiply);
+    constexpr auto dpv  = matmul2d_descriptor(RT, D, static_cast<int>(dynamic_extent), false, false, false, matmul2d_descriptor::mode::multiply_accumulate);
+    matmul2d<dqk1, execution_simdgroups<NSG>> mqk1;
+    matmul2d<dqk2, execution_simdgroups<NSG>> mqk2;
+    matmul2d<dpv,  execution_simdgroups<NSG>> mpv;
+
+    const int ldk = (int) (a.nb11 / 2), ldv = (int) (a.nb21 / 2);
+    device const half * kh = (device const half *) (k + (uint64_t) hk * a.nb12);
+    device const half * vh = (device const half *) (v + (uint64_t) hk * a.nb22);
+
+    auto tQ  = tensor((device half *) qh + ((uint64_t) hk * a.ntile + tile) * RT * D, dextents<int32_t, 2>(D, RT), array<int, 2>({1, D}));
+    auto tS1 = tensor(ss, dextents<int32_t, 2>(C,  RT), array<int, 2>({1, C2}));
+    auto tS2 = tensor(ss, dextents<int32_t, 2>(C2, RT), array<int, 2>({1, C2}));
+    auto tK1 = tensor((device half *) kh, dextents<int32_t, 2>(D, C),  array<int, 2>({1, ldk}));
+    auto tK2 = tensor((device half *) kh, dextents<int32_t, 2>(D, C2), array<int, 2>({1, ldk}));
+    auto tP0 = tensor(sp, dextents<int32_t, 2>(C2, RT), array<int, 2>({1, C2}));
+    auto tV0 = tensor((device half *) vh, dextents<int32_t, 2>(D, C2), array<int, 2>({1, ldv}));
+    auto cS1 = mqk1.template get_destination_cooperative_tensor<decltype(tQ), decltype(tK1), float>();
+    auto cS2 = mqk2.template get_destination_cooperative_tensor<decltype(tQ), decltype(tK2), float>();
+    auto cO  = mpv.template get_destination_cooperative_tensor<decltype(tP0), decltype(tV0), float>();
+    #pragma unroll
+    for (uint16_t i = 0; i < cO.get_capacity(); ++i) {
+        if (cO.is_valid_element(i)) cO[i] = 0.0f;
+    }
+
+    float M[NQ], S[NQ];
+    #pragma unroll
+    for (int jj = 0; jj < NQ; ++jj) {
+        M[jj] = SLLM_PFA_NEG;
+        S[jj] = 0.0f;
+    }
+    device const char * brow = blk + (uint64_t) tile * a.blk_ld;
+
+    // the softmax of the 64-cell block at cell cb (columns co.. of S and P): kernel_sllm_pfa's per-row arithmetic;
+    // each row's ms -> sa[h*RT + row]; returns whether some row of this simdgroup rescaled
+    auto smax = [&](const char bc, const int cb, const int co, const int h) {
+        bool any = false;
+        #pragma unroll
+        for (int jj = 0; jj < NQ; ++jj) {
+            const int j = jj * NSG + sgitg;
+            const int t = tile * TT + j % TT;
+            float s[NC];
+            #pragma unroll
+            for (int ii = 0; ii < NC; ++ii) s[ii] = ss[j * C2 + co + ii * NW + tiisg];
+            if (t >= a.ne01) {
+                #pragma unroll
+                for (int ii = 0; ii < NC; ++ii) s[ii] = -INFINITY;
+            } else if (bc != 2) {
+                device const half * pm = (device const half *) (mask + (uint64_t) t * a.nb31);
+                #pragma unroll
+                for (int ii = 0; ii < NC; ++ii) s[ii] += (float) pm[cb + ii * NW + tiisg];
+            }
+            float m = M[jj];
+            #pragma unroll
+            for (int ii = 0; ii < NC; ++ii) m = max(m, s[ii]);
+            m = simd_max(m);
+            float ms = 1.0f;
+            if (m > M[jj] + 8.0f) {
+                ms = exp(M[jj] - m);
+                M[jj] = m;
+                any = true;
+            }
+            float sum = 0.0f;
+            #pragma unroll
+            for (int ii = 0; ii < NC; ++ii) {
+                const half p = (half) exp(s[ii] - M[jj]);   // the sum uses the same rounded values as P V (as ggml)
+                sp[j * C2 + co + ii * NW + tiisg] = p;
+                sum += (float) p;
+            }
+            S[jj] = S[jj] * ms + simd_sum(sum);
+            if (tiisg == 0) sa[h * RT + j] = ms;
+        }
+        return any;
+    };
+    auto rescale = [&](const int h) {
+        #pragma unroll
+        for (uint16_t i = 0; i < cO.get_capacity(); ++i) {
+            if (cO.is_valid_element(i)) {
+                const auto ix = cO.get_multidimensional_index(i);
+                cO[i] *= sa[h * RT + ix[1]];
+            }
+        }
+    };
+
+    int ib = 0;
+    while (ib < a.nblk0) {
+        const char b0 = brow[ib];
+        if (b0 == 0) {
+            ++ib;
+            continue;
+        }
+        const char b1 = ib + 1 < a.nblk0 ? brow[ib + 1] : 0;
+        const int cb = ib * C;
+        if (b1 != 0) {
+            // two visible blocks: one Q K^T over 128 cells, then block cb and block cb + 64 in order
+            auto tK = tensor((device half *) kh + (uint64_t) cb * ldk, dextents<int32_t, 2>(D, C2), array<int, 2>({1, ldk}));
+            mqk2.run(tQ, tK, cS2);
+            cS2.store(tS2);
+            if (sgitg == 0 && tiisg == 0) { sf[0] = 0; sf[1] = 0; }
+            threadgroup_barrier(mem_flags::mem_threadgroup);   // also: the previous P V is done with P
+            const bool r0 = smax(b0, cb, 0, 0);
+            const bool r1 = smax(b1, cb + C, C, 1);
+            if (r1 && tiisg == 0) sf[0] = 1;
+            if (r0 && tiisg == 0) sf[1] = 1;
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (sf[1] != 0) rescale(0);
+            if (sf[0] == 0) {
+                // ms of the second block is exactly 1 for every row: O + P0 V0 + P1 V1 in one run
+                auto tP = tensor(sp, dextents<int32_t, 2>(C2, RT), array<int, 2>({1, C2}));
+                auto tV = tensor((device half *) vh + (uint64_t) cb * ldv, dextents<int32_t, 2>(D, C2), array<int, 2>({1, ldv}));
+                mpv.run(tP, tV, cO);
+            } else {
+                auto tP1 = tensor(sp, dextents<int32_t, 2>(C, RT), array<int, 2>({1, C2}));
+                auto tV1 = tensor((device half *) vh + (uint64_t) cb * ldv, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldv}));
+                mpv.run(tP1, tV1, cO);
+                rescale(1);
+                auto tP2 = tensor(sp + C, dextents<int32_t, 2>(C, RT), array<int, 2>({1, C2}));
+                auto tV2 = tensor((device half *) vh + (uint64_t) (cb + C) * ldv, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldv}));
+                mpv.run(tP2, tV2, cO);
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            ib += 2;
+        } else {
+            // a visible block followed by a hidden one (or the end): the one block alone
+            auto tK = tensor((device half *) kh + (uint64_t) cb * ldk, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldk}));
+            mqk1.run(tQ, tK, cS1);
+            cS1.store(tS1);
+            if (sgitg == 0 && tiisg == 0) sf[1] = 0;
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            const bool r0 = smax(b0, cb, 0, 0);
+            if (r0 && tiisg == 0) sf[1] = 1;
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (sf[1] != 0) rescale(0);
+            auto tP1 = tensor(sp, dextents<int32_t, 2>(C, RT), array<int, 2>({1, C2}));
+            auto tV1 = tensor((device half *) vh + (uint64_t) cb * ldv, dextents<int32_t, 2>(D, C), array<int, 2>({1, ldv}));
+            mpv.run(tP1, tV1, cO);
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            ib += 2;
+        }
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    #pragma unroll
+    for (int jj = 0; jj < NQ; ++jj) {
+        const int j = jj * NSG + sgitg;
+        if (tiisg == 0) sa[j] = S[jj] == 0.0f ? 0.0f : 1.0f / S[jj];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    // dst [D, H, ne01]: row (g, tl) of the tile -> token tile*TT + tl, head hk*G + g
+    #pragma unroll
+    for (uint16_t i = 0; i < cO.get_capacity(); ++i) {
+        if (cO.is_valid_element(i)) {
+            const auto ix = cO.get_multidimensional_index(i);
+            const int rr = ix[1], d = ix[0];
+            const int tt = tile * TT + rr % TT, g = rr / TT;
+            if (tt < a.ne01) {
+                ((device float *) (dst + (uint64_t) tt * a.nb1))[(hk * G + g) * D + d] = cO[i] * sa[rr];
+            }
+        }
+    }
+}
+
+#define SLLM_PFA2(D, RT, NSG, G) \
+    template [[host_name("kernel_sllm_pfa2_d" #D "_rt" #RT "_c64_sg" #NSG "_g" #G)]] \
+    kernel void kernel_sllm_pfa2<D, RT, NSG, G>(constant sllm_pfa_args &, device const half *, device const char *, \
+        device const char *, device const char *, device const char *, device char *, threadgroup char *, uint3, ushort, ushort);
+
+SLLM_PFA2(128, 32, 4, 2) SLLM_PFA2(128, 32, 4, 4)
+SLLM_PFA2(256, 32, 4, 2) SLLM_PFA2(256, 32, 4, 4)
 
